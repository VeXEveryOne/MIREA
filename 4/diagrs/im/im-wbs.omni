  "source": "functree im_wbs \"Проект ИС подготовки и актуализации карточек\"\nsettings options \"\" numbering=auto profile=wbs\nnode root \"ИС подготовки и актуализации карточек\" kind=project order=0\ndiagram main \"ИСР / WBS\" root=root type=wbs\nview rootView \"\" diagram=main element=root\nnode stage1 \"Обследование и требования\" kind=summary order=0 parent=root\nnode stage2 Проектирование kind=summary order=1 parent=root\nnode stage3 Разработка kind=summary order=2 parent=root\nnode stage4 \"Испытания и внедрение\" kind=summary order=3 parent=root\nnode wp1_1 \"Обследование и модель «как есть»\" acceptance=\"Реестр потоков и подтверждённые границы\" deliverable=\"Реестр потоков и подтверждённые границы\" description=\"Источник: отчёт ИМ, таблицы 3.4–3.5. Плановый период Н1; иерархия не задаёт зависимости. Критерий завершения перенесён из колонки проверяемого результата.\" effortHours=32 externalCode=1.1 kind=workPackage order=0 ownerRole=\"Аналитик; менеджер\" parent=stage1\nnode wp1_2 \"Требования и критерии приёмки\" acceptance=\"ТЗ, приоритеты и измеримые критерии\" deliverable=\"ТЗ, приоритеты и измеримые критерии\" description=\"Источник: отчёт ИМ, таблицы 3.4–3.5. Плановый период Н2; иерархия не задаёт зависимости. Критерий завершения перенесён из колонки проверяемого результата.\" effortHours=40 externalCode=1.2 kind=workPackage order=1 ownerRole=\"Аналитик; ведущий разработчик\" parent=stage1\nnode wp2_1 \"Модель данных и версий\" acceptance=\"Связи компонент–BOM–карточка и правила версий\" deliverable=\"Связи компонент–BOM–карточка и правила версий\" description=\"Источник: отчёт ИМ, таблицы 3.4–3.5. Плановый период Н3; иерархия не задаёт зависимости. Критерий завершения перенесён из колонки проверяемого результата.\" effortHours=32 externalCode=2.1 kind=workPackage order=0 ownerRole=\"Ведущий разработчик\" parent=stage2\nnode wp2_2 \"Проект интерфейсов и правил\" acceptance=\"Сценарии, макеты, форматы обмена\" deliverable=\"Сценарии, макеты, форматы