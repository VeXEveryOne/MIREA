{
  "notation": "SCHEME",
  "formatVersion": 1,
  "profile": "NS-SCHEME-1",
  "model": {
    "id": "ropSchemes",
    "label": "Кодирование, инфраструктура и доступ РОП",
    "elements": [
      {
        "id": "D04_coding",
        "kind": "diagram",
        "label": "Схема кодирования модельного ряда",
        "properties": {
          "type": "coding"
        }
      },
      {
        "id": "bomCode",
        "kind": "codePattern",
        "label": "Формат кода модельного ряда",
        "properties": {
          "description": "При исчерпании диапазона миграция формата. Версия хранится отдельно как version_no."
        }
      },
      {
        "id": "bomPrefix",
        "kind": "segment",
        "label": "Префикс",
        "properties": {
          "owner": "bomCode",
          "kind": "literal",
          "literal": "Модельный ряд",
          "meaning": "Тип объекта: конфигурация\nПостоянный префикс",
          "order": "0"
        }
      },
      {
        "id": "bomSeparator",
        "kind": "segment",
        "label": "Разделитель",
        "properties": {
          "owner": "bomCode",
          "kind": "literal",
          "literal": "-",
          "meaning": "Разделитель по DEFAULT таблицы bom",
          "order": "1"
        }
      },
      {
        "id": "bomNumber",
        "kind": "segment",
        "label": "Порядковый номер",
        "properties": {
          "owner": "bomCode",
          "kind": "counter",
          "width": "6",
          "alphabet": "digits",
          "example": "000153",
          "meaning": "Номер из sequence\n000001–999999",
          "order": "2"
        }
      },
      {
        "id": "bomCodeView",
        "kind": "view",
        "label": "",
        "properties": {
          "diagram": "D04_coding",
          "element": "bomCode"
        }
      },
      {
        "id": "D04_coding.note",
        "kind": "note",
        "label": "Примечание",
        "properties": {
          "text": "При исчерпании диапазона миграция формата. Версия хранится отдельно как version_no."
        }
      },
      {
        "id": "D04_coding.noteView",
        "kind": "view",
        "label": "",
        "properties": {
          "diagram": "D04_coding",
          "element": "D04_coding.note"
        }
      },
      {
