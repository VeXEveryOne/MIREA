iew_e4c55f963b3b \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m6\nfragment D23_sequence_ozon.attempts \"Ограниченные безопасные повторы\" operator=loop order=13 owner=D23_sequence_ozon.current\ncoverage D23_sequence_ozon.attemptsCover0 \"\" lifeline=D23_sequence_ozon.lane0 owner=D23_sequence_ozon.attempts\ncoverage D23_sequence_ozon.attemptsCover1 \"\" lifeline=D23_sequence_ozon.lane1 owner=D23_sequence_ozon.attempts\ncoverage D23_sequence_ozon.attemptsCover2 \"\" lifeline=D23_sequence_ozon.lane2 owner=D23_sequence_ozon.attempts\ncoverage D23_sequence_ozon.attemptsCover3 \"\" lifeline=D23_sequence_ozon.lane3 owner=D23_sequence_ozon.attempts\ncoverage D23_sequence_ozon.attemptsCover4 \"\" lifeline=D23_sequence_ozon.lane4 owner=D23_sequence_ozon.attempts\nview view_1d42c3de5809 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.attempts\noperand D23_sequence_ozon.attemptBody \"\" guard=\"операция не завершена; автоматический повтор разрешён; попытка ≤ 4\" max=4 min=1 order=0 owner=D23_sequence_ozon.attempts\noccurrence D23_sequence_ozon.m7Send \"\" lifeline=D23_sequence_ozon.lane3 order=14 owner=D23_sequence_ozon.attemptBody\noccurrence D23_sequence_ozon.m7Receive \"\" lifeline=D23_sequence_ozon.lane4 order=15 owner=D23_sequence_ozon.attemptBody\nmessage D23_sequence_ozon.m7 \"Отправить карточку; HTTPS / JSON\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m7Receive send=D23_sequence_ozon.m7Send sequence=7 sort=synchCall\nview view_a8d43d277fb0 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m7\nfragment D23_sequence_ozon.result \"Исход отправки\" operator=alt order=16 owner=D23_sequence_ozon.attemptBody\ncoverage D23_sequence_ozon.resultCover0 \"\" lifeline=D23_sequence_ozon.lane0 owner=D23_sequence_ozon.result\ncoverage D23_sequence_ozon.resultCover1 \"\" lifeline=D23_sequence_ozon.lane1 owner=D23_sequence_ozon.result\ncoverage D23_sequence_ozon.resultCover2 \"\" lifeline=D23_sequence_ozon.lane2 owner=D23_sequence_ozon.result\ncoverage D23_sequence_ozon.resultCover3 \"\" lifeline=D23_sequence_ozon.lane3 owner=D23_sequence_ozon.result\ncoverage D23_sequence_ozon.resultCover4 \"\" lifeline=D23_sequence_ozon.lane4 owner=D23_sequence_ozon.result\nview view_0905baf3486e \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.result\noperand D23_sequence_ozon.accepted \"\" guard=\"получен ответ с ID задачи\" order=0 owner=D23_sequence_ozon.result\noperand D23_sequence_ozon.transient \"\" guard=\"временный отказ / 429 / 5xx без неизвестного исхода\" order=1 owner=D23_sequence_ozon.result\noperand D23_sequence_ozon.uncertain \"\" guard=\"ответ потерян и результат отправки неизвестен\" order=2 owner=D23_sequence_ozon.result\noperand D23_sequence_ozon.permanent \"\" guard=\"постоянная ошибка обязательных атрибутов\" order=3 owner=D23_sequence_ozon.result\noccurrence D23_sequence_ozon.m8Send \"\" lifeline=D23_sequence_ozon.lane4 order=17 owner=D23_sequence_ozon.accepted\noccurrence D23_sequence_ozon.m8Receive \"\" lifeline=D23_sequence_ozon.lane3 order=18 owner=D23_sequence_ozon.accepted\nmessage D23_sequence_ozon.m8 \"Идентификатор задачи / текущий результат\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m8Receive replyTo=D23_sequence_ozon.m7 send=D23_sequence_ozon.m8Send sequence=8 sort=reply\nview view_f7f1a5bf085b \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m8\noccurrence D23_sequence_ozon.m9Send \"\" lifeline=D23_sequence_ozon.lane3 order=19 owner=D23_sequence_ozon.accepted\noccurrence D23_sequence_ozon.m9Receive \"\" lifeline=D23_sequence_ozon.lane2 order=20 owner=D23_sequence_ozon.accepted\nmessage D23_sequence_ozon.m9 \"Сохранить внешний ID и WAITING\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m9Receive send=D23_sequence_ozon.m9Send sequence=9 sort=synchCall\nview view_0a813cd623d9 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m9\nfragment D23_sequence_ozon.poll \"Ожидание обработки по известному ID\" operator=loop order=21 owner=D23_sequence_ozon.accepted\ncoverage D23_sequence_ozon.pollCover0 \"\" lifeline=D23_sequence_ozon.lane0 owner=D23_sequence_ozon.poll\ncoverage D23_sequence_ozon.pollCover1 \"\" lifeline=D23_sequence_ozon.lane1 owner=D23_sequence_ozon.poll\ncoverage D23_sequence_ozon.pollCover2 \"\" lifeline=D23_sequence_ozon.lane2 owner=D23_sequence_ozon.poll\ncoverage D23_sequence_ozon.pollCover3 \"\" lifeline=D23_sequence_ozon.lane3 owner=D23_sequence_ozon.poll\ncoverage D23_sequence_ozon.pollCover4 \"\" lifeline=D23_sequence_ozon.lane4 owner=D23_sequence_ozon.poll\nview view_0e563c3e28fb \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.poll\noperand D23_sequence_ozon.polling \"\" guard=\"статус WAITING; наступил срок проверки\" max=\"*\" min=1 order=0 owner=D23_sequence_ozon.poll\noccurrence D23_sequence_ozon.m10Send \"\" lifeline=D23_sequence_ozon.lane3 order=22 owner=D23_sequence_ozon.polling\noccurrence D23_sequence_ozon.m10Receive \"\" lifeline=D23_sequence_ozon.lane4 order=23 owner=D23_sequence_ozon.polling\nmessage D23_sequence_ozon.m10 \"Запросить результат по известному ID\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m10Receive send=D23_sequence_ozon.m10Send sequence=10 sort=synchCall\nview view_d073b002bcfc \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m10\nfragment D23_sequence_ozon.final \"Ответ на проверку статуса\" operator=alt order=24 owner=D23_sequence_ozon.polling\ncoverage D23_sequence_ozon.finalCover0 \"\" lifeline=D23_sequence_ozon.lane0 owner=D23_sequence_ozon.final\ncoverage D23_sequence_ozon.finalCover1 \"\" lifeline=D23_sequence_ozon.lane1 owner=D23_sequence_ozon.final\ncoverage D23_sequence_ozon.finalCover2 \"\" lifeline=D23_sequence_ozon.lane2 owner=D23_sequence_ozon.final\ncoverage D23_sequence_ozon.finalCover3 \"\" lifeline=D23_sequence_ozon.lane3 owner=D23_sequence_ozon.final\ncoverage D23_sequence_ozon.finalCover4 \"\" lifeline=D23_sequence_ozon.lane4 owner=D23_sequence_ozon.final\nview view_5131c152cfa1 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.final\noperand D23_sequence_ozon.waiting \"\" guard=\"ещё обрабатывается\" order=0 owner=D23_sequence_ozon.final\noperand D23_sequence_ozon.done \"\" guard=успешно order=1 owner=D23_sequence_ozon.final\noperand D23_sequence_ozon.bad \"\" guard=\"ошибка обработки\" order=2 owner=D23_sequence_ozon.final\noccurrence D23_sequence_ozon.m11Send \"\" lifeline=D23_sequence_ozon.lane4 order=25 owner=D23_sequence_ozon.waiting\noccurrence D23_sequence_ozon.m11Receive \"\" lifeline=D23_sequence_ozon.lane3 order=26 owner=D23_sequence_ozon.waiting\nmessage D23_sequence_ozon.m11 \"WAITING: задача ещё обрабатывается\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m11Receive replyTo=D23_sequence_ozon.m10 send=D23_sequence_ozon.m11Send sequence=11 sort=reply\nview view_247403183696 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m11\noccurrence D23_sequence_ozon.m12Send \"\" lifeline=D23_sequence_ozon.lane4 order=27 owner=D23_sequence_ozon.done\noccurrence D23_sequence_ozon.m12Receive \"\" lifeline=D23_sequence_ozon.lane3 order=28 owner=D23_sequence_ozon.done\nmessage D23_sequence_ozon.m12 \"Успех: внешний ID товара\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m12Receive replyTo=D23_sequence_ozon.m10 send=D23_sequence_ozon.m12Send sequence=12 sort=reply\nview view_270445235a33 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m12\noccurrence D23_sequence_ozon.m13Send \"\" lifeline=D23_sequence_ozon.lane3 order=29 owner=D23_sequence_ozon.done\noccurrence D23_sequence_ozon.m13Receive \"\" lifeline=D23_sequence_ozon.lane2 order=30 owner=D23_sequence_ozon.done\nmessage D23_sequence_ozon.m13 \"SUCCESS, PUBLISHED и уведомление\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m13Receive send=D23_sequence_ozon.m13Send sequence=13 sort=synchCall\nview view_5e15aa36a299 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m13\noccurrence D23_sequence_ozon.m14Send \"\" lifeline=D23_sequence_ozon.lane4 order=31 owner=D23_sequence_ozon.bad\noccurrence D23_sequence_ozon.m14Receive \"\" lifeline=D23_sequence_ozon.lane3 order=32 owner=D23_sequence_ozon.bad\nmessage D23_sequence_ozon.m14 \"Ошибка обработки: причины отклонения\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m14Receive replyTo=D23_sequence_ozon.m10 send=D23_sequence_ozon.m14Send sequence=14 sort=reply\nview view_64688e90d8b8 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m14\noccurrence D23_sequence_ozon.m15Send \"\" lifeline=D23_sequence_ozon.lane3 order=33 owner=D23_sequence_ozon.bad\noccurrence D23_sequence_ozon.m15Receive \"\" lifeline=D23_sequence_ozon.lane2 order=34 owner=D23_sequence_ozon.bad\nmessage D23_sequence_ozon.m15 \"Постоянная ошибка: FAILED; сохранить причины\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m15Receive send=D23_sequence_ozon.m15Send sequence=15 sort=synchCall\nview view_08849af93275 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m15\noccurrence D23_sequence_ozon.m16Send \"\" lifeline=D23_sequence_ozon.lane3 order=35 owner=D23_sequence_ozon.transient\noccurrence D23_sequence_ozon.m16Receive \"\" lifeline=D23_sequence_ozon.lane2 order=36 owner=D23_sequence_ozon.transient\nmessage D23_sequence_ozon.m16 \"RETRY: не более 3 повторов; сохранить причину и next_attempt_at; соблюдать срок сервера\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m16Receive send=D23_sequence_ozon.m16Send sequence=16 sort=synchCall\nview view_588a922103fc \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m16\noccurrence D23_sequence_ozon.m17Send \"\" lifeline=D23_sequence_ozon.lane3 order=37 owner=D23_sequence_ozon.transient\noccurrence D23_sequence_ozon.m17Receive \"\" lifeline=D23_sequence_ozon.lane3 order=38 owner=D23_sequence_ozon.transient\nmessage D23_sequence_ozon.m17 \"Ожидать next_attempt_at, не блокируя пользовательский запрос\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m17Receive send=D23_sequence_ozon.m17Send sequence=17 sort=asynchSignal\nview view_512b62ef7fc4 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m17\noccurrence D23_sequence_ozon.m18Send \"\" lifeline=D23_sequence_ozon.lane3 order=39 owner=D23_sequence_ozon.uncertain\noccurrence D23_sequence_ozon.m18Receive \"\" lifeline=D23_sequence_ozon.lane2 order=40 owner=D23_sequence_ozon.uncertain\nmessage D23_sequence_ozon.m18 \"UNCERTAIN: сохранить тот же operation_key и снимок запроса\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m18Receive send=D23_sequence_ozon.m18Send sequence=18 sort=synchCall\nview view_2180510b2193 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m18\noccurrence D23_sequence_ozon.m19Send \"\" lifeline=D23_sequence_ozon.lane3 order=41 owner=D23_sequence_ozon.uncertain\noccurrence D23_sequence_ozon.m19Receive \"\" lifeline=D23_sequence_ozon.lane4 order=42 owner=D23_sequence_ozon.uncertain\nmessage D23_sequence_ozon.m19 \"Сверить по внешнему ID или стабильному offer_id; не повторять отправку вслепую\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m19Receive send=D23_sequence_ozon.m19Send sequence=19 sort=synchCall\nview view_26404f2e838a \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m19\noccurrence D23_sequence_ozon.m20Send \"\" lifeline=D23_sequence_ozon.lane3 order=43 owner=D23_sequence_ozon.uncertain\noccurrence D23_sequence_ozon.m20Receive \"\" lifeline=D23_sequence_ozon.lane2 order=44 owner=D23_sequence_ozon.uncertain\nmessage D23_sequence_ozon.m20 \"Если сверка неоднозначна — прекратить автоповторы до решения сотрудника\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m20Receive send=D23_sequence_ozon.m20Send sequence=20 sort=synchCall\nview view_8b43c0273b8c \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m20\noccurrence D23_sequence_ozon.m21Send \"\" lifeline=D23_sequence_ozon.lane3 order=45 owner=D23_sequence_ozon.permanent\noccurrence D23_sequence_ozon.m21Receive \"\" lifeline=D23_sequence_ozon.lane2 order=46 owner=D23_sequence_ozon.permanent\nmessage D23_sequence_ozon.m21 \"Постоянная ошибка: FAILED; сохранить причины\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m21Receive send=D23_sequence_ozon.m21Send sequence=21 sort=synchCall\nview view_006051b8ed06 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m21\nannotation D23_sequence_ozon.note \"Сообщения описывают сценарий, а не собственную спецификацию API. Имена методов и реальные endpoint не задаются. Пунктир — ответ.\\nЛокальная уникальность operation_key не гарантирует exactly-once во внешнем сервисе.\"\nview view_d931d6abfcf6 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.note\n",
