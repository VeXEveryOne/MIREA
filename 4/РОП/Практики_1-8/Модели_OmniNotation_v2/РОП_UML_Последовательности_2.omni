23_sequence_ozon.m1Receive \"\" lifeline=D23_sequence_ozon.lane1 order=1 owner=D23_sequence_ozon.interaction\nmessage D23_sequence_ozon.m1 \"Утвердить card_version; HTTPS / JSON\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m1Receive send=D23_sequence_ozon.m1Send sequence=1 sort=synchCall\nview view_cdde41499bdf \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m1\noccurrence D23_sequence_ozon.m2Send \"\" lifeline=D23_sequence_ozon.lane1 order=2 owner=D23_sequence_ozon.interaction\noccurrence D23_sequence_ozon.m2Receive \"\" lifeline=D23_sequence_ozon.lane2 order=3 owner=D23_sequence_ozon.interaction\nmessage D23_sequence_ozon.m2 \"Проверки и запись QUEUED + operation_key\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m2Receive send=D23_sequence_ozon.m2Send sequence=2 sort=synchCall\nview view_ded726234fb6 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m2\noccurrence D23_sequence_ozon.m3Send \"\" lifeline=D23_sequence_ozon.lane1 order=4 owner=D23_sequence_ozon.interaction\noccurrence D23_sequence_ozon.m3Receive \"\" lifeline=D23_sequence_ozon.lane0 order=5 owner=D23_sequence_ozon.interaction\nmessage D23_sequence_ozon.m3 \"Принято в очередь; локальный ID\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m3Receive replyTo=D23_sequence_ozon.m1 send=D23_sequence_ozon.m3Send sequence=3 sort=reply\nview view_b9809e51b9a3 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m3\noccurrence D23_sequence_ozon.m4Send \"\" lifeline=D23_sequence_ozon.lane1 order=6 owner=D23_sequence_ozon.interaction\noccurrence D23_sequence_ozon.m4Receive \"\" lifeline=D23_sequence_ozon.lane3 order=7 owner=D23_sequence_ozon.interaction\nmessage D23_sequence_ozon.m4 \"Уведомление о доступной очереди; обработка независимо от HTTP-запроса\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m4Receive send=D23_sequence_ozon.m4Send sequence=4 sort=asynchSignal\nview view_bfd2b40e252d \"\" diagram=D23_sequence_ozon eleme