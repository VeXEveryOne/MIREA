  "source": "erd ropData \"Карточки компьютерных систем ООО Юкомс\"\nentity role Роль schema=rop sqlName=role\nattribute role.code Код length=16 nullable=false order=0 owner=role sqlName=code sqlType=varchar\nattribute role.name Наименование length=80 nullable=false order=1 owner=role sqlName=name sqlType=varchar\nkey role.pk1 \"Первичный ключ\" kind=primary owner=role sqlName=role_pkey\nkeyPart role.pk1.part0 \"\" attribute=role.code order=0 owner=role.pk1\nentity app_user Пользователь schema=rop sqlName=app_user\nattribute app_user.id Идентификатор identity=always nullable=false order=0 owner=app_user sqlName=id sqlType=bigint\nattribute app_user.login Логин length=80 nullable=false order=1 owner=app_user sqlName=login sqlType=varchar\nattribute app_user.password_hash \"Хеш пароля\" length=255 nullable=false order=2 owner=app_user sqlName=password_hash sqlType=varchar\nattribute app_user.display_name \"Отображаемое имя\" length=120 nullable=false order=3 owner=app_user sqlName=display_name sqlType=varchar\nattribute app_user.active Активен default=true nullable=false order=4 owner=app_user sqlName=active sqlType=boolean\nattribute app_user.created_at \"Дата создания\" default=CURRENT_TIMESTAMP nullable=false order=5 owner=app_user sqlName=created_at sqlType=timestamptz\nkey app_user.pk1 \"Первичный ключ\" kind=primary owner=app_user sqlName=app_user_pkey\nkeyPart app_user.pk1.part0 \"\" attribute=app_user.id order=0 owner=app_user.pk1\nkey app_user.uq1 \"Уникальный ключ\" kind=unique owner=app_user sqlName=app_user_uq_1\nkeyPart app_user.uq1.part0 \"\" attribute=app_user.login order=0 owner=app_user.uq1\nentity user_role \"Назначение роли\" schema=rop sqlName=user_role\nattribute user_role.user_id Пользователь nullable=false order=0 owner=user_role sqlName=user_id sqlType=bigint\nattribute user_role.role_code \"Код роли\" length=16 nullable=false order=1 owner=user_role sqlName=role_code sqlType=varchar\nattribute user_role.created_at \"Дата создания\" default=CURRENT_TIMESTAMP nullable=false order=2 owner=user_role sqlName=created_at sqlType=timestamptz\nkey user_role.pk1 \"Первичный ключ\" kind=primary owner=user_role sqlName=user_role_pkey\nkeyPart user_role.pk1.part0 \"\" attribute=user_role.user_id order=0 owner=user_role.pk1\nkeyPart user_role.pk1.part1 \"\" attribute=user_role.role_code order=1 owner=user_role.pk1\nentity supplier Поставщик schema=rop sqlName=supplier\nattribute supplier.id Идентификатор identity=always nullable=false order=0 owner=supplier sqlName=id sqlType=bigint\nattribute supplier.code Код length=16 nullable=false order=1 owner=supplier sqlName=code sqlType=varchar\nattribute supplier.name Наименование length=120 nullable=false order=2 owner=supplier sqlName=name sqlType=varchar\nattribute supplier.priority Приоритет nullable=false order=3 owner=supplier sqlName=priority sqlType=smallint\nattribute supplier.enabled Разрешён default=true nullable=false order=4 owner=supplier sqlName=enabled sqlType=boolean\nkey supplier.pk1 \"Первичный ключ\" kind=primary owner=supplier sqlName=supplier_pkey\nkeyPart supplier.pk1.part0 \"\" attribute=supplier.id order=0 owner=supplier.pk1\nkey supplier.uq1 \"Уникальный ключ\" kind=unique owner=supplier sqlName=supplier_uq_1\nkeyPart supplier.uq1.part0 \"\" attribute=supplier.code order=0 owner=supplier.uq1\ncheck supplier.check1 \"Проверка строки\" expression=\"priority > 0\" owner=supplier\nentity component Компонент schema=rop sqlName=component\nattribute component.id Идентификатор identity=always nullable=false order=0 owner=component sqlName=id sqlType=bigint\nattribute component.code Код default=\"('CMP-' || lpad(nextval('component_code_seq')::text, 6, '0'))\" defaultSequence=component_code_seq length=20 nullable=false order=1 owner=component sqlName=code sqlType=varchar\nattribute component.kind Вид length=12 nullable=false order=2 owner=component sqlName=kind sqlType=varchar\nattribute component.model Модель length=150 nullable=false order=3 owner=component sqlName=model sqlType=varchar\nattribute component.mass_kg \"Масса, кг\" nullable=false order=4 owner=component precision=8 scale=3 sqlName=mass_kg sqlType=numeric\nattribute component.active Активен default=true nullable=false order=5 owner=component sqlName=active sqlType=boolean\nkey component.pk1 \"Первичный ключ\" kind=primary owner=component sqlName=component_pkey\nkeyPart component.pk1.part0 \"\" attribute=component.id order=0 owner=component.pk1\nkey component.uq1 \"Уникальный ключ\" kind=unique owner=component sqlName=component_uq_1\nkeyPart component.uq1.part0 \"\" attribute=component.code order=0 owner=component.uq1\ncheck component.check1 \"Проверка строки\" expression=\"kind IN ('CASE','CPU','BOARD','RAM','GPU','SSD','PSU','COOLER')\" owner=component\ncheck component.check2 \"Проверка строки\" expression=\"mass_kg > 0\" owner=component\nentity characteristic Характеристика schema=rop sqlName=characteristic\nattribute characteristic.id Идентификатор identity=always nullable=false order=0 owner=characteristic sqlName=id sqlType=bigint\nattribute characteristic.code Код length=32 nullable=false order=1 owner=characteristic sqlName=code sqlType=varchar\nattribute characteristic.name Наименование length=120 nullable=false order=2 owner=characteristic sqlName=name sqlType=varchar\nattribute characteristic.value_kind \"Вид значения\" length=8 nullable=false order=3 owner=characteristic sqlName=value_kind sqlType=varchar\nattribute characteristic.unit \"Единица измерения\" length=16 nullable=true order=4 owner=characteristic sqlName=unit sqlType=varchar\nkey characteristic.pk1 \"Первичный ключ\" kind=primary owner=characteristic sqlName=characteristic_pkey\nkeyPart characteristic.pk1.part0 \"\" attribute=characteristic.id order=0 owner=characteristic.pk1\nkey characteristic.uq1 \"Уникальный ключ\" kind=unique owner=characteristic sqlName=characteristic_uq_1\nkeyPart characteristic.uq1.part0 \"\" attribute=characteristic.code order=0 owner=characteristic.uq1\ncheck characteristic.check1 \"Проверка строки\" expression=\"value_kind IN ('NUMBER','TEXT')\" owner=characteristic\nentity component_value \"Значение характеристики\" schema=rop sqlName=component_value\nattribute component_value.component_id Компонент nullable=false order=0 owner=component_value sqlName=component_id sqlType=bigint\nattribute component_value.characteristic_id Характеристика nullable=false order=1 owner=component_value sqlName=characteristic_id sqlType=bigint\nattribute component_value.number_value \"Числовое значение\" nullable=true order=2 owner=component_value precision=14 scale=4 sqlName=number_value sqlType=numeric\nattribute component_value.text_value \"Текстовое значение\" length=150 nullable=true order=3 owner=component_value sqlName=text_value sqlType=varchar\nkey component_value.pk1 \"Первичный ключ\" kind=primary owner=component_value sqlName=component_value_pkey\nkeyPart component_value.pk1.part0 \"\" attribute=component_value.component_id order=0 owner=component_value.pk1\nkeyPart component_value.pk1.part1 \"\" attribute=component_value.characteristic_id order=1 owner=component_value.pk1\ncheck component_value.check1 \"Проверка строки\" expression=\"(number_value IS NULL) <> (text_value IS NULL)\" owner=component_value\nentity component_group \"Группа компонентов\" schema=rop sqlName=component_group\nattribute component_group.id Идентификатор identity=always nullable=false order=0 owner=component_group sqlName=id sqlType=bigint\nattribute component_group.code Код length=32 nullable=false order=1 owner=component_group sqlName=code sqlType=varchar\nattribute component_group.name Наименование length=120 nullable=false order=2 owner=component_group sqlName=name sqlType=varchar\nattribute component_group.kind Вид length=12 nullable=false order=3 owner=component_group sqlName=kind sqlType=varchar\nattribute component_group.criteria \"Критерии отбора\" nullable=false order=4 owner=component_group sqlName=criteria sqlType=jsonb\nkey component_group.pk1 \"Первичный ключ\" kind=primary owner=component_group sqlName=component_group_pkey\nkeyPart component_group.pk1.part0 \"\" attribute=component_group.id order=0 owner=component_group.pk1\nkey component_group.uq1 \"Уникальный ключ\" kind=unique owner=component_group sqlName=component_group_uq_1\nkeyPart component_group.uq1.part0 \"\" attribute=component_group.code order=0 owner=component_group.uq1\ncheck component_group.check1 \"Проверка строки\" expression=\"jsonb_typeof(criteria) = 'object'\" owner=component_group\nentity supplier_product \"Товар поставщика\" schema=rop sqlName=supplier_product\nattribute supplier_product.id Идентификатор identity=always nullable=false order=0 owner=supplier_product sqlName=id sqlType=bigint\nattribute supplier_product.supplier_id Поставщик nullable=false order=1 owner=supplier_product sqlName=supplier_id sqlType=bigint\nattribute supplier_product.external_sku \"Артикул поставщика\" length=80 nullable=false order=2 owner=supplier_product sqlName=external_sku sqlType=varchar\nattribute supplier_product.title Название length=180 nullable=false order=3 owner=supplier_product sqlName=title sqlType=varchar\nattribute supplier_product.component_id Компонент nullable=true order=4 owner=supplier_product sqlName=component_id sqlType=bigint\nattribute supplier_product.active Активен default=true nullable=false order=5 owner=supplier_product sqlName=active sqlType=boolean\nkey supplier_product.pk1 \"Первичный ключ\" kind=primary owner=supplier_product sqlName=supplier_product_pkey\nkeyPart supplier_product.pk1.part0 \"\" attribute=supplier_product.id order=0 owner=supplier_product.pk1\nkey supplier_product.uq1 \"Уникальный ключ\" kind=unique owner=supplier_product sqlName=supplier_product_uq_1\nkeyPart supplier_product.uq1.part0 \"\" attribute=supplier_product.supplier_id order=0 owner=supplier_product.uq1\nkeyPart supplier_product.uq1.part1 \"\" attribute=supplier_product.external_sku order=1 owner=supplier_product.uq1\nentity supplier_offer \"Предложение поставщика\" schema=rop sqlName=supplier_offer\nattribute supplier_offer.id Идентификатор identity=always nullable=false order=0 owner=supplier_offer sqlName=id sqlType=bigint\nattribute supplier_offer.product_id \"Товар поставщика\" nullable=false order=1 owner=supplier_offer sqlName=product_id sqlType=bigint\nattribute supplier_offer.price Цена nullable=false order=2 owner=supplier_offer precision=14 scale=2 sqlName=price sqlType=numeric\nattribute supplier_offer.currency Валюта default=\"'RUB'\" length=3 nullable=false order=3 owner=supplier_offer sqlName=currency sqlType=varchar\nattribute supplier_offer.available_qty \"Доступное количество\" nullable=false order=4 owner=supplier_offer sqlName=available_qty sqlType=integer\nattribute supplier_offer.observed_at \"Дата актуальности\" default=CURRENT_TIMESTAMP nullable=false order=5 owner=supplier_offer sqlName=observed_at sqlType=timestamptz\nattribute supplier_offer.source_hash \"Хеш исходных данных\" length=64 nullable=false order=6 owner=supplier_offer sqlName=source_hash sqlType=varchar\nkey supplier_offer.pk1 \"Первичный ключ\" kind=primary owner=supplier_offer sqlName=supplier_offer_pkey\nkeyPart supplier_offer.pk1.part0 \"\" attribute=supplier_offer.id order=0 owner=supplier_offer.pk1\ncheck supplier_offer.check1 \"Проверка строки\" expression=\"price > 0\" owner=supplier_offer\ncheck supplier_offer.check2 \"Проверка строки\" expression=\"currency = 'RUB'\" owner=supplier_offer\ncheck supplier_offer.check3 \"Проверка строки\" expression=\"available_qty >= 0\" owner=supplier_offer\nkey supplier_offer.uq1 \"Уникальный ключ\" kind=unique owner=supplier_offer sqlName=supplier_offer_uq_1\nkeyPart supplier_offer.uq1.part0 \"\" attribute=supplier_offer.product_id order=0 owner=supplier_offer.uq1\nkeyPart supplier_offer.uq1.part1 \"\" attribute=supplier_offer.observed_at order=1 owner=supplier_offer.uq1\nkeyPart supplier_offer.uq1.part2 \"\" attribute=supplier_offer.source_hash order=2 owner=supplier_offer.uq1\nentity model_line \"Модельный ряд\" schema=rop sqlName=model_line\nattribute model_line.id Идентификатор identity=always nullable=false order=0 owner=model_line sqlName=id sqlType=bigint\nattribute model_line.code Код default=\"('MR-' || lpad(nextval('model_line_code_seq')::text, 6, '0'))\" defaultSequence=model_line_code_seq length=24 nullable=false order=1 owner=model_line sqlName=code sqlType=varchar\nattribute model_line.name Наименование length=150 nullable=false order=2 owner=model_line sqlName=name sqlType=varchar\nattribute model_line.created_by Автор nullable=false order=3 owner=model_line sqlName=created_by sqlType=bigint\nattribute model_line.created_at \"Дата создания\" default=CURRENT_TIMESTAMP nullable=false order=4 owner=model_line sqlName=created_at sqlType=timestamptz\nkey model_line.pk1 \"Первичный ключ\" kind=primary owner=model_line sqlName=model_line_pkey\nkeyPart model_line.pk1.part0 \"\" attribute=model_line.id order=0 owner=model_line.pk1\nkey model_line.uq1 \"Уникальный ключ\" kind=unique owner=model_line sqlName=model_line_uq_1\nkeyPart model_line.uq1.part0 \"\" attribute=model_line.code order=0 owner=model_line.uq1\nentity change_request \"Запрос на изменение\" schema=rop sqlName=change_request\nattribute change_request.id Идентификатор identity=always nullable=false order=0 owner=change_request sqlName=id sqlType=bigint\nattribute change_request.model_line_id \"Модельный ряд\" nullable=false order=1 owner=change_request sqlName=model_line_id sqlType=bigint\nattribute change_request.created_by Автор nullable=false order=2 owner=change_request sqlName=created_by sqlType=bigint\nattribute change_request.kind Вид length=12 nullable=false order=3 owner=change_request sqlName=kind sqlType=varchar\nattribute change_request.reason Причина nullable=false order=4 owner=change_request sqlName=reason sqlType=text\nattribute change_request.created_at \"Дата создания\" default=CURRENT_TIMESTAMP nullable=false order=5 owner=change_request sqlName=created_at sqlType=timestamptz\nkey change_request.pk1 \"Первичный ключ\" kind=primary owner=change_request sqlName=change_request_pkey\nkeyPart change_request.pk1.part0 \"\" attribute=change_request.id order=0 owner=change_request.pk1\ncheck change_request.check1 \"Проверка строки\" expression=\"kind IN ('CREATE','UPDATE','REPLACE')\" owner=change_request\nentity model_line_version \"Версия модельного ряда\" schema=rop sqlName=model_line_version\nattribute model_line_version.id Идентификатор identity=always nullable=false order=0 owner=model_line_version sqlName=id sqlType=bigint\nattribute model_line_version.model_line_id \"Модельный ряд\" nullable=false order=1 owner=model_line_version sqlName=model_line_id sqlType=bigint\nattribute model_line_version.version_no \"Номер версии\" nullable=false order=2 owner=model_line_version sqlName=version_no sqlType=integer\nattribute model_line_version.request_id \"Запрос на изменение\" nullable=false order=3 owner=model_line_version sqlName=request_id sqlType=bigint\nattribute model_line_version.case_component_id Корпус nullable=false order=4 owner=model_line_version sqlName=case_component_id sqlType=bigint\nattribute model_line_version.state Состояние length=12 nullable=false order=5 owner=model_line_version sqlName=state sqlType=varchar\nattribute model_line_version.created_by Автор nullable=false order=6 owner=model_line_version sqlName=created_by sqlType=bigint\nattribute model_line_version.created_at \"Дата создания\" default=CURRENT_TIMESTAMP nullable=false order=7 owner=model_line_version sqlName=created_at sqlType=timestamptz\nkey model_line_version.pk1 \"Первичный ключ\" kind=primary owner=model_line_version sqlName=model_line_version_pkey\nkeyPart model_line_version.pk1.part0 \"\" attribute=model_line_version.id order=0 owner=model_line_version.pk1\ncheck model_line_version.check1 \"Проверка строки\" expression=\"version_no > 0\" owner=model_line_version\ncheck model_line_version.check2 \"Проверка строки\" expression=\"state IN ('DRAFT','CHECKED','ARCHIVED')\" owner=model_line_version\nkey model_line_version.uq1 \"Уникальный ключ\" kind=unique owner=model_line_version sqlName=model_line_version_uq_1\nkeyPart model_line_version.uq1.part0 \"\" attribute=model_line_version.model_line_id order=0 owner=model_line_version.uq1\nkeyPart model_line_version.uq1.part1 \"\" attribute=model_line_version.version_no order=1 owner=model_line_version.uq1\nentity model_line_slot \"Слот модельного ряда\" schema=rop sqlName=model_line_slot\nattribute model_line_slot.id Идентификатор identity=always nullable=false order=0 owner=model_line_slot sqlName=id sqlType=bigint\nattribute model_line_slot.version_id \"Версия модельного ряда\" nullable=false order=1 owner=model_line_slot sqlName=version_id sqlType=bigint\nattribute model_line_slot.slot_code \"Код слота\" length=20 nullable=false order=2 owner=model_line_slot sqlName=slot_code sqlType=varchar\nattribute model_line_slot.quantity Количество nullable=false order=3 owner=model_line_slot sqlName=quantity sqlType=integer\nattribute model_line_slot.component_id Компонент nullable=true order=4 owner=model_line_slot sqlName=component_id sqlType=bigint\nattribute model_line_slot.group_id \"Группа компонентов\" nullable=true order=5 owner=model_line_slot sqlName=group_id sqlType=bigint\nattribute model_line_slot.pinned_product_id \"Закреплённый товар\" nullable=true order=6 owner=model_line_slot sqlName=pinned_product_id sqlType=bigint\nkey model_line_slot.pk1 \"Первичный ключ\" kind=primary owner=model_line_slot sqlName=model_line_slot_pkey\nkeyPart model_line_slot.pk1.part0 \"\" attribute=model_line_slot.id order=0 owner=model_line_slot.pk1\ncheck model_line_slot.check1 \"Проверка строки\" expression=\"quantity > 0\" owner=model_line_slot\nkey model_line_slot.uq1 \"Уникальный ключ\" kind=unique owner=model_line_slot sqlName=model_line_slot_uq_1\nkeyPart model_line_slot.uq1.part0 \"\" attribute=model_line_slot.version_id order=0 owner=model_line_slot.uq1\nkeyPart model_line_slot.uq1.part1 \"\" attribute=model_line_slot.slot_code order=1 owner=model_line_slot.uq1\ncheck model_line_slot.check2 \"Проверка строки\" expression=\"(component_id IS NULL) <> (group_id IS NULL)\" owner=model_line_slot\ncheck model_line_slot.check3 \"Проверка строки\" expression=\"pinned_product_id IS NULL OR component_id IS NOT NULL\" owner=model_line_slot\nentity slot_selection \"Разрешённый слот\" schema=rop sqlName=slot_selection\nattribute slot_selection.slot_id Слот nullable=false order=0 owner=slot_selection sqlName=slot_id sqlType=bigint\nattribute slot_selection.offer_id Предложение nullable=false order=1 owner=slot_selection sqlName=offer_id sqlType=bigint\nattribute slot_selection.resolved_component_id \"Выбранный компонент\" nullable=false order=2 owner=slot_selection sqlName=resolved_component_id sqlType=bigint\nattribute slot_selection.selected_at \"Дата выбора\" default=CURRENT_TIMESTAMP nullable=false order=3 owner=slot_selection sqlName=selected_at sqlType=timestamptz\nkey slot_selection.pk1 \"Первичный ключ\" kind=primary owner=slot_selection sqlName=slot_selection_pkey\nkeyPart slot_selection.pk1.part0 \"\" attribute=slot_selection.slot_id order=0 owner=slot_selection.pk1\nentity compatibility_rule \"Правило совместимости\" schema=rop sqlName=compatibility_rule\nattribute compatibility_rule.id Идентификатор identity=always nullable=false order=0 owner=compatibility_rule sqlName=id sqlType=bigint\nattribute compatibility_rule.code Код length=32 nullable=false order=1 owner=compatibility_rule sqlName=code sqlType=varchar\nattribute compatibility_rule.revision Редакция nullable=false order=2 owner=compatibility_rule sqlName=revision sqlType=integer\nattribute compatibility_rule.name Наименование length=150 nullable=false order=3 owner=compatibility_rule sqlName=name sqlType=varchar\nattribute compatibility_rule.expression \"Выражение правила\" nullable=false order=4 owner=compatibility_rule sqlName=expression sq