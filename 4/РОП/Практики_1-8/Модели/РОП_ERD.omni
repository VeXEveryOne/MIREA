lName=revision sqlType=integer\nattribute image_template.storage_key storage_key length=255 nullable=false order=3 owner=image_template sqlName=storage_key sqlType=varchar\nattribute image_template.approved approved default=false nullable=false order=4 owner=image_template sqlName=approved sqlType=boolean\nkey image_template.pk1 \"Первичный ключ\" kind=primary owner=image_template sqlName=image_template_pkey\nkeyPart image_template.pk1.part0 \"\" attribute=image_template.id order=0 owner=image_template.pk1\ncheck image_template.check1 \"Проверка строки\" expression=\"revision > 0\" owner=image_template\nkey image_template.uq1 \"Уникальный ключ\" kind=unique owner=image_template sqlName=image_template_uq_1\nkeyPart image_template.uq1.part0 \"\" attribute=image_template.code order=0 owner=image_template.uq1\nkeyPart image_template.uq1.part1 \"\" attribute=image_template.revision order=1 owner=image_template.uq1\nentity image_asset Изображение schema=rop sqlName=image_asset\nattribute image_asset.id Идентификатор identity=always nullable=false order=0 owner=image_asset sqlName=id sqlType=bigint\nattribute image_asset.template_id \"Ссылка на image_template\" nullable=true order=1 owner=image_asset sqlName=template_id sqlType=bigint\nattribute image_asset.storage_key storage_key length=255 nullable=false order=2 owner=image_asset sqlName=storage_key sqlType=varchar\nattribute image_asset.sha256 sha256 length=64 nullable=false order=3 owner=image_asset sqlName=sha256 sqlType=varchar\nattribute image_asset.width_px width_px nullable=false order=4 owner=image_asset sqlName=width_px sqlType=integer\nattribute image_asset.height_px height_px nullable=false order=5 owner=image_asset sqlName=height_px sqlType=integer\nattribute image_asset.created_by \"Ссылка на app_user\" nullable=false order=6 owner=image_asset sqlName=created_by sqlType=bigint\nattribute image_asset.created_at \"Момент времени\" default=CURRENT_TIMESTAMP nullable=false order=7 owner=image_asset sqlName=created_at sqlType=timestamptz\nkey image_asset.pk1 \"Первичный ключ\" kind=primary owner=image_asset sqlName=image_asset_pkey\nkeyPart image_asset.pk1.part0 \"\" attribute=image_asset.id order=0 owner=image_asset.pk1\nkey image_asset.uq1 \"Уникальный ключ\" kind=unique owner=image_asset sqlName=image_asset_uq_1\nkeyPart image_asset.uq1.part0 \"\" attribute=image_asset.storage_key order=0 owner=image_asset.uq1\ncheck image_asset.check1 \"Проверка строки\" expression=\"width_px > 0\" owner=image_asset\ncheck image_asset.check2 \"Проверка строки\" expression=\"height_px > 0\" owner=image_asset\nentity card_image \"Изображения версии карточки\" schema=rop sqlName=card_image\nattribute card_image.card_version_id \"Ссылка на card_version\" nullable=false order=0 owner=card_image sqlName=card_version_id sqlType=bigint\nattribute card_image.image_id \"Ссылка на image_asset\" nullable=false order=1 owner=card_image sqlName=image_id sqlType=bigint\nattribute card_image.position position nullable=false order=2 owner=card_image sqlName=position sqlType=smallint\ncheck card_image.check1 \"Проверка строки\" expression=\"position > 0\" owner=card_image\nkey card_image.pk1 \"Первичный ключ\" kind=primary owner=card_image sqlName=card_image_pkey\nkeyPart card_image.pk1.part0 \"\" attribute=card_image.card_version_id order=0 owner=card_image.pk1\nkeyPart card_image.pk1.part1 \"\" attribute=card_image.image_id order=1 owner=card_image.pk1\nkey card_image.uq1 \"Уникальный ключ\" kind=unique owner=card_image sqlName=card_image_uq_1\nkeyPart card_image.uq1.part0 \"\" attribute=card_image.card_version_id order=0 owner=card_image.uq1\nkeyPart card_image.uq1.part1 \"\" attribute=card_image.position order=1 owner=card_image.uq1\nentity publication \"Публикация и очередь\" schema=rop sqlName=publication\nattribute publication.id Идентификатор identity=always nullable=false order=0 owner=publication sqlName=id sqlType=bigint\nattribute publication.card_version_id \"Ссылка на card_version\" nullable=false order=1 owner=publication sqlName=card_version_id sqlType=bigint\nattribute publication.operation_key operation_key length=64 nullable=false order=2 owner=publication sqlName=operation_key sqlType=varchar\nattribute publication.external_task_id external_task_id length=100 nullable=true order=3 owner=publication sqlName=external_task_id sqlType=varchar\nattribute publication.external_product_id external_product_id length=100 nullable=true order=4 owner=publication sqlName=external_product_id sqlType=varchar\nattribute publication.state state length=16 nullable=false order=5 owner=publication sqlName=state sqlType=varchar\nattribute publication.retry_count retry_count default=0 nullable=false order=6 owner=publication sqlName=retry_count sqlType=smallint\nattribute publication.next_attempt_at \"Момент времени\" nullable=true order=7 owner=publication sqlName=next_attempt_at sqlType=timestamptz\nattribute publication.request_snapshot request_snapshot nullable=false order=8 owner=publication sqlName=request_snapshot sqlType=jsonb\nattribute publication.response response nullable=true order=9 owner=publication sqlName=response sqlType=jsonb\nattribute publication.error_code error_code length=80 nullable=true order=10 owner=publication sqlName=error_code sqlType=varchar\nattribute publication.created_at \"Момент времени\" default=CURRENT_TIMESTAMP nullable=false order=11 owner=publication sqlName=created_at sqlType=timestamptz\nattribute publication.completed_at \"Момент времени\" nullable=true order=12 owner=publication sqlName=completed_at sqlType=timestamptz\nkey publication.pk1 \"Первичный ключ\" kind=primary owner=publication sqlName=publication_pkey\nkeyPart publication.pk1.part0 \"\" attribute=publication.id order=0 owner=publication.pk1\nkey publication.uq1 \"Уникальный ключ\" kind=unique owner=publication sqlName=publication_uq_1\nkeyPart publication.uq1.part0 \"\" attribute=publication.operation_key order=0 owner=publication.uq1\ncheck publication.check1 \"Проверка строки\" expression=\"state IN ('QUEUED','SENDING','WAITING','RETRY','SUCCESS','FAILED','UNCERTAIN')\" owner=publication\ncheck publication.check2 \"Проверка строки\" expression=\"retry_count BETWEEN 0 AND 3\" owner=publication\nentity audit_event \"Событие аудита\" schema=rop sqlName=audit_event\nattribute audit_event.id Идентификатор identity=always nullable=false order=0 owner=audit_event sqlName=id sqlType=bigint\nattribute audit_event.actor_id \"Ссылка на app_user\" nullable=true order=1 owner=audit_event sqlName=actor_id sqlType=bigint\nattribute audit_event.actor_kind actor_kind length=12 nullable=false order=2 owner=audit_event sqlName=actor_kind sqlType=varchar\nattribute audit_event.resource_type resource_type length=40 nullable=false order=3 owner=audit_event sqlName=resource_type sqlType=varchar\nattribute audit_event.resource_key resource_key length=100 nullable=false order=4 owner=audit_event sqlName=resource_key sqlType=varchar\nattribute audit_event.action action length=40 nullable=false order=5 owner=audit_event sqlName=action sqlType=varchar\nattribute audit_event.before_data before_data nullable=true order=6 owner=audit_event sqlName=before_data sqlType=jsonb\nattribute audit_event.after_data after_data nullable=true order=7 owner=audit_event sqlName=after_data sqlType=jsonb\nattribute audit_event.created_at \"Момент времени\" default=CURRENT_TIMESTAMP nullable=false order=8 owner=audit_event sqlName=created_at sqlType=timestamptz\nkey audit_event.pk1 \"Первичный ключ\" kind=primary owner=audit_event sqlName=audit_event_pkey\nkeyPart audit_event.pk1.part0 \"\" attribute=audit_event.id order=0 owner=audit_event.pk1\ncheck audit_event.check1 \"Проверка строки\" expression=\"actor_kind IN ('USER','SERVICE')\" owner=audit_event\nentity notification Уведомление schema=rop sqlName=notification\nattribute notification.id Идентификатор identity=always nullable=false order=0 owner=notification sqlName=id sqlType=bigint\nattribute notification.r