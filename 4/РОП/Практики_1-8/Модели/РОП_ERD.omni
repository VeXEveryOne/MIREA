on.view \"\" diagram=D20_physical_1 element=card_version.fk2.relation from=D20_physical_1.model_line_version.view to=D20_physical_1.card_version.view\nview D20_physical_1.card_version.fk3.relation.view \"\" diagram=D20_physical_1 element=card_version.fk3.relation from=D20_physical_1.validation_result.view to=D20_physical_1.card_version.view\nview D20_physical_1.card_version.fk4.relation.view \"\" diagram=D20_physical_1 element=card_version.fk4.relation from=D20_physical_1.calculation_rule.view to=D20_physical_1.card_version.view\nview D20_physical_1.image_asset.fk1.relation.view \"\" diagram=D20_physical_1 element=image_asset.fk1.relation from=D20_physical_1.image_template.view to=D20_physical_1.image_asset.view\nview D20_physical_1.image_asset.fk2.relation.view \"\" diagram=D20_physical_1 element=image_asset.fk2.relation from=D20_physical_1.app_user.view to=D20_physical_1.image_asset.view\nview D20_physical_1.card_image.fk1.relation.view \"\" diagram=D20_physical_1 element=card_image.fk1.relation from=D20_physical_1.card_version.view to=D20_physical_1.card_image.view\nview D20_physical_1.card_image.fk2.relation.view \"\" diagram=D20_physical_1 element=card_image.fk2.relation from=D20_physical_1.image_asset.view to=D20_physical_1.card_image.view\nview D20_physical_1.publication.fk1.relation.view \"\" diagram=D20_physical_1 element=publication.fk1.relation from=D20_physical_1.card_version.view to=D20_physical_1.publication.view\nview D20_physical_1.audit_event.fk1.relation.view \"\" diagram=D20_physical_1 element=audit_event.fk1.relation from=D20_physical_1.app_user.view to=D20_physical_1.audit_event.view\nview D20_physical_1.notification.fk1.relation.view \"\" diagram=D20_physical_1 element=notification.fk1.relation from=D20_physical_1.app_user.view to=D20_physical_1.notification.view\nview D20_physical_1.notification.fk2.relation.view \"\" diagram=D20_physical_1 element=notification.fk2.relation from=D20_physical_1.card.view to=D20_physical_1.notification.view\nrelation validation_rules \"Использованные редакции правил\" from=validation_result fromMax=many fromMin=0 to=compatibility_rule toMax=many toMin=1\nview D03_logical_1.validation_rules.view \"\" diagram=D03_logical_1 element=validation_rules from=D03_logical_1.validation_result.view to=D03_logical_1.compatibility_rule.view\nview D20_physical_1.validation_rules.view \"\" diagram=D20_physical_1 element=validation_rules from=D20_physical_1.validation_result.view to=D20_physical_1.compatibility_rule.view\n",
  "draft": "erd ropData \"Карточки компьютерных систем ООО Юкомс\"\nentity role Роль schema=rop sqlName=role\nattribute role.code Код length=16 nullable=false order=0 owner=role sqlName=code sqlType=varchar\nattribute role.name Наименование length=80 nullable=false order=1 owner=role sqlName=name sqlType=varchar\nkey role.pk1 \"Первичный ключ\" kind=primary owner=role sqlName=role_pkey\nkeyPart role.pk1.part0 \"\" attribute=role.code order=0 owner=role.pk1\nentity app_user Пользователь schema=rop sqlName=app_user\nattribute app_user.id Идентификатор identity=always nullable=false order=0 owner=app_user sqlName=id sqlType=bigint\nattribute app_user.login Логин length=80 nullable=false order=1 owner=app_user sqlName=login sqlType=varchar\nattribute app_user.password_hash \"Хеш пароля\" length=255 nullable=false order=2 owner=app_user sqlName=password_hash sqlType=varchar\nattribute app_user.display_name \"Отображаемое имя\" length=120 nullable=false order=3 owner=app_user sqlName=display_name sqlType=varchar\nattribute app_user.active Активен default=true nullable=false order=4 owner=app_user sqlName=active sqlType=boolean\nattribute app_user.created_at \"Дата создания\" default=CURRENT_TIMESTAMP nullable=false order=5 owner=app_user sqlName=created_at sqlType=timestamptz\nkey app_user.pk1 \"Первичный ключ\" kind=primary owner=app_user sqlName=app_user_pkey\nkeyPart app_user.pk1.part0 \"\" attribute=app_user.id order=0 owner=app_user.pk1\nkey app_user.uq1 \"Уникальный ключ\" kind=unique owner=app_user sqlName=app_user_uq_1\nkeyPart app_user.uq1.part0 \"\" attribute=app_user.login order=0 owner=app_user.uq1\nentity user_role \"Назначение роли\" schema=rop sqlName=user_role\nattribute user_role.user_id Пользователь nullable=false order=0 owner=user_role sqlName=user_id sqlType=bigint\nattribute user_role.role_code \"Код роли\" length=16 nullable=false order=1 owner=user_role sqlName=role_code sqlType=varchar\nattribute user_role.created_at \"Дата создания\" default=CURRENT_TIMESTAMP nullable=false order=2 owner=user_role sqlName=created_at sqlType=timestamptz\nkey user_role.pk1 \"Первичный ключ\" kind=primary owner=user_role sqlName=user_role_pkey\nkeyPart user_role.pk1.part0 \"\" attribute=user_role.user_id order=0 owner=user_role.pk1\nkeyPart user_role.pk1.part1 \"\" attribute=user_role.role_code order=1 owner=user_role.pk1\nentity supplier Поставщик schema=rop sqlName=supplier\nattribute supplier.id Идентификатор identity=always nullable=false order=0 owner=supplier sqlName=id sqlType=bigint\nattribute supplier.code Код length=16 nullable=false order=1 owner=supplier sqlName=code sqlType=varchar\nattribute supplier.name Наименование length=120 nullable=false order=2 owner=supplier sqlName=name sqlType=varchar\nattribute supplier.priority Приоритет nullable=false order=3 owner=supplier sqlName=priority sqlType=smallint\nattribute supplier.enabled Разрешён default=true nullable=false order=4 owner=supplier sqlName=enabled sqlType=boolean\nkey supplier.pk1 \"Первичный ключ\" kind=primary owner=supplier sqlName=supplier_pkey\nkeyPart supplier.pk1.part0 \"\" attribute=supplier.id order=0 owner=supplier.pk1\nkey supplier.uq1 \"Уникальный ключ\" kind=unique owner=supplier sqlName=supplier_uq_1\nkeyPart supplier.uq1.part0 \"\" attribute=supplier.code order=0 owner=supplier.uq1\ncheck supplier.check1 \"Проверка строки\" expression=\"priority > 0\" owner=supplier\nentity component Компонент schema=rop sqlName=component\nattribute component.id Идентификатор identity=always nullable=false order=0 owner=component sqlName=id sqlType=bigint\nattribute component.code Код default=\"('CMP-' || lpad(nextval('component_code_seq')::text, 6, '0'))\" defaultSequence=component_code_seq length=20 nullable=false order=1 owner=component sqlName=code sqlType=varchar\nattribute component.kind Вид length=12 nullable=false order=2 owner=component sqlName=kind sqlType=varchar\nattribute component.model Модель length=150 nullable=false order=3 owner=component sqlName=model sqlType=varchar\nattribute component.mass_kg \"Масса, кг\" nullable=false order=4 owner=component precision=8 scale=3 sqlName=mass_kg sqlType=numeric\nattribute component.active Активен default=true nullable=false order=5 owner=component sqlName=active sqlType=boolean\nkey component.pk1 \"Первичный ключ\" kind=primary owner=component sqlName=component_pkey\nkeyPart component.pk1.part0 \"\" attribute=component.id order=0 owner=component.pk1\nkey component.uq1 \"Уникальный ключ\" kind=unique owner=component sqlName=component_uq_1\nkeyPart component.uq1.part0 \"\" attribute=component.code order=0 owner=component.uq1\ncheck component.check1 \"Проверка строки\" expression=\"kind IN ('CASE','CPU','BOARD','RAM','GPU','SSD','PSU','COOLER')\" owner=component\ncheck component.check2 \"Проверка строки\" expression=\"mass_kg > 0\" owner=component\nentity characteristic Характеристика schema=rop sqlName=characteristic\nattribute characteristic.id Идентификатор identity=always nullable=false order=0 owner=characteristic sqlName=id sqlType=bigint\nattribute characteristic.code Код length=32 nullable=false order=1 owner=characteristic sqlName=code sqlType=varchar\nattribute characteristic.name Наименование length=120 nullable=false order=2 owner=characteristic sqlName=name sqlType=varchar\nattribute characteristic.value_kind \"Вид значения\" length=8 nullable=false order=3 owner=characteristic sqlName=value_kind sqlType=varchar\nattribute characteristic.unit \"Единица измерения\" length=16 nullable=true order=4 owner=characteristic sqlName=unit sqlType=varchar\nkey characteristic.pk1 \"Первичный ключ\" kind=primary owner=characteristic sqlName=characteristic_pkey\nkeyPart characteristic.pk1.part0 \"\" attribute=characteristic.id order=0 owner=characteristic.pk1\nkey characteristic.uq1 \"Уникальный ключ\" kind=unique owner=characteristic sqlName=characteristic_uq_1\nkeyPart characteristic.uq1.part0 \"\" attribute=characteristic.code order=0 owner=characteristic.uq1\nch