ozon.m11Send sequence=11 sort=reply\nview view_dd10f55566e4 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m11\noccurrence D23_sequence_ozon.m12Send \"\" lifeline=D23_sequence_ozon.lane4 order=27 owner=D23_sequence_ozon.done\noccurrence D23_sequence_ozon.m12Receive \"\" lifeline=D23_sequence_ozon.lane3 order=28 owner=D23_sequence_ozon.done\nmessage D23_sequence_ozon.m12 \"Успех: внешний ID товара\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m12Receive replyTo=D23_sequence_ozon.m10 send=D23_sequence_ozon.m12Send sequence=12 sort=reply\nview view_0037fa84c3e7 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m12\noccurrence D23_sequence_ozon.m13Send \"\" lifeline=D23_sequence_ozon.lane3 order=29 owner=D23_sequence_ozon.done\noccurrence D23_sequence_ozon.m13Receive \"\" lifeline=D23_sequence_ozon.lane2 order=30 owner=D23_sequence_ozon.done\nmessage D23_sequence_ozon.m13 \"SUCCESS, PUBLISHED и уведомление\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m13Receive send=D23_sequence_ozon.m13Send sequence=13 sort=synchCall\nview view_32c699c9ceff \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m13\noccurrence D23_sequence_ozon.m14Send \"\" lifeline=D23_sequence_ozon.lane4 order=31 owner=D23_sequence_ozon.bad\noccurrence D23_sequence_ozon.m14Receive \"\" lifeline=D23_sequence_ozon.lane3 order=32 owner=D23_sequence_ozon.bad\nmessage D23_sequence_ozon.m14 \"Ошибка обработки: причины отклонения\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m14Receive replyTo=D23_sequence_ozon.m10 send=D23_sequence_ozon.m14Send sequence=14 sort=reply\nview view_2ddfc8396852 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m14\noccurrence D23_sequence_ozon.m15Send \"\" lifeline=D23_sequence_ozon.lane3 order=33 owner=D23_sequence_ozon.bad\noccurrence D23_sequence_ozon.m15Receive \"\" lifeline=D23_sequence_ozon.lane2 order=34 owner=D23_sequence_ozon.bad\nmessage D23_sequence_ozon.m15 \"Постоянная ошибка: FAILED; сохранить причины\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m15Receive send=D23_sequence_ozon.m15Send sequence=15 sort=synchCall\nview view_4d4cd791890b \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m15\noccurrence D23_sequence_ozon.m16Send \"\" lifeline=D23_sequence_ozon.lane3 order=35 owner=D23_sequence_ozon.transient\noccurrence D23_sequence_ozon.m16Receive \"\" lifeline=D23_sequence_ozon.lane2 order=36 owner=D23_sequence_ozon.transient\nmessage D23_sequence_ozon.m16 \"RETRY: не более 3 повторов; сохранить причину и next_attempt_at; соблюдать срок сервера\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m16Receive send=D23_sequence_ozon.m16Send sequence=16 sort=synchCall\nview view_4c3bdbe351d7 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m16\noccurrence D23_sequence_ozon.m17Send \"\" lifeline=D23_sequence_ozon.lane3 order=37 owner=D23_sequence_ozon.transient\noccurrence D23_sequence_ozon.m17Receive \"\" lifeline=D23_sequence_ozon.lane3 order=38 owner=D23_sequence_ozon.transient\nmessage D23_sequence_ozon.m17 \"Ожидать next_attempt_at, не блокируя пользовательский запрос\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m17Receive send=D23_sequence_ozon.m17Send sequence=17 sort=asynchSignal\nview view_60e73728f29d \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m17\noccurrence D23_sequence_ozon.m18Send \"\" lifeline=D23_sequence_ozon.lane3 order=39 owner=D23_sequence_ozon.uncertain\noccurrence D23_sequence_ozon.m18Receive \"\" lifeline=D23_sequence_ozon.lane2 order=40 owner=D23_sequence_ozon.uncertain\nmessage D23_sequence_ozon.m18 \"UNCERTAIN: сохранить тот же operation_key и снимок запроса\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m18Receive send=D23_sequence_ozon.m18Send sequence=18 sort=synchCall\nview view_e7439ae4c7c4 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m18\noccurrence D23_sequence_ozon.m19Send \"\" lifeline=D23_sequence_ozon.lane3 order=41 owner=D23_sequence_ozon.uncertain\noccurrence D23_sequence_ozon.m19Receive \"\" lifeline=D23_sequence_ozon.lane4 order=42 owner=D23_sequence_ozon.uncertain\nmessage D23_sequence_ozon.m19 \"Сверить по внешнему ID или стабильному offer_id; не повторять отправку вслепую\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m19Receive send=D23_sequence_ozon.m19Send sequence=19 sort=synchCall\nview view_0ea889da29a3 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m19\noccurrence D23_sequence_ozon.m20Send \"\" lifeline=D23_sequence_ozon.lane3 order=43 owner=D23_sequence_ozon.uncertain\noccurrence D23_sequence_ozon.m20Receive \"\" lifeline=D23_sequence_ozon.lane2 order=44 owner=D23_sequence_ozon.uncertain\nmessage D23_sequence_ozon.m20 \"Если сверка неоднозначна — прекратить автоповторы до решения сотрудника\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m20Receive send=D23_sequence_ozon.m20Send sequence=20 sort=synchCall\nview view_49db628db970 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m20\noccurrence D23_sequence_ozon.m21Send \"\" lifeline=D23_sequence_ozon.lane3 order=45 owner=D23_sequence_ozon.permanent\noccurrence D23_sequence_ozon.m21Receive \"\" lifeline=D23_sequence_ozon.lane2 order=46 owner=D23_sequence_ozon.permanent\nmessage D23_sequence_ozon.m21 \"Постоянная ошибка: FAILED; сохранить причины\" owner=D23_sequence_ozon.interaction receive=D23_sequence_ozon.m21Receive send=D23_sequence_ozon.m21Send sequence=21 sort=synchCall\nview view_fb8bbe152bc4 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.m21\nannotation D23_sequence_ozon.note \"Сообщения описывают сценарий, а не собственную спецификацию API. Имена методов и реальные endpoint не задаются. Пунктир — ответ.\\nЛокальная уникальность operation_key не гарантирует exactly-once во внешнем сервисе.\"\nview view_fd3d70b246c3 \"\" diagram=D23_sequence_ozon element=D23_sequence_ozon.note\n",
