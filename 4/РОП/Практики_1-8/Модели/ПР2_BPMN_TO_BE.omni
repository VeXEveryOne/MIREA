      "object:6": {
        "type": "bpmn:FormalExpression",
        "properties": {
          "body": "result = success"
        }
      },
      "object:7": {
        "type": "bpmn:FormalExpression",
        "properties": {
          "body": "result != success"
        }
      },
      "object:8": {
        "type": "bpmn:FormalExpression",
        "properties": {
          "body": "result = retryable_failure and current_version = true and retries < 3"
        }
      },
      "object:9": {
        "type": "bpmn:FormalExpression",
        "properties": {
          "body": "result != retryable_failure or current_version = false or retries >= 3"
        }
      },
