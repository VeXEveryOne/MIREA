eldsView \"\" diagram=D05_wireframe_06 element=D05_wireframe_06.sourceFields parent=D05_wireframe_06.screenView\nwidget D05_wireframe_06.tabs Сведения order=423 owner=D05_wireframe_06.screen type=tabs\nview D05_wireframe_06.tabsView \"\" diagram=D05_wireframe_06 element=D05_wireframe_06.tabs parent=D05_wireframe_06.screenView\noption D05_wireframe_06.dataTab Данные order=0 owner=D05_wireframe_06.tabs selected=true value=data\noption D05_wireframe_06.helpTab Примечания order=1 owner=D05_wireframe_06.tabs value=help\nwidget D05_wireframe_06.dataPanel Данные order=427 owner=D05_wireframe_06.screen tab=D05_wireframe_06.dataTab type=tabPanel\nview D05_wireframe_06.dataPanelView \"\" diagram=D05_wireframe_06 element=D05_wireframe_06.dataPanel parent=D05_wireframe_06.screenView\nwidget D05_wireframe_06.helpPanel \"Примечания к каркасу\" order=429 owner=D05_wireframe_06.screen tab=D05_wireframe_06.helpTab type=tabPanel\nview D05_wireframe_06.helpPanelView \"\" diagram=D05_wireframe_06 element=D05_wireframe_06.helpPanel parent=D05_wireframe_06.screenView\nwidget D05_wireframe_06.helpText Описание order=431 owner=D05_wireframe_06.helpPanel text=\"Каркас SVG для переноса в Figma/OmniNotation. Значения демонстрационные. Прототип не является рабочим интерфейсом.\\nПериод: сегодня   Результат: все   Карточка: MR-000153\\nОчередь: 2   Ожидают проверки статуса: 1\" type=text\nview D05_wireframe_06.helpTextView \"\" diagram=D05_wireframe_06 element=D05_wireframe_06.helpText parent=D05_wireframe_06.helpPanelView\nwidget D05_wireframe_06.data \"Демонстрационные данные\" order=433 owner=D05_wireframe_06.dataPanel type=table\nview D05_wireframe_06.dataView \"\" diagram=D05_wireframe_06 element=D05_wireframe_06.data parent=D05_wireframe_06.dataPanelView\ntableColumn D05_wireframe_06.dataColumn0 Публикация dataType=text key=column0 order=0 owner=D05_wireframe_06.data\ntableColumn D05_wireframe_06.dataColumn1 Результат dataType=text key=column1 order=1 owner=D05_wireframe_06.data\ntableColumn D05_wireframe_06.dataColumn2 \"Повтор / причина\" dataType=text key=column2 order=2 owner=D05_wireframe_06.data\ntableColumn D05_wireframe_06.dataColumn3 \"Следующая попытка\" dataType=text key=column3 order=3 owner=D05_wireframe_06.data\ntableRow D05_wireframe_06.dataRow0 \"\" description=\"PUB-153-v5   RETRY      повтор 1/3   следующий 10:15\" order=0 owner=D05_wireframe_06.data\ntableCell D05_wireframe_06.dataRow0Cell0 \"\" column=D05_wireframe_06.dataColumn0 owner=D05_wireframe_06.dataRow0 value=PUB-153-v5\ntableCell D05_wireframe_06.dataRow0Cell1 \"\" column=D05_wireframe_06.dataColumn1 owner=D05_wireframe_06.dataRow0 value=RETRY\ntableCell D05_wireframe_06.dataRow0Cell2 \"\" column=D05_wireframe_06.dataColumn2 owner=D05_wireframe_06.dataRow0 value=\"повтор 1/3\"\ntableCell D05_wireframe_06.dataRow0Cell3 \"\" column=D05_wireframe_06.dataColumn3 owner=D05_wireframe_06.dataRow0 value=\"следующий 10:15\"\ntableRow D05_wireframe_06.dataRow1 \"\" description=\"PUB-154-v2   FAILED     обязательный атрибут отсутствует\" order=1 owner=D05_wireframe_06.data\ntableCell D05_wireframe_06.dataRow1Cell0 \"\" column=D05_wireframe_06.dataColumn0 owner=D05_wireframe_06.dataRow1 value=PUB-154-v2\ntableCell D05_wireframe_06.dataRow1Cell1 \"\" column=D05_wireframe_06.dataColumn1 owner=D05_wireframe_06.dataRow1 value=FAILED\ntableCell D05_wireframe_06.dataRow1Cell2 \"\" column=D05_wireframe_06.dataColumn2 owner=D05_wireframe_06.dataRow1 value=\"обязательный атрибут отсутствует\"\ntableCell D05_wireframe_06.dataRow1Cell3 \"\" column=D05_wireframe_06.dataColumn3 owner=D05_wireframe_06.dataRow1 value=\"\"\ntableRow D05_wireframe_06.dataRow2 \"\" description=\"PUB-152-v7   SUCCESS    внешний ID сохранён\" order=2 owner=D05_wireframe_06.data\ntableCell D05_wireframe_06.dataRow2Cell0 \"\" column=D05_wireframe_06.dataColumn0 owner=D05_wireframe_06.dataRow2 value=PUB-152-v7\ntableCell D05_wireframe_06.dataRow2Cell1 \"\" column=D05_wireframe_06.dataColumn1 owner=D05_wireframe_06.dataRow