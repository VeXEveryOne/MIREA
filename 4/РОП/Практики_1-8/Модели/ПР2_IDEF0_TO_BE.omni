ary dec_audit \"Журнал аудита и уведомления ответственным\" in=decomposition side=right direction=out parentArrow=c_audit parentEnd=from\narrow d_audit \"Журнал аудита и уведомления ответственным\" from=A5 to=dec_audit role=output\nboundary dec_roles \"Сотрудники с назначенными ролями\" in=decomposition side=bottom direction=in parentArrow=c_roles parentEnd=to\narrow d_roles \"Сотрудники с назначенными ролями\" from=dec_roles to=A1 role=mechanism\nboundary dec_system \"Единая информационная система и API\" in=decomposition side=bottom direction=in parentArrow=c_system parentEnd=to\narrow d_system \"Единая информационная система и API\" from=dec_system to=A3 role=mechanism\nboundary dec_storage \"PostgreSQL и файловое хранилище\" in=decomposition side=bottom direction=in parentArrow=c_storage parentEnd=to\narrow d_storage \"PostgreSQL и файловое хранилище\" from=dec_storage to=A4 role=mechanism\nboundary dec_adapters \"Адаптеры поставщиков и механизм правил\" in=decomposition side=bottom direction=in parentArrow=c_adapters parentEnd=to\narrow d_adapters \"Адаптеры поставщиков и механизм правил\" from=dec_adapters to=A2 role=mechanism\nboundary dec_worker \"Worker и адаптер Ozon\" in=decomposition side=bottom direction=in parentArrow=c_worker parentEnd=to\narrow d_worker \"Worker и адаптер Ozon\" from=dec_worker to=A5 role=mechanism\narrow step12 Черновик from=A1 role=input to=A2\narrow step23 Состав from=A2 role=input to=A3\narrow step34 Снимок from=A3 role=input to=A4\narrow step45 Карточка from=A4 role=input to=A5\narrow feedback_correction \"Протокол проверки с точными причинами\" from=A3 to=A2 role=control\narrow d_rules_A4 \"Версионируемые правила совместимости, выбора, цены и массы\" branchOf=d_rules from=dec_rules role=control to=A4\n",
