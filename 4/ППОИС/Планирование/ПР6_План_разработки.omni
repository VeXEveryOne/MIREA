  "source": "gantt pr6_schedule \"План разработки информационной системы\"\ncalendar weekdays \"Пятидневная неделя\" friday=true hoursPerDay=8 monday=true saturday=false sunday=false thursday=true tuesday=true wednesday=true\ncalendarException holiday \"4 ноября\" date=\"2026-11-04\" owner=weekdays working=false\nplan plan \"Разработка ИС\" calendar=weekdays mode=auto start=\"2026-10-05\"\ndiagram gantt \"План разработки\" plan=plan type=gantt\nresource resource_1 \"Backend-разработчик\" capacityHoursPerDay=8 role=\"Backend-разработчик\"\nresource resource_2 \"Frontend-разработчик\" capacityHoursPerDay=8 role=\"Frontend-разработчик\"\nresource resource_3 \"Администратор БД\" capacityHoursPerDay=8 role=\"Администратор БД\"\nresource resource_4 Аналитик capacityHoursPerDay=8 role=Аналитик\nresource resource_5 Архитектор capacityHoursPerDay=8 role=Архитектор\nresource resource_6 \"Инженер эксплуатации\" capacityHoursPerDay=8 role=\"Инженер эксплуатации\"\nresource resource_7 \"Руководитель проекта\" capacityHoursPerDay=8 role=\"Руководитель проекта\"\nresource resource_8 Тестировщик capacityHoursPerDay=8 role=Тестировщик\ntask stage_1 \"Уточнение требований\" kind=summary order=1 wbsCode=1\nview v_stage_1 \"\" diagram=gantt element=stage_1\ntask task_1_1 \"Обследовать процесс\" duration=2 effortHours=16 kind=task order=1 parent=stage_1 progress=0 wbsCode=1.1\nview v_task_1_1 \"\" diagram=gantt element=task_1_1\nassignment task_1_1_resource_4 \"\" effortHours=16 resource=resource_4 task=task_1_1\ntask task_1_2 \"Согласовать требования\" duration=3 effortHours=40 kind=task order=2 parent=stage_1 progress=0 wbsCode=1.2\nview v_task_1_2 \"\" diagram=gantt element=task_1_2\nassignment task_1_2_resource_4 \"\" effortHours=24 resource=resource_4 task=task_1_2\nassignment task_1_2_resource_7 \"\" effortHours=16 resource=resource_7 task=task_1_2\ntask stage_2 \"Модели и архитектура\" kind=summary order=2 wbsCode=2\nview v_stage_2 \"\" diagram=gantt element=stage_2\ntask task_2_