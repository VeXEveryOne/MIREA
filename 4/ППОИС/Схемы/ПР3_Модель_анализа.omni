  "source": "uml ppois3 \"ППОИС 3 — Модель анализа ИС ООО «Юкомс»\"\ninteraction bom \"UC02 — Формирование версии BOM\"\ninteraction pub \"UC05 — Публикация карточки товара\"\ndiagram use \"1. Варианты использования\" type=usecase\ndiagram classes \"2. Классы анализа\" type=class\ndiagram bom_seq \"3. Последовательность UC02\" interaction=bom type=sequence\ndiagram pub_seq \"4. Последовательность UC05\" interaction=pub type=sequence\ndiagram comm \"5. Кооперация UC05\" interaction=pub scenario=ready_card type=communication\nactor manager \"Менеджер маркетплейсов\"\nview v_use_manager \"\" diagram=use element=manager\nactor specialist \"Технический специалист\"\nview v_use_specialist \"\" diagram=use element=specialist\nactor ozon Ozon\nview v_use_ozon \"\" diagram=use element=ozon\nactor suppliers \"PC4Games / ITPartner\"\nview v_use_suppliers \"\" diagram=use element=suppliers\nactor designer Дизайнер\nview v_use_designer \"\" diagram=use element=designer\nactor admin Администратор\nview v_use_admin \"\" diagram=use element=admin\nsystem system \"ИС формирования и актуализации карточек ООО «Юкомс»\"\nview v_use_system \"\" diagram=use element=system\nusecase UC01 \"UC01 — Зарегистрировать запрос\"\nsubject subject_UC01 \"\" owner=UC01 system=system\nview v_use_UC01 \"\" diagram=use element=UC01 parent=v_use_system\nusecase UC02 \"UC02 — Сформировать BOM\" interaction=bom\nsubject subject_UC02 \"\" owner=UC02 system=system\nview v_use_UC02 \"\" diagram=use element=UC02 parent=v_use_system\nusecase UC03 \"UC03 — Проверить совместимость\"\nsubject subject_UC03 \"\" owner=UC03 system=system\nview v_use_UC03 \"\" diagram=use element=UC03 parent=v_use_system\nusecase UC04 \"UC04 — Массово заменить компонент\"\nsubject subject_UC04 \"\" owner=UC04 system=system\nview v_use_UC04 \"\" diagram=use element=UC04 parent=v_use_system\nusecase UC05 \"UC05 — Опубликовать карточку\" interaction=pub\nsubject subject_UC05 \"\" owner=UC05 system=system\nview v_use_UC05 \"\" diagram=use element=UC05 parent=v_use_system\nusecase UC06 \"UC06 — Обновить предложения поставщиков\"\nsubject subject_UC06 \"\" owner=UC06 system=system\nview v_use_UC06 \"\" diagram=use element=UC06 parent=v_use_system\nusecase UC07 \"UC07 — Рассчитать цену, вес и подготовить контент\"\nsubject subject_UC07 \"\" owner=UC07 system=system\nview v_use_UC07 \"\" diagram=use element=UC07 parent=v_use_system\nusecase UC08 \"UC08 — Проверить готовность карточки\"\nsubject subject_UC08 \"\" owner=UC08 system=system\nview v_use_UC08 \"\" diagram=use element=UC08 parent=v_use_system\nusecase UC09 \"UC09 — Настроить шаблоны изображений\"\nsubject subject_UC09 \"\" owner=UC09 system=system\nview v_use_UC09 \"\" diagram=use element=UC09 parent=v_use_system\nusecase UC10 \"UC10 — Настроить доступ и интеграции\"\nsubject subject_UC10 \"\" owner=UC10 system=system\nview v_use_UC10 \"\" diagram=use element=UC10 parent=v_use_system\nparticipation manager_UC01 \"\" from=manager to=UC01\nview v_use_manager_UC01 \"\" diagram=use element=manager_UC01\nparticipation manager_UC05 \"\" from=manager to=UC05\nview v_use_manager_UC05 \"\" diagram=use element=manager_UC05\nparticipation manager_UC06 \"\" from=manager to=UC06\nview v_use_manager_UC06 \"\" diagram=use element=manager_UC06\nparticipation specialist_UC02 \"\" from=specialist to=UC02\nview v_use_specialist_UC02 \"\" diagram=use element=specialist_UC02\nparticipation specialist_UC03 \"\" from=specialist to=UC03\nview v_use_specialist_UC03 \"\" diagram=use element=specialist_UC03\nparticipation specialist_UC04 \"\" from=specialist to=UC04\nview v_use_specialist_UC04 \"\" diagram=use element=specialist_UC04\nparticipation designer_UC07 \"\" from=designer to=UC07\nview v_use_designer_UC07 \"\" diagram=use element=designer_UC07\nparticipation designer_UC09 \"\" from=designer to=UC09\nview v_use_designer_UC09 \"\" diagram=use element=designer_UC09\nparticipation admin_UC10 \"\" from=admin to=UC10\nview v_use_admin_UC10 \"\" diagram=use element=a