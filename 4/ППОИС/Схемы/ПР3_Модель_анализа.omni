  "source": "uml ppois3 \"Модель анализа ИС ООО «Юкомс»\"\ndiagram use \"Варианты использования\" type=usecase\nsystem system \"ИС карточек ООО «Юкомс»\"\nview v_use_system \"\" diagram=use element=system\nactor manager Менеджер\nview v_use_manager \"\" diagram=use element=manager\nusecase UC01 \"UC01 Подготовить карточку\"\nsubject subject_UC01 \"\" owner=UC01 system=system\nview v_use_UC01 \"\" diagram=use element=UC01 parent=v_use_system\nparticipation manager_UC01 \"\" from=manager to=UC01\nview v_use_manager_UC01 \"\" diagram=use element=manager_UC01 from=v_use_manager to=v_use_UC01\nusecase UC02 \"UC02 Опубликовать карточку\"\nsubject subject_UC02 \"\" owner=UC02 system=system\nview v_use_UC02 \"\" diagram=use element=UC02 parent=v_use_system\nparticipation manager_UC02 \"\" from=manager to=UC02\nview v_use_manager_UC02 \"\" diagram=use element=manager_UC02 from=v_use_manager to=v_use_UC02\nactor director \"Генеральный директор\"\nview v_use_director \"\" diagram=use element=director\nusecase UC03 \"UC03 Проверить цену и состав\"\nsubject subject_UC03 \"\" owner=UC03 system=system\nview v_use_UC03 \"\" diagram=use element=UC03 parent=v_use_system\nparticipation director_UC03 \"\" from=director to=UC03\nview v_use_director_UC03 \"\" diagram=use element=director_UC03 from=v_use_director to=v_use_UC03\nusecase UC04 \"UC04 Утвердить ревизию\"\nsubject subject_UC04 \"\" owner=UC04 system=system\nview v_use_UC04 \"\" diagram=use element=UC04 parent=v_use_system\nparticipation director_UC04 \"\" from=director to=UC04\nview v_use_director_UC04 \"\" diagram=use element=director_UC04 from=v_use_director to=v_use_UC04\nactor developer Разработчик\nview v_use_developer \"\" diagram=use element=developer\nusecase UC05 \"UC05 Сформировать состав\"\nsubject subject_UC05 \"\" owner=UC05 system=system\nview v_use_UC05 \"\" diagram=use element=UC05 parent=v_use_system\nparticipation developer_UC05 \"\" from=developer to=UC05\nview v_use_developer_UC05 \"\" diagram=use element=developer_UC05 from=v_use_developer to=v_use_UC05\nusecase UC06 \"UC06 Сохранить версию состава\"\nsubject subject_UC06 \"\" owner=UC06 system=system\nview v_use_UC06 \"\" diagram=use element=UC06 parent=v_use_system\nparticipation developer_UC06 \"\" from=developer to=UC06\nview v_use_developer_UC06 \"\" diagram=use element=developer_UC06 from=v_use_developer to=v_use_UC06\nactor designer Дизайнер\nview v_use_designer \"\" diagram=use element=designer\nusecase UC07 \"UC07 Подготовить изображения\"\nsubject subject_UC07 \"\" owner=UC07 system=system\nview v_use_UC07 \"\" diagram=use element=UC07 parent=v_use_system\nparticipation designer_UC07 \"\" from=designer to=UC07\nview v_use_designer_UC07 \"\" diagram=use element=designer_UC07 from=v_use_designer to=v_use_UC07\nusecase UC08 \"UC08 Оформить ревизию\"\nsubject subject_UC08 \"\" owner=UC08 system=system\nview v_use_UC08 \"\" diagram=use element=UC08 parent=v_use_system\nparticipation designer_UC08 \"\" from=designer to=UC08\nview v_use_designer_UC08 \"\" diagram=use element=designer_UC08 from=v_use_designer to=v_use_UC08\nactor ozon Ozon\nview v_use_ozon \"\" diagram=use element=ozon\nparticipation ozon_UC02 \"\" from=ozon to=UC02\nview v_use_ozon_UC02 \"\" diagram=use element=ozon_UC02 from=v_use_ozon to=v_use_UC02\ndiagram analysis \"Классы анализа\" type=class\nclass FormRange \"Форма состава\" role=boundary\nview v_analysis_FormRange \"\" compartments=name diagram=analysis element=FormRange\nclass ControlRange \"Управление составом\" role=control\nview v_analysis_ControlRange \"\" compartments=name diagram=analysis element=ControlRange\nclass Version \"Версия состава\" role=entity\nview v_analysis_Version \"\" compartments=name diagram=analysis element=Version\nclass Slot \"Позиция состава\" role=entity\nview v_analysis_Slot \"\" compartments=name diagram=analysis element=Slot\nclass FormCard \"Форма карточки\" role=boundary\nview v_analysis_FormCard \"\" compartments=name diagram=analysis element=FormCard\nclass ControlCard \"Подготовка карточки\" role=control\nview v_analysis_ControlCard \"\" compartments=name diagram=analysis element=ControlCard\nclass Revision \"Ревизия карточки\" role=entity\nview v_analysis_Revision \"\" compartments=name diagram=analysis element=Revision\nclass Card Карточка role=entity\nview v_analysis_Card \"\" compartments=name diagram=analysis element=Card\nclass FormApproval \"Форма согласования\" role=boundary\nview v_analysis_FormApproval \"\" compartments=name diagram=analysis element=FormApproval\nclass ControlApproval \"Проверка готовности\" role=control\nview v_analysis_ControlApproval \"\" compartments=name diagram=analysis element=ControlApproval\nclass Image Изображение role=entity\nview v_analysis_Image \"\" compartments=name diagram=analysis element=Image\nclass Attempt \"Попытка публикации\" role=entity\nview v_analysis_Attempt \"\" compartments=name diagram=analysis element=Attempt\nassociation a_FormRange_ControlRange \"\"\nend a_FormRange_ControlRange_a \"\" classifier=FormRange lower=1 order=0 owner=a_FormRange_ControlRange upper=1\nend a_FormRange_ControlRange_b \"\" classifier=ControlRange lower=1 order=1 owner=a_FormRange_ControlRange upper=1\nview v_analysis_a_FormRange_ControlRange \"\" diagram=analysis element=a_FormRange_ControlRange from=v_analysis_FormRange to=v_analysis_ControlRange\nassociation a_ControlRange_Version \"\"\nend a_ControlRange_Version_a \"\" classifier=ControlRange lower=1 order=0 owner=a_ControlRange_Version upper=1\nend a_ControlRange_Version_b \"\" classifier=Version lower=1 order=1 owner=a_ControlRange_Version upper=1\nview v_analysis_a_ControlRange_Version \"\" diagram=analysis element=a_ControlRange_Version from=v_analysis_ControlRange to=v_analysis_Version\nassociation a_FormCard_ControlCard \"\"\nend a_FormCard_ControlCard_a \"\" classifier=FormCard lower=1 order=0 owner=a_FormCard_ControlCard upper=1\nend a_FormCard_ControlCard_b \"\" classifier=ControlCard lower=1 order=1 owner=a_FormCard_ControlCard upper=1\nview v_analysis_a_FormCard_ControlCard \"\" diagram=analysis element=a_FormCard_ControlCard from=v_analysis_FormCard to=v_analysis_ControlCard\nassociation a_ControlCard_Revision \"\"\nend a_ControlCard_Revision_a \"\" classifier=ControlCard lower=1 order=0 owner=a_ControlCard_Revision upper=1\nend a_ControlCard_Revision_b \"\" classifier=Revision lower=1 order=1 owner=a_ControlCard_Revision upper=1\nview v_analysis_a_ControlCard_Revision \"\" diagram=analysis element=a_ControlCard_Revision from=v_analysis_ControlCard to=v_analysis_Revision\nassociation a_FormApproval_ControlApproval \"\"\nend a_FormApproval_ControlApproval_a \"\" classifier=FormApproval lower=1 order=0 owner=a_FormApproval_ControlApproval upper=1\nend a_FormApproval_ControlApproval_b \"\" classifier=ControlApproval lower=1 order=1 owner=a_FormApproval_ControlApproval upper=1\nview v_analysis_a_FormApproval_ControlApproval \"\" diagram=analysis element=a_FormApproval_ControlApproval from=v_analysis_FormApproval to=v_analysis_ControlApproval\nassociation a_ControlApproval_Revision \"\"\nend a_ControlApproval_Revision_a \"\" classifier=ControlApproval lower=1 order=0 owner=a_ControlApproval_Revision upper=1\nend a_ControlApproval_Revision_b \"\" classifier=Revision lower=1 order=1 owner=a_ControlApproval_Revision upper=1\nview v_analysis_a_ControlApproval_Revision \"\" diagram=analysis element=a_ControlApproval_Revision from=v_analysis_ControlApproval to=v_analysis_Revision\nassociation a_Version_Slot \"\"\nend a_Version_Slot_a \"\" classifier=Version lower=1 order=0 owner=a_Version_Slot upper=1\nend a_Version_Slot_b \"\" classifier=Slot lower=0 order=1 owner=a_Version_Slot upper=\"*\"\nview v_analysis_a_Version_Slot \"\" diagram=analysis element=a_Version_Slot from=v_analysis_Version to=v_analysis_Slot\nassociation a_Card_Revision \"\"\nend a_Card_Revision_a \"\" classifier=Card lower=1 order=0 owner=a_Card_Revision upper=1\nend a_Card_Revision_b \"\" classifier=Revision lower=0 order=1 owner=a_Card_Revision upper=\"*\"\nview v_analysis_a_Card_Revision \"\" diagram=analysis element=a_Card_Revision from=v_analysis_Card to=v_analysis_Revision\nassociation a_Revision_Version \"\"\nend a_Revision_Version_a \"\" classifier=Revision lower=1 order=0 owner=a_Revision_Version upper=1\nend a_Revision_Version_b \"\" classifier=Version lower=1 order=1 owner=a_Revision_Version upper=1\nview v_analysis_a_Revision_Version \"\" diagram=analysis element=a_Revision_Version from=v_analysis_Revision to=v_analysis_Version\nassociation a_Revision_Image \"\"\nend a_Revision_Image_a \"\" classifier=Revision lower=0 order=0 owner=a_Revision_Image upper=\"*\"\nend a_Revision_Image_b \"\" classifier=Image lower=0 order=1 owner=a_Revision_Image upper=\"*\"\nview v_analysis_a_Revision_Image \"\" diagram=analysis element=a_Revision_Image from=v_analysis_Revision to=v_analysis_Image\nassociation a_Revision_Attempt \"\"\nend a_Revision_Attempt_a \"\" classifier=Revision lower=1 order=0 owner=a_Revision_Attempt upper=1\nend a_Revision_Attempt_b \"\" classifier=Attempt lower=0 order=1 owner=a_Revision_Attempt upper=\"*\"\nview v_analysis_a_Revision_Attempt \"\" diagram=analysis element=a_Revision_Attempt from=v_analysis_Revision to=v_analysis_Attempt\ninteraction range \" \"\ndiagram seq_range \"Сохранение версии состава\" interaction=range type=sequence\nlifeline range_lane0 u classifier=developer owner=range\nview v_seq_range_range_lane0 \"\" diagram=seq_range element=range_lane0\nlifeline range_lane1 f classifier=FormRange owner=range\nview v_seq_range_range_lane1 \"\" diagram=seq_range element=range_lane1\nlifeline range_lane2 c classifier=ControlRange owner=range\nview v_seq_range_range_lane2 \"\" diagram=seq_range element=range_lane2\nlifeline range_lane3 v classifier=Version owner=range\nview v_seq_range_range_lane3 \"\" diagram=seq_range element=range_lane3\noccurrence range_m1_send \"\" lifeline=range_lane0 order=0 owner=range\noccurrence range_m1_receive \"\" lifel