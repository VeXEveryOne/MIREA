  "source": "uml ppois3 \"ППОИС 3 — Модель анализа ИС ООО «Юкомс»\"\ninteraction model_range \"UC02 — Формирование версии модельного ряда\"\ninteraction pub \"UC05 — Публикация карточки товара\"\ndiagram use \"1. Варианты использования\" type=usecase\ndiagram model_range_seq \"3. Последовательность UC02\" interaction=model_range type=sequence\ndiagram pub_seq \"4. Последовательность UC05\" interaction=pub type=sequence\ndiagram comm \"5. Кооперация UC05\" interaction=pub scenario=ready_card type=communication\nactor manager \"Менеджер маркетплейсов\"\nview v_use_manager \"\" diagram=use element=manager\nactor specialist \"Технический специалист\"\nview v_use_specialist \"\" diagram=use element=specialist\nactor ozon Ozon\nview v_use_ozon \"\" diagram=use element=ozon\nactor suppliers \"PC4Games / ITPartner\"\nview v_use_suppliers \"\" diagram=use element=suppliers\nactor designer Дизайнер\nview v_use_designer \"\" diagram=use element=designer\nactor admin Администратор\nview v_use_admin \"\" diagram=use element=admin\nsystem system \"ИС формирования и актуализации карточек ООО «Юкомс»\"\nview v_use_system \"\" diagram=use element=system\nusecase UC01 \"UC01 — Зарегистрировать запрос\"\nsubject subject_UC01 \"\" owner=UC01 system=system\nview v_use_UC01 \"\" diagram=use element=UC01 parent=v_use_system\nusecase UC02 \"UC02 — Сформировать модельный ряд\" interaction=model_range\nsubject subject_UC02 \"\" owner=UC02 system=system\nview v_use_UC02 \"\" diagram=use element=UC02 parent=v_use_system\nusecase UC03 \"UC03 — Проверить совместимость\"\nsubject subject_UC03 \"\" owner=UC03 system=system\nview v_use_UC03 \"\" diagram=use element=UC03 parent=v_use_system\nusecase UC04 \"UC04 — Массово заменить компонент\"\nsubject subject_UC04 \"\" owner=UC04 system=system\nview v_use_UC04 \"\" diagram=use element=UC04 parent=v_use_system\nusecase UC05 \"UC05 — Опубликовать карточку\" interaction=pub\nsubject subject_UC05 \"\" owner=UC05 system=system\nview v_use_UC05 \"\" diagram=use element=UC05 parent=v_use_system\nusecase UC06 \"UC06 — Обновить предложения поставщиков\"\nsubject subject_UC06 \"\" owner=UC06 system=system\nview v_use_UC06 \"\" diagram=use element=UC06 parent=v_use_system\nusecase UC07 \"UC07 — Рассчитать цену, вес и подготовить контент\"\nsubject subject_UC07 \"\" owner=UC07 system=system\nview v_use_UC07 \"\" diagram=use element=UC07 parent=v_use_system\nusecase UC08 \"UC08 — Проверить готовность карточки\"\nsubject subject_UC08 \"\" owner=UC08 system=system\nview v_use_UC08 \"\" diagram=use element=UC08 parent=v_use_system\nusecase UC09 \"UC09 — Настроить шаблоны изображений\"\nsubject subject_UC09 \"\" owner=UC09 system=system\nview v_use_UC09 \"\" diagram=use element=UC09 parent=v_use_system\nusecase UC10 \"UC10 — Настроить доступ и интеграции\"\nsubject subject_UC10 \"\" owner=UC10 system=system\nview v_use_UC10 \"\" diagram=use element=UC10 parent=v_use_system\nparticipation manager_UC01 \"\" from=manager to=UC01\nview v_use_manager_UC01 \"\" diagram=use element=manager_UC01 from=v_use_manager to=v_use_UC01\nparticipation manager_UC05 \"\" from=manager to=UC05\nview v_use_manager_UC05 \"\" diagram=use element=manager_UC05 from=v_use_manager_publish to=v_use_UC05\nparticipation manager_UC06 \"\" from=manager to=UC06\nview v_use_manager_UC06 \"\" diagram=use element=manager_UC06 from=v_use_manager_supply to=v_use_UC06\nparticipation specialist_UC02 \"\" from=specialist to=UC02\nview v_use_specialist_UC02 \"\" diagram=use element=specialist_UC02 from=v_use_specialist to=v_use_UC02\nparticipation specialist_UC03 \"\" from=specialist to=UC03\nview v_use_specialist_UC03 \"\" diagram=use element=specialist_UC03 from=v_use_specialist to=v_use_UC03\nparticipation specialist_UC04 \"\" from=specialist to=UC04\nview v_use_specialist_UC04 \"\" diagram=use element=specialist_UC04 from=v_use_specialist to=v_use_UC04\nparticipation designer_UC07 \"\" from=designer to=UC07\nview v_use_designer_UC07 \"\" diagram=use element=designer_UC07 from=v_use_designer to=v_use_UC07\nparticipation designer_UC09 \"\" from=designer to=UC09\nview v_use_designer_UC09 \"\" diagram=use element=designer_UC09 from=v_use_designer to=v_use_UC09\nparticipation admin_UC10 \"\" from=admin to=UC10\nview v_use_admin_UC10 \"\" diagram=use element=admin_UC10 from=v_use_admin to=v_use_UC10\nparticipation suppliers_UC06 \"\" from=suppliers to=UC06\nview v_use_suppliers_UC06 \"\" diagram=use element=suppliers_UC06 from=v_use_suppliers to=v_use_UC06\nparticipation ozon_UC05 \"\" from=ozon to=UC05\nview v_use_ozon_UC05 \"\" diagram=use element=ozon_UC05 from=v_use_ozon_publish to=v_use_UC05\ninclude UC02_UC03 \"\" from=UC02 to=UC03\nview v_use_UC02_UC03 \"\" diagram=use element=UC02_UC03 from=v_use_UC02 to=v_use_UC03\ninclude UC04_UC03 \"\" from=UC04 to=UC03\nview v_use_UC04_UC03 \"\" diagram=use element=UC04_UC03 from=v_use_UC04 to=v_use_UC03\ninclude UC05_UC08 \"\" from=UC05 to=UC08\nview v_use_UC05_UC08 \"\" diagram=use element=UC05_UC08 from=v_use_UC05 to=v_use_UC08\nclass ModelRangeForm \"Форма модельного ряда\" role=boundary\noperation ModelRangeForm_f0 ввестиСлоты order=1 owner=ModelRangeForm visibility=public\noperation ModelRangeForm_f1 показатьРезультат order=2 owner=ModelRangeForm visibility=public\nclass ModelRangeController \"Контроллер модельного ряда\" role=control\noperation ModelRangeController_f0 сформироватьВерсию order=1 owner=ModelRangeController visibility=public\noperation ModelRangeController_f1 проверитьСовместимость order=2 owner=ModelRangeController visibility=public\nclass Rule \"Правило совместимости\" role=entity\nattribute Rule_f0 тип order=1 owner=Rule visibility=private\nattribute Rule_f1 условие order=2 owner=Rule visibility=private\noperation Rule_f2 получитьПравила order=3 owner=Rule visibility=public\nclass Version \"Версия модельного ряда\" role=entity\nattribute Version_f0 номер order=1 owner=Version visibility=private\nattribute Version_f1 статус order=2 owner=Version visibility=private\noperation Version_f2 создать order=3 owner=Version visibility=public\nclass Offer \"Предложение поставщика\" role=entity\nattribute Offer_f0 модель order=1 owner=Offer visibility=private\nattribute Offer_f1 цена order=2 owner=Offer visibility=private\nattribute Offer_f2 наличие order=3 owner=Offer visibility=private\noperation Offer_f3 получитьАктуальные order=4 owner=Offer visibility=public\nclass Slot \"Позиция модельного ряда\" role=entity\nattribute Slot_f0 тип order=1 owner=Slot visibility=private\nattribute Slot_f1 \"группа или модель\" order=2 owner=Slot visibility=private\nattribute Slot_f2 количество order=3 owner=Slot visibility=private\nclass FormCard \"Форма карточки\" role=boundary\noperation FormCard_f0 запроситьПубликацию order=1 owner=FormCard visibility=public\noperation FormCard_f1 показатьСтатус order=2 owner=FormCard visibility=public\nclass PubController \"Контроллер публикации\" role=control\noperation PubController_f0 проверитьГотовность order=1 owner=PubController visibility=public\noperation PubController_f1 опубликовать order=2 owner=PubController visibility=public\nclass Card \"Карточка товара\" role=entity\nattribute Card_f0 атрибуты order=1 owner=Card visibility=private\nattribute Card_f1 цена order=2 owner=Card visibility=private\nattribute Card_f2 версия order=3 owner=Card visibility=private\noperation Card_f3 получитьСнимок order=4 owner=Card visibility=public\noperation Card_f4 задатьСтатус order=5 owner=Card visibility=public\nclass Adapter \"Адаптер Ozon\" role=boundary\noperation Adapter_f0 отправитьКарточку order=1 owner=Adapter visibility=public\noperation Adapter_f1 получитьРезультат order=2 owner=Adapter visibility=public\nclass Publication Публикация role=entity\nattribute Publication_f0 запрос order=1 owner=Publication visibility=private\nattribute Publication_f1 ответ order=2 owner=Publication visibility=private\nattribute Publication_f2 время order=3 owner=Publication visibility=private\nattribute Publication_f3 статус order=4 owner=Publication visibility=private\noperation Publication_f4 создать order=5 owner=Publication visibility=public\noperation Publication_f5 сохранитьРезультат order=6 owner=Publication visibility=public\nassociation dep_ModelRangeForm_ModelRangeController \"\"\nassociation dep_ModelRangeController_Rule \"\"\nassociation dep_ModelRangeController_Version \"\"\nassociation dep_ModelRangeController_Offer \"\"\nassociation dep_FormCard_PubController \"\"\nassociation dep_PubController_Card \"\"\nassociation dep_PubController_Adapter \"\"\nassociation dep_PubController_Publication \"\"\nassociation version_slots \"\"\nend version_slots_a \"\" classifier=Version lower=1 order=1 owner=version_slots upper=1\nend version_slots_b \"\" classifier=Slot lower=1 order=0 owner=version_slots upper=\"*\"\nassociation slot_offer \"\"\nend slot_offer_a \"\" classifier=Slot lower=0 order=0 owner=slot_offer upper=\"*\"\nend slot_offer_b \"\" classifier=Offer lower=0 order=1 owner=slot_offer upper=1\nassociation card_version \"\"\nend card_version_a \"\" classifier=Card lower=0 order=1 owner=card_version upper=\"*\"\nend card_version_b \"\" classifier=Version lower=1 order=0 owner=card_version upper=1\nassociation card_publications \"\"\nend card_publications_a \"\" classifier=Card lower=1 order=0 owner=card_publications upper=1\nend card_publications_b \"\" classifier=Publication lower=0 order=1 owner=card_publications upper=\"*\"\nlifeline model_range_lane0 u classifier=specialist owner=model_range\nview v_model_range_seq_model_range_lane0 \"\" diagram=model_range_seq element=model_range_lane0\nlifeline model_range_lane1 f classifier=ModelRangeForm owner=model_range\nview v_model_range_seq_model_range_lane1 \"\" diagram=model_range_seq element=model_range_lane1\nlifeline model_range_lane2 c classifier=ModelRangeController owner=model_range\nview v_model_range_seq_model_range_lane2 \"\" diagram=model_range_seq element=model_range_lane2\nlifeline model_range_lane3 d classifier=Rule