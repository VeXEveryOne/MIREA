  "source": "flowchart pr8_algorithms \"Алгоритмы обработки\"\nalgorithm selection_algorithm \"Подбор предложений\"\ndiagram selection \"Подбор предложений\" algorithm=selection_algorithm type=algorithm\nstart selection_start Начало owner=selection_algorithm\nview v_selection_start \"\" diagram=selection element=selection_start\ninput selection_input \"Позиции, компоненты,\\nпредложения и момент t\" owner=selection_algorithm\nview v_selection_input \"\" diagram=selection element=selection_input\ndecision selection_valid \"n ≥ 1, qᵢ — целые\\nи qᵢ > 0?\" expression=\"n ≥ 1, qᵢ — целые\\nи qᵢ > 0?\" mode=binary owner=selection_algorithm\nview v_selection_valid \"\" diagram=selection element=selection_valid\noperation selection_init \"i = 1; список пуст\" owner=selection_algorithm\nview v_selection_init \"\" diagram=selection element=selection_init\ndecision selection_loop \"i ≤ n?\" expression=\"i ≤ n?\" mode=binary owner=selection_algorithm\nview v_selection_loop \"\" diagram=selection element=selection_loop\noperation selection_filter \"Предложения позиции i:\\nостаток ≥ qᵢ; возраст ≤ 24 ч;\\nдата наблюдения ≤ t\" owner=selection_algorithm\nview v_selection_filter \"\" diagram=selection element=selection_filter\ndecision selection_found \"Есть допустимое\\nпредложение?\" expression=\"Есть допустимое\\nпредложение?\" mode=binary owner=selection_algorithm\nview v_selection_found \"\" diagram=selection element=selection_found\noperation selection_pick \"Выбрать минимум по цене,\\nкоду поставщика, ID\" owner=selection_algorithm\nview v_selection_pick \"\" diagram=selection element=selection_pick\noperation selection_next \"Добавить предложение;\\ni = i + 1\" owner=selection_algorithm\nview v_selection_next \"\" diagram=selection element=selection_next\noutput selection_error \"Ошибка входных данных /\\nнет допустимого\\nпредложения\" owner=selection_algorithm\nview v_selection_error \"\" diagram=selection element=selection_error\nend selection_fail Конец owner=selection_algorithm\nview v_selection_fail \"\" diagram=selection element=selection_fail\noutput selection_result \"Выбранные предложения\\nдля всех позиций\" owner=selection_algorithm\nview v_selection_result \"\" diagram=selection element=selection_result\nend selection_end Конец owner=selection_algorithm\nview v_selection_end \"\" diagram=selection element=selection_end\nflow selection_edge_412 \"\" from=selection_start to=selection_input\nview v_selection_edge_412 \"\" diagram=selection element=selection_edge_412 from=v_selection_start to=v_selection_input\nflow selection_edge_413 \"\" from=selection_input to=selection_valid\nview v_selection_edge_413 \"\" diagram=selection element=selection_edge_413 from=v_selection_input to=v_selection_valid\nflow selection_edge_414 Да from=selection_valid to=selection_init\nview v_selection_edge_414 \"\" diagram=selection element=selection_edge_414 from=v_selection_valid to=v_selection_init\nflow selection_edge_415 Нет from=selection_valid to=selection_error\nview v_selection_edge_415 \"\" diagram=selection element=selection_edge_415 from=v_selection_valid to=v_selection_error\nflow selection_edge_416 \"\" from=selection_init to=selection_loop\nview v_selection_edge_416 \"\" diagram=selection element=selection_edge_416 from=v_selection_init to=v_selection_loop\nflow selection_edge_417 Да from=selection_loop to=selection_filter\nview v_selection_edge_417 \"\" diagram=selection element=selection_edge_417 from=v_selection_loop to=v_selection_filter\nflow selection_edge_418 Нет from=selection_loop to=selection_result\nview v_selection_edge_418 \"\" diagram=selection element=selection_edge_418 from=v_selection_loop to=v_selection_result\nflow selection_edge_419 \"\" from=selection_filter to=selection_found\nview v_selection_edge_419 \"\" diagram=selection element=selection_edge_419 from=v_selection_filter to=v_selection_found\nflow selection_edge_420 Да from=selection_found to=selection_pick\nview v_selection_edge_420 \"\" diagram=selection element=selection_edge_420 from=v_selection_found to=v_selection_pick\nflow selection_edge_421 Нет from=selection_found to=selection_error\nview v_selection_edge_421 \"\" diagram=selection element=selection_edge_421 from=v_selection_found to=v_selection_error\nflow selection_edge_422 \"\" from=selection_pick to=selection_next\nview v_selection_edge_422 \"\" diagram=selection element=selection_edge_422 from=v_selection_pick to=v_selection_next\nflow selection_edge_423 \"\" from=selection_next to=selection_loop\nview v_selection_edge_423 \"\" diagram=selection element=selection_edge_423 from=v_selection_next to=v_selection_loop\nflow selection_edge_424 \"\" from=selection_error to=selection_fail\nview v_selection_edge_424 \"\" diagram=selection element=selection_edge_424 from=v_selection_error to=v_selection_fail\nflow selection_edge_425 \"\" from=selection_result to=selection_end\nview v_selection_edge_425 \"\" diagram=selection element=selection_edge_425 from=v_selection_result to=v_selection_end\nalgorithm calculation_algorithm \"Проверка и расчёт\"\ndiagram calculation \"Проверка и расчёт\" algorithm=calculation_algorithm type=algorithm\nstart calculation_start Начало owner=calculation_algorithm\nview v_calculation_start \"\" diagram=calculation element=calculation_start\ninput calculation_input \"Выбранный состав,\\nпараметры цены и массы\" owner=calculation_algorithm\nview v_calculation_input \"\" diagram=calculation element=calculation_input\ndecision calculation_valid \"Параметры допустимы,\\nсостав совместим?\" expression=\"Параметры допустимы,\\nсостав совместим?\" mode=binary owner=calculation_algorithm\nview v_calculation_valid \"\" diagram=calculation element=calculation_valid\noperation calculation_cost \"Cкомп = ∑ qᵢ · pᵢ\\nC = Cкомп + A + B\" owner=calculation_algorithm\nview v_calculation_cost \"\" diagram=calculation element=calculation_cost\noperation calculation_price \"P₀ = (C · (1 + m) + L)\\n/ (1 − c)\" owner=calculation_algorithm\nview v_calculation_price \"\" diagram=calculation element=calculation_price\noperation calculation_round \"P = d · ceil(P₀ / d)\" owner=calculation_algorithm\nview v_calculation_round \"\" diagram=calculation element=calculation_round\noperation calculation_mass \"W = ∑ qᵢ · wᵢ + b\" owner=calculation_algorithm\nview v_calculation_mass \"\" diagram=calculation element=calculation_mass\noutput calculation_output \"Себестоимость,\\nитоговая цена и масса\" owner=calculation_algorithm\nview v_calculation_output \"\" diagram=calculation element=calculation_output\nend calculation_end Конец owner=calculation_algorithm\nview v_calculation_end \"\" diagram=calculation element=calculation_end\noutput calculation_error \"Ошибки параметров\\nили совместимости\" owner=calculation_algorithm\nview v_calculation_error \"\" diagram=calculation element=calculation_error\nend calculation_fail Конец owner=calculation_algorithm\nview v_calculation_fail \"\" diagram=calculation element=calculation_fail\nflow calculation_edge_426 \"\" from=calculation_start to=calculation_input\nview v_calculation_edge_426 \"\" diagram=calculation element=calculation_edge_426 from=v_calculation_start to=v_calculation_input\nflow calculation_edge_427 \"\" from=calculation_input to=calculation_valid\nview v_calculation_edge_427 \"\" diagram=calculation element=calculation_edge_427 from=v_calculation_input to=v_calculation_valid\nflow calculation_edge_428 \"\" from=calculation_cost to=calculation_price\nview v_calculation_edge_428 \"\" diagram=calculation element=calculation_edge_428 from=v_calculation_cost to=v_calculation_price\nflow calculation_edge_429 \"\" from=calculation_price to=calculation_round\nview v_calculation_edge_429 \"\" diagram=calculation element=calculation_edge_429 from=v_calculation_price to=v_calculation_round\nflow calculation_edge_430 \"\" from=calculation_round to=calculation_mass\nview v_calculation_edge_430 \"\" diagram=calculation element=calculation_edge_430 from=v_calculation_round to=v_calculation_mass\nflow calculation_edge_431 \"\" from=calculation_mass to=calculation_output\nview v_calculation_edge_431 \"\" diagram=calculation element=calculation_edge_431 from=v_calculation_mass to=v_calculation_output\nflow calculation_edge_432 \"\" from=calculation_output to=calculation_end\nview v_calculation_edge_432 \"\" diagram=calculation element=calculation_edge_432 from=v_calculation_output to=v_calculation_end\nflow calculation_edge_433 \"\" from=calculation_error to=calculation_fail\nview v_calculation_edge_433 \"\" diagram=calculation element=calculation_edge_433 from=v_calculation_error to=v_calculation_fail\nflow calculation_edge_434 Да from=calculation_valid to=calculation_cost\nview v_calculation_edge_434 \"\" diagram=calculation element=calculation_edge_434 from=v_calculation_valid to=v_calculation_cost\nflow calculation_edge_435 Нет from=calculation_valid to=calculation_error\nview v_calculation_edge_435 \"\" diagram=calculation element=calculation_edge_435 from=v_calculation_valid to=v_calculation_error\n",
