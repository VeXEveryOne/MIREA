  "source": "scheme pr10_client \"Функции и диалоги клиентской части\"\ndiagram functions \"Дерево основных и служебных функций\" type=general\nblock root \"Функции клиентской части\" role=generic shape=rectangle\nview v_root \"\" diagram=functions element=root\nblock main \"Основные функции\" role=generic shape=rectangle\nview v_main \"\" diagram=functions element=main\nblock service \"Служебные функции\" role=generic shape=rectangle\nview v_service \"\" diagram=functions element=service\nlink link_0 \"\" from=root kind=association to=main\nview v_link_0 \"\" diagram=functions element=link_0 from=v_root to=v_main\nlink link_1 \"\" from=root kind=association to=service\nview v_link_1 \"\" diagram=functions element=link_1 from=v_root to=v_service\nblock role_manager \"Менеджер маркетплейса\" role=generic shape=rectangle\nview v_role_manager \"\" diagram=functions element=role_manager\nlink link_2 \"\" from=main kind=association to=role_manager\nview v_link_2 \"\" diagram=functions element=link_2 from=v_main to=v_role_manager\nblock function_manager_register \"Зарегистрировать карточку\" role=generic shape=rectangle\nview v_function_manager_register \"\" diagram=functions element=function_manager_register\nlink link_3 \"\" from=role_manager kind=association to=function_manager_register\nview v_link_3 \"\" diagram=functions element=link_3 from=v_role_manager to=v_function_manager_register\nblock function_manager_calculate \"Рассчитать цену и массу\" role=generic shape=rectangle\nview v_function_manager_calculate \"\" diagram=functions element=function_manager_calculate\nlink link_4 \"\" from=role_manager kind=association to=function_manager_calculate\nview v_link_4 \"\" diagram=functions element=link_4 from=v_role_manager to=v_function_manager_calculate\nblock function_manager_revision \"Сохранить ревизию\" role=generic shape=rectangle\nview v_function_manager_revision \"\" diagram=functions element=function_manager_revision\nlink link_5 \"\" from=role_manager kind=association to=function_manager_revision\nview v_link_5 \"\" diagram=functions element=link_5 from=v_role_manager to=v_function_manager_revision\nblock function_manager_publish \"Опубликовать карточку\" role=generic shape=rectangle\nview v_function_manager_publish \"\" diagram=functions element=function_manager_publish\nlink link_6 \"\" from=role_manager kind=association to=function_manager_publish\nview v_link_6 \"\" diagram=functions element=link_6 from=v_role_manager to=v_function_manager_publish\nblock role_designer Дизайнер role=generic shape=rectangle\nview v_role_designer \"\" diagram=functions element=role_designer\nlink link_7 \"\" from=main kind=association to=role_designer\nview v_link_7 \"\" diagram=functions element=link_7 from=v_main to=v_role_designer\nblock function_designer_assignment \"Открыть задание по карточке\" role=generic shape=rectangle\nview v_function_designer_assignment \"\" diagram=functions element=function_designer_assignment\nlink link_8 \"\" from=role_designer kind=association to=function_designer_assignment\nview v_link_8 \"\" diagram=functions element=link_8 from=v_role_designer to=v_function_designer_assignment\nblock function_designer_image \"Выбрать изображение\" role=generic shape=rectangle\nview v_function_designer_image \"\" diagram=functions element=function_designer_image\nlink link_9 \"\" from=role_designer kind=association to=function_designer_image\nview v_link_9 \"\" diagram=functions element=link_9 from=v_role_designer to=v_function_designer_image\nblock function_designer_order \"Назначить порядок изображений\" role=generic shape=rectangle\nview v_function_designer_order \"\" diagram=functions element=function_designer_order\nlink link_10 \"\" from=role_designer kind=association to=function_designer_order\nview v_link_10 \"\" diagram=functions element=link_10 from=v_role_designer to=v_function_designer_order\nblock function_designer_preview \"Просмотреть результат оформления\" role=generic shape=rectangle\nview v_function_designer_preview \"\" diagram=functions element=function_designer_preview\nlink link_11 \"\" from=role_designer kind=association to=function_designer_preview\nview v_link_11 \"\" diagram=functions element=link_11 from=v_role_designer to=v_function_designer_preview\nblock role_developer Разработчик role=generic shape=rectangle\nview v_role_developer \"\" diagram=functions element=role_developer\nlink link_12 \"\" from=main kind=association to=role_developer\nview v_link_12 \"\" diagram=functions element=link_12 from=v_main to=v_role_developer\nblock function_developer_catalog \"Просмотреть каталог и предложения\" role=generic shape=rectangle\nview v_function_developer_catalog \"\" diagram=functions element=function_developer_catalog\nlink link_13 \"\" from=role_developer kind=association to=function_developer_catalog\nview v_link_13 \"\" diagram=functions element=link_13 from=v_role_developer to=v_function_developer_catalog\nblock function_developer_compose \"Сформировать состав\" role=generic shape=rectangle\nview v_function_developer_compose \"\" diagram=functions element=function_developer_compose\nlink link_14 \"\" from=role_developer kind=association to=function_developer_compose\nview v_link_14 \"\" diagram=functions element=link_14 from=v_role_developer to=v_function_developer_compose\nblock function_developer_check \"Проверить совместимость\" role=generic shape=rectangle\nview v_function_developer_check \"\" diagram=functions element=function_developer_check\nlink link_15 \"\" from=role_developer kind=association to=function_developer_check\nview v_link_15 \"\" diagram=functions element=link_15 from=v_role_developer to=v_function_developer_check\nblock function_developer_version \"Сохранить версию состава\" role=generic shape=rectangle\nview v_function_developer_version \"\" diagram=functions element=function_developer_version\nlink link_16 \"\" from=role_developer kind=association to=function_developer_version\nview v_link_16 \"\" diagram=functions element=link_16 from=v_role_developer to=v_function_developer_version\nblock role_director \"Генеральный директор\" role=generic shape=rectangle\nview v_role_director \"\" diagram=functions element=role_director\nlink link_17 \"\" from=main kind=association to=role_director\nview v_link_17 \"\" diagram=functions element=link_17 from=v_main to=v_role_director\nblock function_director_summary \"Просмотреть сводку карточек\" role=generic shape=rectangle\nview v_function_director_summary \"\" diagram=functions element=function_director_summary\nlink link_18 \"\" from=role_director kind=association to=function_director_summary\nview v_link_18 \"\" diagram=functions element=link_18 from=v_role_director to=v_function_director_summary\nblock function_director_inspect \"Проверить цену и состав\" role=generic shape=rectangle\nview v_function_director_inspect \"\" diagram=functions element=function_director_inspect\nlink link_19 \"\" from=role_director kind=association to=function_director_inspect\nview v_link_19 \"\" diagram=functions element=link_19 from=v_role_director to=v_function_director_inspect\nblock function_director_approve \"Утвердить готовую ревизию\" role=generic shape=rectangle\nview v_function_director_approve \"\" diagram=functions element=function_director_approve\nlink link_20 \"\" from=role_director kind=association to=function_director_approve\nview v_link_20 \"\" diagram=functions element=link_20 from=v_role_director to=v_function_director_approve\nblock service_0 \"Вход и выход\" role=generic shape=rectangle\nview v_service_0 \"\" diagram=functions element=service_0\nlink link_21 \"\" from=service kind=association to=service_0\nview v_link_21 \"\" diagram=functions element=link_21 from=v_service to=v_service_0\nblock service_1 \"Проверка прав\" role=generic shape=rectangle\nview v_service_1 \"\" diagram=functions element=service_1\nlink link_22 \"\" from=service kind=association to=service_1\nview v_link_22 \"\" diagram=functions element=link_22 from=v_service to=v_service_1\nblock service_2 \"Проверка ввода\" role=generic shape=rectangle\nview v_service_2 \"\" diagram=functions element=service_2\nlink link_23 \"\" from=service kind=association to=service_2\nview v_link_23 \"\" diagram=functions element=link_23 from=v_service to=v_service_2\nblock service_3 \"Справка и навигация\" role=generic shape=rectangle\nview v_service_3 \"\" diagram=functions element=service_3\nlink link_24 \"\" from=service kind=association to=service_3\nview v_link_24 \"\" diagram=functions element=link_24 from=v_service to=v_service_3\ndiagram dialog_manager \"Сценарий диалога — менеджер маркетплейса\" type=general\nblock login_manager \"Вход в систему\\nЛогин и пароль\" role=generic shape=rectangle\nview v_login_manager \"\" diagram=dialog_manager element=login_manager\nblock menu_manager \"Главное меню\\nМенеджер маркетплейса\\nВыбор задачи\" role=generic shape=rectangle\nview v_menu_manager \"\" diagram=dialog_manager element=menu_manager\nlink link_25 \"\" from=login_manager kind=directed to=menu_manager\nview v_link_25 \"\" diagram=dialog_manager element=link_25 from=v_login_manager to=v_menu_manager\nblock dialog_manager_register \"\" role=generic shape=rectangle\nview v_dialog_manager_register \"\" diagram=dialog_manager element=dialog_manager_register\nlabel dialog_manager_register_title \"1. Зарегистрировать карточку\" text=\"1. Зарегистрировать карточку\"\nview v_dialog_manager_register_title \"\" diagram=dialog_manager element=dialog_manager_register_title\nblock dialog_manager_register_rule \"\" role=generic shape=rectangle\nview v_dialog_manager_register_rule \"\" diagram=dialog_manager element=dialog_manager_register_rule\nlabel dialog_manager_register_body \"1. Ввести код продавца и заголовок.\\n2. Заполнить описание карточки.\\n3. Подтвердить создание.\\nРезультат: Черновик карточки.\\nОтказ: Код занят / поля не заполнены.\" text=\"1. Ввести код продавца и заголовок.\\n2. Заполнить описание карточки.\\n3. Подтвердить создание.\\nРезультат: Черновик карточки.\\nОтказ: Код занят / поля не заполнены.\"\nview v_dialog_manager_register_body \"\" diagram=dialog_manager element=dialog_manager_register_body\nlink link_26 \"\" from=menu_manager kind=directed to=dialog_manager_register\nview v_link_26 \"\" diagram=dialog_manager element=link_26 from=v_menu_manager to=v_dialog_manager_register\nblock dialog_manager_calculate \"\" role=generic shape=rectangle\nview v_dialog_manager_calculate \"\" diagram=dialog_manager element=dialog_manager_calculate\nlabel dialog_manager_calculate_title \"2. Рассчитать цену и массу\" text=\"2. Рассчитать цену и массу\"\nview v_dialog_manager_calculate_title \"\" diagram=dialog_manager element=dialog_manager_calculate_title\nblock dialog_manager_calculate_rule \"\" role=generic shape=rectangle\nview v_dialog_manager_calculate_rule \"\" diagram=dialog_manager element=dialog_manager_calculate_rule\nlabel dialog_manager_calculate_body \"1. Выбрать версию состава.\\n2. Задать затраты, наценку и комиссию.\\n3. Нажать «Рассчитать».\\nРезультат: Цена, себестоимость и масса.\\nОтказ: Ошибки состава / параметров.\" text=\"1. Выбрать версию состава.\\n2. Задать затраты, наценку и комиссию.\\n3. Нажать «Рассчитать».\\nРезультат: Цена, себестоимость и масса.\\nОтказ: Ошибки состава / параметров.\"\nview v_dialog_manager_calculate_body \"\" diagram=dialog_manager element=dialog_manager_calculate_body\nlink link_27 \"\" from=menu_manager kind=directed to=dialog_manager_calculate\nview v_link_27 \"\" diagram=dialog_manager element=link_27 from=v_menu_manager to=v_dialog_manager_calculate\nblock dialog_manager_revision \"\" role=generic shape=rectangle\nview v_dialog_manager_revision \"\" diagram=dialog_manager element=dialog_manager_revision\nlabel dialog_manager_revision_title \"3. Сохранить ревизию\" text=\"3. Сохранить ревизию\"\nview v_dialog_manager_revision_title \"\" diagram=dialog_manager element=dialog_manager_revision_title\nblock dialog_manager_revision_rule \"\" role=generic shape=rectangle\nview v_dialog_manager_revision_rule \"\" diagram=dialog_manager element=dialog_manager_revision_rule\nlabel dialog_manager_revision_body \"1. Выбрать карточку и состав.\\n2. Проверить содержание и расчёт.\\n3. Нажать «Сохранить ревизию».\\nРезультат: Новая ревизия DRAFT.\\nОтказ: Неполные данные карточки.\" text=\"1. Выбрать карточку и состав.\\n2. Проверить содержание и расчёт.\\n3. Нажать «Сохранить ревизию».\\nРезультат: Новая ревизия DRAFT.\\nОтказ: Неполные данные карточки.\"\nview v_dialog_manager_revision_body \"\" diagram=dialog_manager element=dialog_manager_revision_body\nlink link_28 \"\" from=menu_manager kind=directed to=dialog_manager_revision\nview v_link_28 \"\" diagram=dialog_manager element=link_28 from=v_menu_manager to=v_dialog_manager_revision\nblock dialog_manager_publish \"\" role=generic shape=rectangle\nview v_dialog_manager_publish \"\" diagram=dialog_manager element=dialog_manager_publish\nlabel dialog_manager_publish_title \"4. Опубликовать карточку\" text=\"4. Опубликовать карточку\"\nview v_dialog_manager_publish_title \"\" diagram=dialog_manager element=dialog_manager_publish_title\nblock dialog_manager_publish_rule \"\" role=generic shape=rectangle\nview v_dialog_manager_publish_rule \"\" diagram=dialog_manager element=dialog_manager_publish_rule\nlabel dialog_manager_publish_body \"1. Выбрать утверждённую ревизию READY.\\n2. Подтвердить передачу на публикацию.\\n3. Открыть результат попытки.\\nРезультат: Состояние попытки публикации.\\nОтказ: Ревизия не готова / ошибка отправки.\" text=\"1. Выбрать утверждённую ревизию READY.\\n2. Подтвердить передачу на публикацию.\\n3. Открыть результат попытки.\\nРезультат: Состояние попытки публикации.\\nОтказ: Ревизия не готова / ошибка отправки.\"\nview v_dialog_manager_publish_body \"\" diagram=dialog_manager element=dialog_manager_publish_body\nlink link_29 \"\" from=menu_manager kind=directed to=dialog_manager_publish\nview v_link_29 \"\" diagram=dialog_manager element=link_29 from=v_menu_manager to=v_dialog_manager_publish\ndiagram dialog_designer \"Сценарий диалога — дизайнер\" type=general\nblock login_designer \"Вход в систему\\nЛогин и пароль\" role=generic shape=rectangle\nview v_login_designer \"\" diagram=dialog_designer element=login_designer\nblock menu_designer \"Главное меню\\nДизайнер\\nВыбор задачи\" role=generic shape=rectangle\nview v_menu_designer \"\" diagram=dialog_designer element=menu_designer\nlink link_30 \"\" from=login_designer kind=directed to=menu_designer\nview v_link_30 \"\" diagram=dialog_designer element=link_30 from=v_login_designer to=v_menu_designer\nblock dialog_designer_assignment \"\" role=generic shape=rectangle\nview v_dialog_designer_assignment \"\" diagram=dialog_designer element=dialog_designer_assignment\nlabel dialog_designer_assignment_title \"1. Открыть задание по карточке\" text=\"1. Открыть задание по карточке\"\nview v_dialog_designer_assignment_title \"\" diagram=dialog_designer element=dialog_designer_assignment_title\nblock dialog_designer_assignment_rule \"\" role=generic shape=rectangle\nview v_dialog_designer_assignment_rule \"\" diagram=dialog_designer element=dialog_designer_assignment_rule\nlabel dialog_designer_assignment_body \"1. Выбрать карточку и ревизию.\\n2. Открыть описание и изображения.\\n3. Просмотреть задание.\\nРезультат: Содержание выбранной ревизии.\\nОтказ: Карточка не выбрана.\" text=\"1. Выбрать карточку и ревизию.\\n2. Открыть описание и изображения.\\n3. Просмотреть задание.\\nРезультат: Содержание выбранной ревизии.\\nОтказ: Карточка не выбрана.\"\nview v_dialog_designer_assignment_body \"\" diagram=dialog_designer element=dialog_designer_assignment_body\nlink link_31 \"\" from=menu_designer kind=directed to=dialog_designer_assignment\nview v_link_31 \"\" diagram=dialog_designer element=link_31 from=v_menu_designer to=v_dialog_designer_assignment\nblock dialog_designer_image \"\" role=generic shape=rectangle\nview v_dialog_designer_image \"\" diagram=dialog_designer element=dialog_designer_image\nlabel dialog_designer_image_title \"2. Выбрать изображение\" text=\"2. Выбрать изображение\"\nview v_dialog_designer_image_title \"\" diagram=dialog_designer element=dialog_designer_image_title\nblock dialog_designer_image_rule \"\" role=generic shape=rectangle\nview v_dialog_designer_image_rule \"\" diagram=dialog_designer element=dialog_designer_image_rule\nlabel dialog_designer_image_body \"1. Открыть список изображений.\\n2. Выбрать файл.\\n3. Просмотреть изображение.\\nРезультат: Предварительный просмотр.\\nОтказ: Изображение недоступно.\" text=\"1. Открыть список изображений.\\n2. Выбрать файл.\\n3. Просмотреть изображение.\\nРезультат: Предварительный просмотр.\\nОтказ: Изображение недоступно.\"\nview v_dialog_designer_image_body \"\" diagram=dialog_designer element=dialog_designer_image_body\nlink link_32 \"\" from=menu_designer kind=directed to=dialog_designer_image\nview v_link_32 \"\" diagram=dialog_designer element=link_32 from=v_menu_designer to=v_dialog_designer_image\nblock dialog_designer_order \"\" role=generic shape=rectangle\nview v_dialog_designer_order \"\" diagram=dialog_designer element=dialog_designer_order\nlabel dialog_designer_order_title \"3. Назначить порядок изображений\" text=\"3. Назначить порядок изображений\"\nview v_dialog_designer_order_title \"\" diagram=dialog_designer element=dialog_designer_order_title\nblock dialog_designer_order_rule \"\" role=generic shape=rectangle\nview v_dialog_designer_order_rule \"\" diagram=dialog_designer element=dialog_designer_order_rule\nlabel dialog_designer_order_body \"1. Выбрать изображение ревизии.\\n2. Ввести порядковый номер.\\n3. Нажать «Сохранить порядок».\\nРезультат: Сохранённый порядок показа.\\nОтказ: Номер занят / номер меньше 1.\" text=\"1. Выбрать изображение ревизии.\\n2. Ввести порядковый номер.\\n3. Нажать «Сохранить порядок».\\nРезультат: Сохранённый порядок показа.\\nОтказ: Номер занят / номер меньше 1.\"\nview v_dialog_designer_order_body \"\" diagram=dialog_designer element=dialog_designer_order_body\nlink link_33 \"\" from=menu_designer kind=directed to=dialog_designer_order\nview v_link_33 \"\" diagram=dialog_designer element=link_33 from=v_menu_designer to=v_dialog_designer_order\nblock dialog_designer_preview \"\" role=generic shape=rectangle\nview v_dialog_designer_preview \"\" diagram=dialog_designer element=dialog_designer_preview\nlabel dialog_designer_preview_title \"4. Просмотреть результат оформления\" text=\"4. Просмотреть результат оформления\"\nview v_dialog_designer_preview_title \"\" diagram=dialog_designer element=dialog_designer_preview_title\nblock dialog_designer_preview_rule \"\" role=generic shape=rectangle\nview v_dialog_designer_preview_rule \"\" diagram=dialog_designer element=dialog_designer_preview_rule\nlabel dialog_designer_preview_body \"1. Выбрать ревизию карточки.\\n2. Открыть предварительный просмотр.\\n3. Проверить текст и изображения.\\nРезультат: Карточка в заданном оформлении.\\nОтказ: Не выбрана ревизия карточки.\" text=\"1. Выбрать ревизию карточки.\\n2. Открыть предварительный просмотр.\\n3. Проверить текст и изображения.\\nРезультат: Карточка в заданном оформлении.\\nОтказ: Не выбрана ревизия карточки.\"\nview v_dialog_designer_preview_body \"\" diagram=dialog_designer element=dialog_designer_preview_body\nlink link_34 \"\" from=menu_designer kind=directed to=dialog_designer_preview\nview v_link_34 \"\" diagram=dialog_designer element=link_34 from=v_menu_designer to=v_dialog_designer_preview\ndiagram dialog_developer \"Сценарий диалога — разработчик\" type=general\nblock login_developer \"Вход в систему\\nЛогин и пароль\" role=generic shape=rectangle\nview v_login_developer \"\" diagram=dialog_developer element=login_developer\nblock menu_developer \"Главное меню\\nРазработчик\\nВыбор задачи\" role=generic shape=rectangle\nview v_menu_developer \"\" diagram=dialog_developer element=menu_developer\nlink link_35 \"\" from=login_developer kind=directed to=menu_developer\nview v_link_35 \"\" diagram=dialog_developer element=link_35 from=v_login_developer to=v_menu_developer\nblock dialog_developer_catalog \"\" role=generic shape=rectangle\nview v_dialog_developer_catalog \"\" diagram=dialog_developer element=dialog_developer_catalog\nlabel dialog_developer_catalog_title \"1. Просмотреть каталог и предложения\" text=\"1. Просмотреть каталог и предложения\"\nview v_dialog_developer_catalog_title \"\" diagram=dialog_developer element=dialog_developer_catalog_title\nblock dialog_developer_catalog_rule \"\" role=generic shape=rectangle\nview v_dialog_developer_catalog_rule \"\" diagram=dialog_developer element=dialog_developer_catalog_rule\nlabel dialog_developer_catalog_body \"1. Выбрать группу и поставщика.\\n2. Просмотреть цены и остатки.\\n3. Выбрать компонент для состава.\\nРезультат: Выбранный компонент / предложение.\\nОтказ: Нет подходящего предложения.\" text=\"1. Выбрать группу и поставщика.\\n2. Просмотреть цены и остатки.\\n3. Выбрать компонент для состава.\\nРезультат: Выбранный компонент / предложение.\\nОтказ: Нет подходящего предложения.\"\nview v_dialog_developer_catalog_body \"\" diagram=dialog_developer element=dialog_developer_catalog_body\nlink link_36 \"\" from=menu_developer kind=directed to=dialog_developer_catalog\nview v_link_36 \"\" diagram=dialog_developer element=link_36 from=v_menu_developer to=v_dialog_developer_catalog\nblock dialog_developer_compose \"\" role=generic shape=rectangle\nview v_dialog_developer_compose \"\" diagram=dialog_developer element=dialog_developer_compose\nlabel dialog_developer_compose_title \"2. Сформировать состав\" text=\"2. Сформировать состав\"\nview v_dialog_developer_compose_title \"\" diagram=dialog_developer element=dialog_developer_compose_title\nblock dialog_developer_compose_rule \"\" role=generic shape=rectangle\nview v_dialog_developer_compose_rule \"\" diagram=dialog_developer element=dialog_developer_compose_rule\nlabel dialog_developer_compose_body \"1. Выбрать конфигурацию.\\n2. Добавить позиции и количества.\\n3. Указать предложения.\\nРезультат: Рабочий состав конфигурации.\\nОтказ: Неверное количество / пустая позиция.\" text=\"1. Выбрать конфигурацию.\\n2. Добавить позиции и количества.\\n3. Указать предложения.\\nРезультат: Рабочий состав конфигурации.\\nОтказ: Неверное количество / пустая позиция.\"\nview v_dialog_developer_compose_body \"\" diagram=dialog_developer element=dialog_developer_compose_body\nlink link_37 \"\" from=menu_developer kind=directed to=dialog_developer_compose\nview v_link_37 \"\" diagram=dialog_developer element=link_37 from=v_menu_developer to=v_dialog_developer_compose\nblock dialog_developer_check \"\" role=generic shape=rectangle\nview v_dialog_developer_check \"\" diagram=dialog_developer element=dialog_developer_check\nlabel dialog_developer_check_title \"3. Проверить совместимость\" text=\"3. Проверить совместимость\"\nview v_dialog_developer_check_title \"\" diagram=dialog_developer element=dialog_developer_check_title\nblock dialog_developer_check_rule \"\" role=generic shape=rectangle\nview v_dialog_developer_check_rule \"\" diagram=dialog_developer element=dialog_developer_check_rule\nlabel dialog_developer_check_body \"1. Открыть выбранный состав.\\n2. Нажать «Проверить состав».\\n3. Просмотреть результат проверки.\\nРезультат: Совместимость подтверждена.\\nОтказ: Перечень несовместимых позиций.\" text=\"1. Открыть выбранный состав.\\n2. Нажать «Проверить состав».\\n3. Просмотреть результат проверки.\\nРезультат: Совместимость подтверждена.\\nОтказ: Перечень несовместимых позиций.\"\nview v_dialog_developer_check_body \"\" diagram=dialog_developer element=dialog_developer_check_body\nlink link_38 \"\" from=menu_developer kind=directed to=dialog_developer_check\nview v_link_38 \"\" diagram=dialog_developer element=link_38 from=v_menu_developer to=v_dialog_developer_check\nblock dialog_developer_version \"\" role=generic shape=rectangle\nview v_dialog_developer_version \"\" diagram=dialog_developer element=dialog_developer_version\nlabel dialog_developer_version_title \"4. Сохранить версию состава\" text=\"4. Сохранить версию состава\"\nview v_dialog_developer_version_title \"\" diagram=dialog_developer element=dialog_developer_version_title\nblock dialog_developer_version_rule \"\" role=generic shape=rectangle\nview v_dialog_developer_version_rule \"\" diagram=dialog_developer element=dialog_developer_version_rule\nlabel dialog_developer_version_body \"1. Выбрать проверенный состав.\\n2. Подтвердить сохранение.\\n3. Просмотреть номер новой версии.\\nРезультат: Новая версия состава.\\nОтказ: Состав не прошёл проверку.\" text=\"1. Выбрать проверенный состав.\\n2. Подтвердить сохранение.\\n3. Просмотреть номер новой версии.\\nРезультат: Новая версия состава.\\nОтказ: Состав не прошёл проверку.\"\nview v_dialog_developer_version_body \"\" diagram=dialog_developer element=dialog_developer_version_body\nlink link_39 \"\" from=menu_developer kind=directed to=dialog_developer_version\nview v_link_39 \"\" diagram=dialog_developer element=link_39 from=v_menu_developer to=v_dialog_developer_version\ndiagram dialog_director \"Сценарий диалога — генеральный директор\" type=general\nblock login_director \"Вход в систему\\nЛогин и пароль\" role=generic shape=rectangle\nview v_login_director \"\" diagram=dialog_director element=login_director\nblock menu_director \"Главное меню\\nГенеральный директор\\nВыбор задачи\" role=generic shape=rectangle\nview v_menu_director \"\" diagram=dialog_director element=menu_director\nlink link_40 \"\" from=login_director kind=directed to=menu_director\nview v_link_40 \"\" diagram=dialog_director element=link_40 from=v_login_director to=v_menu_director\nblock dialog_director_summary \"\" role=generic shape=rectangle\nview v_dialog_director_summary \"\" diagram=dialog_director element=dialog_director_summary\nlabel dialog_director_summary_title \"1. Просмотреть сводку карточек\" text=\"1. Просмотреть сводку карточек\"\nview v_dialog_director_summary_title \"\" diagram=dialog_director element=dialog_director_summary_title\nblock dialog_director_summary_rule \"\" role=generic shape=rectangle\nview v_dialog_director_summary_rule \"\" diagram=dialog_director element=dialog_director_summary_rule\nlabel dialog_director_summary_body \"1. Открыть список карточек.\\n2. Задать фильтр по состоянию.\\n3. Выбрать карточку из результата.\\nРезультат: Сводка по выбранному состоянию.\\nОтказ: Нет карточек по фильтру.\" text=\"1. Открыть список карточек.\\n2. Задать фильтр по состоянию.\\n3. Выбрать карточку из результата.\\nРезультат: Сводка по выбранному состоянию.\\nОтказ: Нет карточек по фильтру.\"\nview v_dialog_director_summary_body \"\" diagram=dialog_director element=dialog_director_summary_body\nlink link_41 \"\" from=menu_director kind=directed to=dialog_director_summary\nview v_link_41 \"\" diagram=dialog_director element=link_41 from=v_menu_director to=v_dialog_director_summary\nblock dialog_director_inspect \"\" role=generic shape=rectangle\nview v_dialog_director_inspect \"\" diagram=dialog_director element=dialog_director_inspect\nlabel dialog_director_inspect_title \"2. Проверить цену и состав\" text=\"2. Проверить цену и состав\"\nview v_dialog_director_inspect_title \"\" diagram=dialog_director element=dialog_director_inspect_title\nblock dialog_director_inspect_rule \"\" role=generic shape=rectangle\nview v_dialog_director_inspect_rule \"\" diagram=dialog_director element=dialog_director_inspect_rule\nlabel dialog_director_inspect_body \"1. Выбрать карточку и ревизию.\\n2. Открыть состав и расчёт.\\n3. Проверить цену и готовность.\\nРезультат: Состав и показатели ревизии.\\nОтказ: Недостаточно данных для проверки.\" text=\"1. Выбрать карточку и ревизию.\\n2. Открыть состав и расчёт.\\n3. Проверить цену и готовность.\\nРезультат: Состав и показатели ревизии.\\nОтказ: Недостаточно данных для проверки.\"\nview v_dialog_director_inspect_body \"\" diagram=dialog_director element=dialog_director_inspect_body\nlink link_42 \"\" from=menu_director kind=directed to=dialog_director_inspect\nview v_link_42 \"\" diagram=dialog_director element=link_42 from=v_menu_director to=v_dialog_director_inspect\nblock dialog_director_approve \"\" role=generic shape=rectangle\nview v_dialog_director_approve \"\" diagram=dialog_director element=dialog_director_approve\nlabel dialog_director_approve_title \"3. Утвердить готовую ревизию\" text=\"3. Утвердить готовую ревизию\"\nview v_dialog_director_approve_title \"\" diagram=dialog_director element=dialog_director_approve_title\nblock dialog_director_approve_rule \"\" role=generic shape=rectangle\nview v_dialog_director_approve_rule \"\" diagram=dialog_director element=dialog_director_approve_rule\nlabel dialog_director_approve_body \"1. Открыть ревизию DRAFT.\\n2. Проверить содержание и изображения.\\n3. Утвердить или вернуть на доработку.\\nРезультат: READY после успешной проверки.\\nОтказ: Ревизия остаётся DRAFT.\" text=\"1. Открыть ревизию DRAFT.\\n2. Проверить содержание и изображения.\\n3. Утвердить или вернуть на доработку.\\nРезультат: READY после успешной проверки.\\nОтказ: Ревизия остаётся DRAFT.\"\nview v_dialog_director_approve_body \"\" diagram=dialog_director element=dialog_director_approve_body\nlink link_43 \"\" from=menu_director kind=directed to=dialog_director_approve\nview v_link_43 \"\" diagram=dialog_director element=link_43 from=v_menu_director to=v_dialog_director_approve\ndiagram structure \"Структурная схема клиентской части\" type=general\nlabel client_title \"Клиентская часть\" text=\"Клиентская часть\"\nview v_client_title \"\" diagram=structure element=client_title\nlabel visual_title \"Визуальные модули\" text=\"Визуальные модули\"\nview v_visual_title \"\" diagram=structure element=visual_title\nlabel logic_title \"Невизуальные модули\" text=\"Невизуальные модули\"\nview v_logic_title \"\" diagram=structure element=logic_title\nblock auth \"Форма входа\" role=generic shape=rectangle\nview v_auth \"\" diagram=structure element=auth\nblock navigation \"Главное меню и навигация\" role=generic shape=rectangle\nview v_navigation \"\" diagram=structure element=navigation\nblock forms \"Представления ролей:\\nменеджер маркетплейса;\\nдизайнер; разработчик;\\nгенеральный директор\" role=generic shape=rectangle\nview v_forms \"\" diagram=structure element=forms\nblock session \"Сеанс и проверка прав\" role=generic shape=rectangle\nview v_session \"\" diagram=structure element=session\nblock validation \"Проверка ввода\\nи сообщения об ошибках\" role=generic shape=rectangle\nview v_validation \"\" diagram=structure element=validation\nblock commands \"Обработчики команд\\nи обновление представлений\" role=generic shape=rectangle\nview v_commands \"\" diagram=structure element=commands\nblock application \"Прикладной сервис:\\nсостав, расчёт, карточки,\\nизображения и публикация\" role=generic shape=rectangle\nview v_application \"\" diagram=structure element=application\nlink link_44 \"\" from=auth kind=directed to=session\nview v_link_44 \"\" diagram=structure element=link_44 from=v_auth to=v_session\nlink link_45 \"\" from=auth kind=directed to=navigation\nview v_link_45 \"\" diagram=structure element=link_45 from=v_auth to=v_navigation\nlink link_46 \"\" from=navigation kind=directed to=forms\nview v_link_46 \"\" diagram=structure element=link_46 from=v_navigation to=v_forms\nlink link_47 \"\" from=forms kind=directed to=validation\nview v_link_47 \"\" diagram=structure element=link_47 from=v_forms to=v_validation\nlink link_48 \"\" from=validation kind=directed to=commands\nview v_link_48 \"\" diagram=structure element=link_48 from=v_validation to=v_commands\nlink link_49 \"\" from=commands kind=bidirectional to=application\nview v_link_49 \"\" diagram=structure element=link_49 from=v_commands to=v_application\nlink link_50 \"\" from=commands kind=directed to=forms\nview v_link_50 \"\" diagram=structure element=link_50 from=v_commands to=v_forms\nlabel result_label Результаты text=Результаты\nview v_result_label \"\" diagram=structure element=result_label\n",
  "draft": "scheme pr10_client \"Функции и диалоги клиентской части\"\ndiagram functions \"Дерево основных и служебных функций\" type=general\nblock root \"Функции клиентской части\" role=generic shape=rectangle\nview v_root \"\" diagram=functions element=root\nblock main \"Основные функции\" role=generic shape=rectangle\nview v_main \"\" diagram=functions element=main\nblock service \"Служебные функции\" role=generic shape=rectangle\nview v_service \"\" diagram=functions element=service\nlink link_0 \"\" from=root kind=association to=main\nview v_link_0 \"\" diagram=functions element=link_0 from=v_root to=v_main\nlink link_1 \"\" from=root kind=association to=service\nview v_link_1 \"\" diagram=functions element=link_1 from=v_root to=v_service\nblock role_manager \"Менеджер маркетплейса\" role=generic shape=rectangle\nview v_role_manager \"\" diagram=functions element=role_manager\nlink link_2 \"\" from=main kind=association to=role_manager\nview v_link_2 \"\" diagram=functions element=link_2 from=v_main to=v_role_manager\nblock function_manager_register \"Зарегистрировать карточку\" role=generic shape=rectangle\nview v_function_manager_register \"\" diagram=functions element=function_manager_register\nlink link_3 \"\" from=role_manager kind=association to=function_manager_register\nview v_link_3 \"\" diagram=functions element=link_3 from=v_role_manager to=v_function_manager_register\nblock function_manager_calculate \"Рассчитать цену и массу\" role=generic shape=rectangle\nview v_function_manager_calculate \"\" diagram=functions element=function_manager_calculate\nlink link_4 \"\" from=role_manager kind=association to=function_manager_calculate\nview v_link_4 \"\" diagram=functions element=link_4 from=v_role_manager to=v_function_manager_calculate\nblock function_manager_revision \"Сохранить ревизию\" role=generic shape=rectangle\nview v_function_manager_revision \"\" diagram=functions element=function_manager_revision\nlink link_5 \"\" from=role_manager kind=association to=function_manager_revision\nview v_link_5 \"\" diagram=functions element=link_5 from=v_role_manager to=v_function_manager_revision\nblock function_manager_publish \"Опубликовать карточку\" role=generic shape=rectangle\nview v_function_manager_publish \"\" diagram=functions element=function_manager_publish\nlink link_6 \"\" from=role_manager kind=association to=function_manager_publish\nview v_link_6 \"\" diagram=functions element=link_6 from=v_role_manager to=v_function_manager_publish\nblock role_designer Дизайнер role=generic shape=rectangle\nview v_role_designer \"\" diagram=functions element=role_designer\nlink link_7 \"\" from=main kind=association to=role_designer\nview v_link_7 \"\" diagram=functions element=link_7 from=v_main to=v_role_designer\nblock function_designer_assignment \"Открыть задание по карточке\" role=generic shape=rectangle\nview v_function_designer_assignment \"\" diagram=functions element=function_designer_assignment\nlink link_8 \"\" from=role_designer kind=association to=function_designer_assignment\nview v_link_8 \"\" diagram=functions element=link_8 from=v_role_designer to=v_function_designer_assignment\nblock function_designer_image \"Выбрать изображение\" role=generic shape=rectangle\nview v_function_designer_image \"\" diagram=functions element=function_designer_image\nlink link_9 \"\" from=role_designer kind=association to=function_designer_image\nview v_link_9 \"\" diagram=functions element=link_9 from=v_role_designer to=v_function_designer_image\nblock function_designer_order \"Назначить порядок изображений\" role=generic shape=rectangle\nview v_function_designer_order \"\" diagram=functions element=function_designer_order\nlink link_10 \"\" from=role_designer kind=association to=function_designer_order\nview v_link_10 \"\" diagram=functions element=link_10 from=v_role_designer to=v_function_designer_order\nblock function_designer_preview \"Просмотреть результат оформления\" role=generic shape=rectangle\nview v_function_designer_preview \"\" diagram=functions element=function_designer_preview\nlink link_11 \"\" from=role_designer kind=association to=function_designer_preview\nview v_link_11 \"\" diagram=functions element=link_11 from=v_role_designer to=v_function_designer_preview\nblock role_developer Разработчик role=generic shape=rectangle\nview v_role_developer \"\" diagram=functions element=role_developer\nlink link_12 \"\" from=main kind=association to=role_developer\nview v_link_12 \"\" diagram=functions element=link_12 from=v_main to=v_role_developer\nblock function_developer_catalog \"Просмотреть каталог и предложения\" role=generic shape=rectangle\nview v_function_developer_catalog \"\" diagram=functions element=function_developer_catalog\nlink link_13 \"\" from=role_developer kind=association to=function_developer_catalog\nview v_link_13 \"\" diagram=functions element=link_13 from=v_role_developer to=v_function_developer_catalog\nblock function_developer_compose \"Сформировать состав\" role=generic shape=rectangle\nview v_function_developer_compose \"\" diagram=functions element=function_developer_compose\nlink link_14 \"\" from=role_developer kind=association to=function_developer_compose\nview v_link_14 \"\" diagram=functions element=link_14 from=v_role_developer to=v_function_developer_compose\nblock function_developer_check \"Проверить совместимость\" role=generic shape=rectangle\nview v_function_developer_check \"\" diagram=functions element=function_developer_check\nlink link_15 \"\" from=role_developer kind=association to=function_developer_check\nview v_link_15 \"\" diagram=functions element=link_15 from=v_role_developer to=v_function_developer_check\nblock function_developer_version \"Сохранить версию состава\" role=generic shape=rectangle\nview v_function_developer_version \"\" diagram=functions element=function_developer_version\nlink link_16 \"\" from=role_developer kind=association to=function_developer_version\nview v_link_16 \"\" diagram=functions element=link_16 from=v_role_developer to=v_function_developer_version\nblock role_director \"Генеральный директор\" role=generic shape=rectangle\nview v_role_director \"\" diagram=functions element=role_director\nlink link_17 \"\" from=main kind=association to=role_director\nview v_link_17 \"\" diagram=functions element=link_17 from=v_main to=v_role_director\nblock function_director_summary \"Просмотреть сводку карточек\" role=generic shape=rectangle\nview v_function_director_summary \"\" diagram=functions element=function_director_summary\nlink link_18 \"\" from=role_director kind=association to=function_director_summary\nview v_link_18 \"\" diagram=functions element=link_18 from=v_role_director to=v_function_director_summary\nblock function_director_inspect \"Проверить цену и состав\" role=generic shape=rectangle\nview v_function_director_inspect \"\" diagram=functions element=function_director_inspect\nlink link_19 \"\" from=role_director kind=association to=function_director_inspect\nview v_link_19 \"\" diagram=functions element=link_19 from=v_role_director to=v_function_director_inspect\nblock function_director_approve \"Утвердить готовую ревизию\" role=generic shape=rectangle\nview v_function_director_approve \"\" diagram=functions element=function_director_approve\nlink link_20 \"\" from=role_director kind=association to=function_director_approve\nview v_link_20 \"\" diagram=functions element=link_20 from=v_role_director to=v_function_director_approve\nblock service_0 \"Вход и выход\" role=generic shape=rectangle\nview v_service_0 \"\" diagram=functions element=service_0\nlink link_21 \"\" from=service kind=association to=service_0\nview v_link_21 \"\" diagram=functions element=link_21 from=v_service to=v_service_0\nblock service_1 \"Проверка прав\" role=generic shape=rectangle\nview v_service_1 \"\" diagram=functions element=service_1\nlink link_22 \"\" from=service kind=association to=service_1\nview v_link_22 \"\" diagram=functions element=link_22 from=v_service to=v_service_1\nblock service_2 \"Проверка ввода\" role=generic shape=rectangle\nview v_service_2 \"\" diagram=functions element=service_2\nlink link_23 \"\" from=service kind=association to=service_2\nview v_link_23 \"\" diagram=functions element=link_23 from=v_service to=v_service_2\nblock service_3 \"Справка и навигация\" role=generic shape=rectangle\nview v_service_3 \"\" diagram=functions element=service_3\nlink link_24 \"\" from=service kind=association to=service_3\nview v_link_24 \"\" diagram=functions element=link_24 from=v_service to=v_service_3\ndiagram dialog_manager \"Сценарий диалога — менеджер маркетплейса\" type=general\nblock login_manager \"Вход в систему\\nЛогин и пароль\" role=generic shape=rectangle\nview v_login_manager \"\" diagram=dialog_manager element=login_manager\nblock menu_manager \"Главное меню\\nМенеджер маркетплейса\\nВыбор задачи\" role=generic shape=rectangle\nview v_menu_manager \"\" diagram=dialog_manager element=menu_manager\nlink link_25 \"\" from=login_manager kind=directed to=menu_manager\nview v_link_25 \"\" diagram=dialog_manager element=link_25 from=v_login_manager to=v_menu_manager\nblock dialog_manager_register \"\" role=generic shape=rectangle\nview v_dialog_manager_register \"\" diagram=dialog_manager element=dialog_manager_register\nlabel dialog_manager_register_title \"1. Зарегистрировать карточку\" text=\"1. Зарегистрировать карточку\"\nview v_dialog_manager_register_title \"\" diagram=dialog_manager element=dialog_manager_register_title\nblock dialog_manager_register_rule \"\" role=generic shape=rectangle\nview v_dialog_manager_register_rule \"\" diagram=dialog_manager element=dialog_manager_register_rule\nlabel dialog_manager_register_body \"1. Ввести код продавца и заголовок.\\n2. Заполнить описание карточки.\\n3. Подтвердить создание.\\nРезультат: Черновик карточки.\\nОтказ: Код занят / поля не заполнены.\" text=\"1. Ввести код продавца и заголовок.\\n2. Заполнить описание карточки.\\n3. Подтвердить создание.\\nРезультат: Черновик карточки.\\nОтказ: Код занят / поля не заполнены.\"\nview v_dialog_manager_register_body \"\" diagram=dialog_manager element=dialog_manager_register_body\nlink link_26 \"\" from=menu_manager kind=directed to=dialog_manager_register\nview v_link_26 \"\" diagram=dialog_manager element=link_26 from=v_menu_manager to=v_dialog_manager_register\nblock dialog_manager_calculate \"\" role=generic shape=rectangle\nview v_dialog_manager_calculate \"\" diagram=dialog_manager element=dialog_manager_calculate\nlabel dialog_manager_calculate_title \"2. Рассчитать цену и массу\" text=\"2. Рассчитать цену и массу\"\nview v_dialog_manager_calculate_title \"\" diagram=dialog_manager element=dialog_manager_calculate_title\nblock dialog_manager_calculate_rule \"\" role=generic shape=rectangle\nview v_dialog_manager_calculate_rule \"\" diagram=dialog_manager element=dialog_manager_calculate_rule\nlabel dialog_manager_calculate_body \"1. Выбрать версию состава.\\n2. Задать затраты, наценку и комиссию.\\n3. Нажать «Рассчитать».\\nРезультат: Цена, себестоимость и масса.\\nОтказ: Ошибки состава / параметров.\" text=\"1. Выбрать версию состава.\\n2. Задать затраты, наценку и комиссию.\\n3. Нажать «Рассчитать».\\nРезультат: Цена, себестоимость и масса.\\nОтказ: Ошибки состава / параметров.\"\nview v_dialog_manager_calculate_body \"\" diagram=dialog_manager element=dialog_manager_calculate_body\nlink link_27 \"\" from=menu_manager kind=directed to=dialog_manager_calculate\nview v_link_27 \"\" diagram=dialog_manager element=link_27 from=v_menu_manager to=v_dialog_manager_calculate\nblock dialog_manager_revision \"\" role=generic shape=rectangle\nview v_dialog_manager_revision \"\" diagram=dialog_manager element=dialog_manager_revision\nlabel dialog_manager_revision_title \"3. Сохранить ревизию\" text=\"3. Сохранить ревизию\"\nview v_dialog_manager_revision_title \"\" diagram=dialog_manager element=dialog_manager_revision_title\nblock dialog_manager_revision_rule \"\" role=generic shape=rectangle\nview v_dialog_manager_revision_rule \"\" diagram=dialog_manager element=dialog_manager_revision_rule\nlabel dialog_manager_revision_body \"1. Выбрать карточку и состав.\\n2. Проверить содержание и расчёт.\\n3. Нажать «Сохранить ревизию».\\nРезультат: Новая ревизия DRAFT.\\nОтказ: Неполные данные карточки.\" text=\"1. Выбрать карточку и состав.\\n2. Проверить содержание и расчёт.\\n3. Нажать «Сохранить ревизию».\\nРезультат: Новая ревизия DRAFT.\\nОтказ: Неполные данные карточки.\"\nview v_dialog_manager_revision_body \"\" diagram=dialog_manager element=dialog_manager_revision_body\nlink link_28 \"\" from=menu_manager kind=directed to=dialog_manager_revision\nview v_link_28 \"\" diagram=dialog_manager element=link_28 from=v_menu_manager to=v_dialog_manager_revision\nblock dialog_manager_publish \"\" role=generic shape=rectangle\nview v_dialog_manager_publish \"\" diagram=dialog_manager element=dialog_manager_publish\nlabel dialog_manager_publish_title \"4. Опубликовать карточку\" text=\"4. Опубликовать карточку\"\nview v_dialog_manager_publish_title \"\" diagram=dialog_manager element=dialog_manager_publish_title\nblock dialog_manager_publish_rule \"\" role=generic shape=rectangle\nview v_dialog_manager_publish_rule \"\" diagram=dialog_manager element=dialog_manager_publish_rule\nlabel dialog_manager_publish_body \"1. Выбрать утверждённую ревизию READY.\\n2. Подтвердить передачу на публикацию.\\n3. Открыть результат попытки.\\nРезультат: Состояние попытки публикации.\\nОтказ: Ревизия не готова / ошибка отправки.\" text=\"1. Выбрать утверждённую ревизию READY.\\n2. Подтвердить передачу на публикацию.\\n3. Открыть результат попытки.\\nРезультат: Состояние попытки публикации.\\nОтказ: Ревизия не готова / ошибка отправки.\"\nview v_dialog_manager_publish_body \"\" diagram=dialog_manager element=dialog_manager_publish_body\nlink link_29 \"\" from=menu_manager kind=directed to=dialog_manager_publish\nview v_link_29 \"\" diagram=dialog_manager element=link_29 from=v_menu_manager to=v_dialog_manager_publish\ndiagram dialog_designer \"Сценарий диалога — дизайнер\" type=general\nblock login_designer \"Вход в систему\\nЛогин и пароль\" role=generic shape=rectangle\nview v_login_designer \"\" diagram=dialog_designer element=login_designer\nblock menu_designer \"Главное меню\\nДизайнер\\nВыбор задачи\" role=generic shape=rectangle\nview v_menu_designer \"\" diagram=dialog_designer element=menu_designer\nlink link_30 \"\" from=login_designer kind=directed to=menu_designer\nview v_link_30 \"\" diagram=dialog_designer element=link_30 from=v_login_designer to=v_menu_designer\nblock dialog_designer_assignment \"\" role=generic shape=rectangle\nview v_dialog_designer_assignment \"\" diagram=dialog_designer element=dialog_designer_assignment\nlabel dialog_designer_assignment_title \"1. Открыть задание по карточке\" text=\"1. Открыть задание по карточке\"\nview v_dialog_designer_assignment_title \"\" diagram=dialog_designer element=dialog_designer_assignment_title\nblock dialog_designer_assignment_rule \"\" role=generic shape=rectangle\nview v_dialog_designer_assignment_rule \"\" diagram=dialog_designer element=dialog_designer_assignment_rule\nlabel dialog_designer_assignment_body \"1. Выбрать карточку и ревизию.\\n2. Открыть описание и изображения.\\n3. Просмотреть задание.\\nРезультат: Содержание выбранной ревизии.\\nОтказ: Карточка не выбрана.\" text=\"1. Выбрать карточку и ревизию.\\n2. Открыть описание и изображения.\\n3. Просмотреть задание.\\nРезультат: Содержание выбранной ревизии.\\nОтказ: Карточка не выбрана.\"\nview v_dialog_designer_assignment_body \"\" diagram=dialog_designer element=dialog_designer_assignment_body\nlink link_31 \"\" from=menu_designer kind=directed to=dialog_designer_assignment\nview v_link_31 \"\" diagram=dialog_designer element=link_31 from=v_menu_designer to=v_dialog_designer_assignment\nblock dialog_designer_image \"\" role=generic shape=rectangle\nview v_dialog_designer_image \"\" diagram=dialog_designer element=dialog_designer_image\nlabel dialog_designer_image_title \"2. Выбрать изображение\" text=\"2. Выбрать изображение\"\nview v_dialog_designer_image_title \"\" diagram=dialog_designer element=dialog_designer_image_title\nblock dialog_designer_image_rule \"\" role=generic shape=rectangle\nview v_dialog_designer_image_rule \"\" diagram=dialog_designer element=dialog_designer_image_rule\nlabel dialog_designer_image_body \"1. Открыть список изображений.\\n2. Выбрать файл.\\n3. Просмотреть изображение.\\nРезультат: Предварительный просмотр.\\nОтказ: Изображение недоступно.\" text=\"1. Открыть список изображений.\\n2. Выбрать файл.\\n3. Просмотреть изображение.\\nРезультат: Предварительный просмотр.\\nОтказ: Изображение недоступно.\"\nview v_dialog_designer_image_body \"\" diagram=dialog_designer element=dialog_designer_image_body\nlink link_32 \"\" from=menu_designer kind=directed to=dialog_designer_image\nview v_link_32 \"\" diagram=dialog_designer element=link_32 from=v_menu_designer to=v_dialog_designer_image\nblock dialog_designer_order \"\" role=generic shape=rectangle\nview v_dialog_designer_order \"\" diagram=dialog_designer element=dialog_designer_order\nlabel dialog_designer_order_title \"3. Назначить порядок изображений\" text=\"3. Назначить порядок изображений\"\nview v_dialog_designer_order_title \"\" diagram=dialog_designer element=dialog_designer_order_title\nblock dialog_designer_order_rule \"\" role=generic shape=rectangle\nview v_dialog_designer_order_rule \"\" diagram=dialog_designer element=dialog_designer_order_rule\nlabel dialog_designer_order_body \"1. Выбрать изображение ревизии.\\n2. Ввести порядковый номер.\\n3. Нажать «Сохранить порядок».\\nРезультат: Сохранённый порядок показа.\\nОтказ: Номер занят / номер меньше 1.\" text=\"1. Выбрать изображение ревизии.\\n2. Ввести порядковый номер.\\n3. Нажать «Сохранить порядок».\\nРезультат: Сохранённый порядок показа.\\nОтказ: Номер занят / номер меньше 1.\"\nview v_dialog_designer_order_body \"\" diagram=dialog_designer element=dialog_designer_order_body\nlink link_33 \"\" from=menu_designer kind=directed to=dialog_designer_order\nview v_link_33 \"\" diagram=dialog_designer element=link_33 from=v_menu_designer to=v_dialog_designer_order\nblock dialog_designer_preview \"\" role=generic shape=rectangle\nview v_dialog_designer_preview \"\" diagram=dialog_designer element=dialog_designer_preview\nlabel dialog_designer_preview_title \"4. Просмотреть результат оформления\" text=\"4. Просмотреть результат оформления\"\nview v_dialog_designer_preview_title \"\" diagram=dialog_designer element=dialog_designer_preview_title\nblock dialog_designer_preview_rule \"\" role=generic shape=rectangle\nview v_dialog_designer_preview_rule \"\" diagram=dialog_designer element=dialog_designer_preview_rule\nlabel dialog_designer_preview_body \"1. Выбрать ревизию карточки.\\n2. Открыть предварительный просмотр.\\n3. Проверить текст и изображения.\\nРезультат: Карточка в заданном оформлении.\\nОтказ: Не выбрана ревизия карточки.\" text=\"1. Выбрать ревизию карточки.\\n2. Открыть предварительный просмотр.\\n3. Проверить текст и изображения.\\nРезультат: Карточка в заданном оформлении.\\nОтказ: Не выбрана ревизия карточки.\"\nview v_dialog_designer_preview_body \"\" diagram=dialog_designer element=dialog_designer_preview_body\nlink link_34 \"\" from=menu_designer kind=directed to=dialog_designer_preview\nview v_link_34 \"\" diagram=dialog_designer element=link_34 from=v_menu_designer to=v_dialog_designer_preview\ndiagram dialog_developer \"Сценарий диалога — разработчик\" type=general\nblock login_developer \"Вход в систему\\nЛогин и пароль\" role=generic shape=rectangle\nview v_login_developer \"\" diagram=dialog_developer element=login_developer\nblock menu_developer \"Главное меню\\nРазработчик\\nВыбор задачи\" role=generic shape=rectangle\nview v_menu_developer \"\" diagram=dialog_developer element=menu_developer\nlink link_35 \"\" from=login_developer kind=directed to=menu_developer\nview v_link_35 \"\" diagram=dialog_developer element=link_35 from=v_login_developer to=v_menu_developer\nblock dialog_developer_catalog \"\" role=generic shape=rectangle\nview v_dialog_developer_catalog \"\" diagram=dialog_developer element=dialog_developer_catalog\nlabel dialog_developer_catalog_title \"1. Просмотреть каталог и предложения\" text=\"1. Просмотреть каталог и предложения\"\nview v_dialog_developer_catalog_title \"\" diagram=dialog_developer element=dialog_developer_catalog_title\nblock dialog_developer_catalog_rule \"\" role=generic shape=rectangle\nview v_dialog_developer_catalog_rule \"\" diagram=dialog_developer element=dialog_developer_catalog_rule\nlabel dialog_developer_catalog_body \"1. Выбрать группу и поставщика.\\n2. Просмотреть цены и остатки.\\n3. Выбрать компонент для состава.\\nРезультат: Выбранный компонент / предложение.\\nОтказ: Нет подходящего предложения.\" text=\"1. Выбрать группу и поставщика.\\n2. Просмотреть цены и остатки.\\n3. Выбрать компонент для состава.\\nРезультат: Выбранный компонент / предложение.\\nОтказ: Нет подходящего предложения.\"\nview v_dialog_developer_catalog_body \"\" diagram=dialog_developer element=dialog_developer_catalog_body\nlink link_36 \"\" from=menu_developer kind=directed to=dialog_developer_catalog\nview v_link_36 \"\" diagram=dialog_developer element=link_36 from=v_menu_developer to=v_dialog_developer_catalog\nblock dialog_developer_compose \"\" role=generic shape=rectangle\nview v_dialog_developer_compose \"\" diagram=dialog_developer element=dialog_developer_compose\nlabel dialog_developer_compose_title \"2. Сформировать состав\" text=\"2. Сформировать состав\"\nview v_dialog_developer_compose_title \"\" diagram=dialog_developer element=dialog_developer_compose_title\nblock dialog_developer_compose_rule \"\" role=generic shape=rectangle\nview v_dialog_developer_compose_rule \"\" diagram=dialog_developer element=dialog_developer_compose_rule\nlabel dialog_developer_compose_body \"1. Выбрать конфигурацию.\\n2. Добавить позиции и количества.\\n3. Указать предложения.\\nРезультат: Рабочий состав конфигурации.\\nОтказ: Неверное количество / пустая позиция.\" text=\"1. Выбрать конфигурацию.\\n2. Добавить позиции и количества.\\n3. Указать предложения.\\nРезультат: Рабочий состав конфигурации.\\nОтказ: Неверное количество / пустая позиция.\"\nview v_dialog_developer_compose_body \"\" diagram=dialog_developer element=dialog_developer_compose_body\nlink link_37 \"\" from=menu_developer kind=directed to=dialog_developer_compose\nview v_link_37 \"\" diagram=dialog_developer element=link_37 from=v_menu_developer to=v_dialog_developer_compose\nblock dialog_developer_check \"\" role=generic shape=rectangle\nview v_dialog_developer_check \"\" diagram=dialog_developer element=dialog_developer_check\nlabel dialog_developer_check_title \"3. Проверить совместимость\" text=\"3. Проверить совместимость\"\nview v_dialog_developer_check_title \"\" diagram=dialog_developer element=dialog_developer_check_title\nblock dialog_developer_check_rule \"\" role=generic shape=rectangle\nview v_dialog_developer_check_rule \"\" diagram=dialog_developer element=dialog_developer_check_rule\nlabel dialog_developer_check_body \"1. Открыть выбранный состав.\\n2. Нажать «Проверить состав».\\n3. Просмотреть результат проверки.\\nРезультат: Совместимость подтверждена.\\nОтказ: Перечень несовместимых позиций.\" text=\"1. Открыть выбранный состав.\\n2. Нажать «Проверить состав».\\n3. Просмотреть результат проверки.\\nРезультат: Совместимость подтверждена.\\nОтказ: Перечень несовместимых позиций.\"\nview v_dialog_developer_check_body \"\" diagram=dialog_developer element=dialog_developer_check_body\nlink link_38 \"\" from=menu_developer kind=directed to=dialog_developer_check\nview v_link_38 \"\" diagram=dialog_developer element=link_38 from=v_menu_developer to=v_dialog_developer_check\nblock dialog_developer_version \"\" role=generic shape=rectangle\nview v_dialog_developer_version \"\" diagram=dialog_developer element=dialog_developer_version\nlabel dialog_developer_version_title \"4. Сохранить версию состава\" text=\"4. Сохранить версию состава\"\nview v_dialog_developer_version_title \"\" diagram=dialog_developer element=dialog_developer_version_title\nblock dialog_developer_version_rule \"\" role=generic shape=rectangle\nview v_dialog_developer_version_rule \"\" diagram=dialog_developer element=dialog_developer_version_rule\nlabel dialog_developer_version_body \"1. Выбрать проверенный состав.\\n2. Подтвердить сохранение.\\n3. Просмотреть номер новой версии.\\nРезультат: Новая версия состава.\\nОтказ: Состав не прошёл проверку.\" text=\"1. Выбрать проверенный состав.\\n2. Подтвердить сохранение.\\n3. Просмотреть номер новой версии.\\nРезультат: Новая версия состава.\\nОтказ: Состав не прошёл проверку.\"\nview v_dialog_developer_version_body \"\" diagram=dialog_developer element=dialog_developer_version_body\nlink link_39 \"\" from=menu_developer kind=directed to=dialog_developer_version\nview v_link_39 \"\" diagram=dialog_developer element=link_39 from=v_menu_developer to=v_dialog_developer_version\ndiagram dialog_director \"Сценарий диалога — генеральный директор\" type=general\nblock login_director \"Вход в систему\\nЛогин и пароль\" role=generic shape=rectangle\nview v_login_director \"\" diagram=dialog_director element=login_director\nblock menu_director \"Главное меню\\nГенеральный директор\\nВыбор задачи\" role=generic shape=rectangle\nview v_menu_director \"\" diagram=dialog_director element=menu_director\nlink link_40 \"\" from=login_director kind=directed to=menu_director\nview v_link_40 \"\" diagram=dialog_director element=link_40 from=v_login_director to=v_menu_director\nblock dialog_director_summary \"\" role=generic shape=rectangle\nview v_dialog_director_summary \"\" diagram=dialog_director element=dialog_director_summary\nlabel dialog_director_summary_title \"1. Просмотреть сводку карточек\" text=\"1. Просмотреть сводку карточек\"\nview v_dialog_director_summary_title \"\" diagram=dialog_director element=dialog_director_summary_title\nblock dialog_director_summary_rule \"\" role=generic shape=rectangle\nview v_dialog_director_summary_rule \"\" diagram=dialog_director element=dialog_director_summary_rule\nlabel dialog_director_summary_body \"1. Открыть список карточек.\\n2. Задать фильтр по состоянию.\\n3. Выбрать карточку из результата.\\nРезультат: Сводка по выбранному состоянию.\\nОтказ: Нет карточек по фильтру.\" text=\"1. Открыть список карточек.\\n2. Задать фильтр по состоянию.\\n3. Выбрать карточку из результата.\\nРезультат: Сводка по выбранному состоянию.\\nОтказ: Нет карточек по фильтру.\"\nview v_dialog_director_summary_body \"\" diagram=dialog_director element=dialog_director_summary_body\nlink link_41 \"\" from=menu_director kind=directed to=dialog_director_summary\nview v_link_41 \"\" diagram=dialog_director element=link_41 from=v_menu_director to=v_dialog_director_summary\nblock dialog_director_inspect \"\" role=generic shape=rectangle\nview v_dialog_director_inspect \"\" diagram=dialog_director element=dialog_director_inspect\nlabel dialog_director_inspect_title \"2. Проверить цену и состав\" text=\"2. Проверить цену и состав\"\nview v_dialog_director_inspect_title \"\" diagram=dialog_director element=dialog_director_inspect_title\nblock dialog_director_inspect_rule \"\" role=generic shape=rectangle\nview v_dialog_director_inspect_rule \"\" diagram=dialog_director element=dialog_director_inspect_rule\nlabel dialog_director_inspect_body \"1. Выбрать карточку и ревизию.\\n2. Открыть состав и расчёт.\\n3. Проверить цену и готовность.\\nРезультат: Состав и показатели ревизии.\\nОтказ: Недостаточно данных для проверки.\" text=\"1. Выбрать карточку и ревизию.\\n2. Открыть состав и расчёт.\\n3. Проверить цену и готовность.\\nРезультат: Состав и показатели ревизии.\\nОтказ: Недостаточно данных для проверки.\"\nview v_dialog_director_inspect_body \"\" diagram=dialog_director element=dialog_director_inspect_body\nlink link_42 \"\" from=menu_director kind=directed to=dialog_director_inspect\nview v_link_42 \"\" diagram=dialog_director element=link_42 from=v_menu_director to=v_dialog_director_inspect\nblock dialog_director_approve \"\" role=generic shape=rectangle\nview v_dialog_director_approve \"\" diagram=dialog_director element=dialog_director_approve\nlabel dialog_director_approve_title \"3. Утвердить готовую ревизию\" text=\"3. Утвердить готовую ревизию\"\nview v_dialog_director_approve_title \"\" diagram=dialog_director element=dialog_director_approve_title\nblock dialog_director_approve_rule \"\" role=generic shape=rectangle\nview v_dialog_director_approve_rule \"\" diagram=dialog_director element=dialog_director_approve_rule\nlabel dialog_director_approve_body \"1. Открыть ревизию DRAFT.\\n2. Проверить содержание и изображения.\\n3. Утвердить или вернуть на доработку.\\nРезультат: READY после успешной проверки.\\nОтказ: Ревизия остаётся DRAFT.\" text=\"1. Открыть ревизию DRAFT.\\n2. Проверить содержание и изображения.\\n3. Утвердить или вернуть на доработку.\\nРезультат: READY после успешной проверки.\\nОтказ: Ревизия остаётся DRAFT.\"\nview v_dialog_director_approve_body \"\" diagram=dialog_director element=dialog_director_approve_body\nlink link_43 \"\" from=menu_director kind=directed to=dialog_director_approve\nview v_link_43 \"\" diagram=dialog_director element=link_43 from=v_menu_director to=v_dialog_director_approve\ndiagram structure \"Структурная схема клиентской части\" type=general\nlabel client_title \"Клиентская часть\" text=\"Клиентская часть\"\nview v_client_title \"\" diagram=structure element=client_title\nlabel visual_title \"Визуальные модули\" text=\"Визуальные модули\"\nview v_visual_title \"\" diagram=structure element=visual_title\nlabel logic_title \"Невизуальные модули\" text=\"Невизуальные модули\"\nview v_logic_title \"\" diagram=structure element=logic_title\nblock auth \"Форма входа\" role=generic shape=rectangle\nview v_auth \"\" diagram=structure element=auth\nblock navigation \"Главное меню и навигация\" role=generic shape=rectangle\nview v_navigation \"\" diagram=structure element=navigation\nblock forms \"Представления ролей:\\nменеджер маркетплейса;\\nдизайнер; разработчик;\\nгенеральный директор\" role=generic shape=rectangle\nview v_forms \"\" diagram=structure element=forms\nblock session \"Сеанс и проверка прав\" role=generic shape=rectangle\nview v_session \"\" diagram=structure element=session\nblock validation \"Проверка ввода\\nи сообщения об ошибках\" role=generic shape=rectangle\nview v_validation \"\" diagram=structure element=validation\nblock commands \"Обработчики команд\\nи обновление представлений\" role=generic shape=rectangle\nview v_commands \"\" diagram=structure element=commands\nblock application \"Прикладной сервис:\\nсостав, расчёт, карточки,\\nизображения и публикация\" role=generic shape=rectangle\nview v_application \"\" diagram=structure element=application\nlink link_44 \"\" from=auth kind=directed to=session\nview v_link_44 \"\" diagram=structure element=link_44 from=v_auth to=v_session\nlink link_45 \"\" from=auth kind=directed to=navigation\nview v_link_45 \"\" diagram=structure element=link_45 from=v_auth to=v_navigation\nlink link_46 \"\" from=navigation kind=directed to=forms\nview v_link_46 \"\" diagram=structure element=link_46 from=v_navigation to=v_forms\nlink link_47 \"\" from=forms kind=directed to=validation\nview v_link_47 \"\" diagram=structure element=link_47 from=v_forms to=v_validation\nlink link_48 \"\" from=validation kind=directed to=commands\nview v_link_48 \"\" diagram=structure element=link_48 from=v_validation to=v_commands\nlink link_49 \"\" from=commands kind=bidirectional to=application\nview v_link_49 \"\" diagram=structure element=link_49 from=v_commands to=v_application\nlink link_50 \"\" from=commands kind=directed to=forms\nview v_link_50 \"\" diagram=structure element=link_50 from=v_commands to=v_forms\nlabel result_label Результаты text=Результаты\nview v_result_label \"\" diagram=structure element=result_label\n",
