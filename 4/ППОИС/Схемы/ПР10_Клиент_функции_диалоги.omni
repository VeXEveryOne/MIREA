_engineer_dialog_e_bad \"\" diagram=engineer_dialog element=e_bad\nblock e_select \"Выбрать конфигурацию\\nи исходную версию\" role=generic shape=rectangle\nview v_engineer_dialog_e_select \"\" diagram=engineer_dialog element=e_select\nblock e_edit \"Изменить позиции\\nи количество локально\" role=generic shape=rectangle\nview v_engineer_dialog_e_edit \"\" diagram=engineer_dialog element=e_edit\nblock e_calc \"Проверить и рассчитать\\nPOST /api/calculate\" role=generic shape=rectangle\nview v_engineer_dialog_e_calc \"\" diagram=engineer_dialog element=e_calc\nblock e_ok \"Расчёт\\nуспешен?\" role=generic shape=diamond\nview v_engineer_dialog_e_ok \"\" diagram=engineer_dialog element=e_ok\nblock e_error \"422 · Причина ошибки\\nВернуться к составу\" role=generic shape=rectangle\nview v_engineer_dialog_e_error \"\" diagram=engineer_dialog element=e_error\nblock e_result \"Показать позиции\\nцену и массу\" role=generic shape=rectangle\nview v_engineer_dialog_e_result \"\" diagram=engineer_dialog element=e_result\nblock e_next \"Перейти к сохранению\\nновой версии\" role=generic shape=rounded\nview v_engineer_dialog_e_next \"\" diagram=engineer_dialog element=e_next\nlink e1 \"\" from=e_login kind=directed to=e_auth\nview v_engineer_dialog_e1 \"\" diagram=engineer_dialog element=e1 from=v_engineer_dialog_e_login to=v_engineer_dialog_e_auth\nlink e2 Да from=e_auth kind=directed to=e_select\nview v_engineer_dialog_e2 \"\" diagram=engineer_dialog element=e2 from=v_engineer_dialog_e_auth to=v_engineer_dialog_e_select\nlink e3 Нет from=e_auth kind=directed to=e_bad\nview v_engineer_dialog_e3 \"\" diagram=engineer_dialog element=e3 from=v_engineer_dialog_e_auth to=v_engineer_dialog_e_bad\nlink e4 Исправить from=e_bad kind=directed to=e_login\nview v_engineer_dialog_e4 \"\" diagram=engineer_dialog element=e4 from=v_engineer_dialog_e_bad to=v_engineer_dialog_e_login\nlink e5 \"\" from=e_select kind=directed to=e_edit\nview v_engineer_dialog_e5 \"\" diagram=engineer_dialog element=e5 from=v_engineer_dialog_e_select to=v_engineer_dialog_e_edit\nlink e6 \"\" from=e_edit kind=directed to=e_calc\nview v_engineer_dialog_e6 \"\" diagram=engineer_dialog element=e6 from=v_engineer_dialog_e_edit to=v_engineer_dialog_e_calc\nlink e7 \"\" from=e_calc kind=directed to=e_ok\nview v_engineer_dialog_e7 \"\" diagram=engineer_dialog element=e7 from=v_engineer_dialog_e_calc to=v_engineer_dialog_e_ok\nlink e8 Нет from=e_ok kind=directed to=e_error\nview v_engineer_dialog_e8 \"\" diagram=engineer_dialog element=e8 from=v_engineer_dialog_e_ok to=v_engineer_dialog_e_error\nlink e9 Исправить from=e_error kind=directed to=e_edit\nview v_engineer_dialog_e9 \"\" diagram=engineer_dialog element=e9 from=v_engineer_dialog_e_error to=v_engineer_dialog_e_edit\nlink e10 Да from=e_ok kind=directed to=e_result\nview v_engineer_dialog_e10 \"\" diagram=engineer_dialog element=e10 from=v_engineer_dialog_e_ok to=v_engineer_dialog_e_result\nlink e11 \"\" from=e_result kind=directed to=e_next\nview v_engineer_dialog_e11 \"\" diagram=engineer_dialog element=e11 from=v_engineer_dialog_e_result to=v_engineer_dialog_e_next\ndiagram save_dialog \"Сохранение новой версии инженером\" type=general\nblock s_start \"Сохранить новую версию\\nPOST /api/versions\" role=generic shape=rounded\nview v_save_dialog_s_start \"\" diagram=save_dialog element=s_start\nblock s_guard \"Данные и expected_latest\\nпроверены сервером\" role=generic shape=rectangle\nview v_save_dialog_s_guard \"\" diagram=save_dialog element=s_guard\nblock s_ok \"Запись\\nуспешна?\" role=generic shape=diamond\nview v_save_dialog_s_ok \"\" diagram=save_dialog element=s_ok\nblock s_conflict \"409 · Версия изменена\\nОбновить данные\" role=generic shape=rectangle\nview v_save_dialog_s_conflict \"\" diagram=save_dialog element=s_conflict\nblock s_invalid \"422 · Неверный ввод\\nИсправить состав\" role=generic shape=rectangle\nview v_save_dialog_s_invalid \"\" diagram=save_dialog element=s_invalid\nblock s_state \"Новая версия\\nCHECKED?\" role=generic shape=diamond\nview v_save_dialog_s_state \"\" diagram=save_dialog element=s_state\nblock s_draft \"DRAFT · Причины ошибки\\nИсправить новую версию\" role=generic shape=rectangle\nview v_save_dialog_s_draft \"\" diagram=save_dialog element=s_draft\nblock s_checked \"CHECKED\\nПоказать новую версию\" role=generic shape=rectangle\nview v_save_dialog_s_checked \"\" diagram=save_dialog element=s_checked\nblock s_finish \"Передать номер версии\\nменеджеру для ревизии\" role=generic shape=rounded\nview v_save_dialog_s_finish \"\" diagram=save_dialog element=s_finish\nlink s1 \"\" from=s_start kind=directed to=s_guard\nview v_save_dialog_s1 \"\" diagram=save_dialog element=s1 from=v_save_dialog_s_start to=v_save_dialog_s_guard\nlink s2 \"\" from=s_guard kind=directed to=s_ok\nview v_save_dialog_s2 \"\" diagram=save_dialog element=s2 from=v_save_dialog_s_guard to=v_save_dialog_s_ok\nlink s3 409 from=s_ok kind=directed to=s_conflict\nview v_save_dialog_s3 \"\" diagram=save_dialog element=s3 from=v_save_dialog_s_ok to=v_save_dialog_s_conflict\nlink s4 422 from=s_ok kind=directed to=s_invalid\nview v_save_dialog_s4 \"\" diagram=save_dialog element=s4 from=v_save_dialog_s_ok to=v_save_dialog_s_invalid\nlink s5 200 from=s_ok kind=directed to=s_state\nview v_save_dialog_s5 \"\" diagram=save_dialog element=s5 from=v_save_dialog_s_ok to=v_save_dialog_s_state\nlink s6 Нет from=s_state kind=directed to=s_draft\nview v_save_dialog_s6 \"\" diagram=save_dialog element=s6 from=v_save_dialog_s_state to=v_save_dialog_s_draft\nlink s7 Да from=s_state kind=directed to=s_checked\nview v_save_dialog_s7 \"\" diagram=save_dialog element=s7 from=v_save_dialog_s_state to=v_save_dialog_s_checked\nlink s8 \"\" from=s_checked kind=directed to=s_finish\nview v_save_dialog_s8 \"\" diagram=save_dialog element=s8 from=v_save_dialog_s_checked to=v_save_dialog_s_finish\ndiagram manager_dialog \"Диалог менеджера создания ревизии\" type=general\nblock m_select \"Вход менеджера\\nВыбрать карточку и версию\" role=generic shape=rounded\nview v_manager_dialog_m_select \"\" diagram=manager_dialog element=m_select\nblock m_checked \"Версия\\nCHECKED или\\nFROZEN?\" role=generic shape=diamond\nview v_manager_dialog_m_checked \"\" diagram=manager_dialog element=m_checked\nblock m_disabled \"DRAFT\\nСохранение недоступно\" role=generic shape=rectangle\nview v_manager_dialog_m_disabled \"\" diagram=manager_dialog element=m_disabled\nblock m_form \"Заполнить название и описание\\nи экономические параметры\" role=generic shape=rectangle\nview v_manager_dialog_m_form \"\" diagram=manager_dialog element=m_form\nblock m_save \"Сохранить новую ревизию\\nPOST /api/revisions\" role=generic shape=rectangle\nview v_manager_dialog_m_save \"\" diagram=manager_dialog element=m_save\nblock m_ok \"Сервер\\nсохранил?\" role=generic shape=diamond\nview v_manager_dialog_m_ok \"\" diagram=manager_dialog element=m_ok\nblock m_error \"409 / 422 · Ошибка\\nОбновить или исправить\" role=generic shape=rectangle\nview v_manager_dialog_m_error \"\" diagram=manager_dialog element=m_error\nblock m_success \"Новая ревизия DRAFT\\nБез отправки\" role=generic shape=rounded\nview v_manager_dialog_m_success \"\" diagram=manager_dialog element=m_success\nlink m1 \"\" from=m_select kind=directed to=m_checked\nview v_manager_dialog_m1 \"\" diagram=manager_dialog element=m1 from=v_manager_dialog_m_select to=v_manager_dialog_m_checked\nlink m2 Нет from=m_checked kind=directed to=m_disabled\nview v_manager_dialog_m2 \"\" diagram=manager_dialog element=m2 from=v_manager_dialog_m_checked to=v_manager_dialog_m_disabled\nlink m3 \"Выбрать другую\" from=m_disabled kind=directed to=m_select\nview v_manager_dialog_m3 \"\" diagram=manager_dialog element=m3 from=v_manager_dialog_m_disabled to=v_manager_dialog_m_select\nlink m4 Да from=m_checked kind=directed to=m_form\nview v_manager_dialog_m4 \"\" diagram=manager_dialog element=m4 from=v_manager_dialog_m_checked to=v_manager_dialog_m_form\nlink m5 \