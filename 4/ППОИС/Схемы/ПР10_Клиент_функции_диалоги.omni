  "source": "scheme ppois_client_02 \"Клиент ИС Юкомс версия 0.2\"\nblock client \"Клиент ИС Юкомс\\nВерсия 0.2\" role=generic shape=rectangle\nblock main \"Основные\\nфункции\" role=generic shape=rectangle\nblock service \"Служебные\\nфункции\" role=generic shape=rectangle\nblock B1 \"B1 · Просмотр групп компонентов и предложений\" role=generic shape=rectangle\nblock B2 \"B2 · Просмотр конфигураций и версий состава\" role=generic shape=rectangle\nblock B3 \"B3 · Сохранение новой версии состава\" role=generic shape=rectangle\nblock B4 \"B4 · Подбор и проверка, расчёт цены и массы\" role=generic shape=rectangle\nblock B5 \"B5 · Просмотр карточек и расчётных ревизий\" role=generic shape=rectangle\nblock B6 \"B6 · Создание новой расчётной ревизии DRAFT\" role=generic shape=rectangle\nblock B7 \"B7 · Просмотр сохранённых результатов попыток\" role=generic shape=rectangle\nblock S1 \"S1 · Демонстрационный вход\" role=generic shape=rectangle\nblock S2 \"S2 · Выход и завершение сеанса\" role=generic shape=rectangle\nblock S3 \"S3 · Проверка сеанса и доступных функций\" role=generic shape=rectangle\nblock S4 \"S4 · Диагностика локального стенда\" role=generic shape=rectangle\nblock S5 \"S5 · Инструкция и границы версии\" role=generic shape=rectangle\nblock function_group_0 Каталог role=generic shape=rectangle\nblock function_group_1 Состав role=generic shape=rectangle\nblock function_group_2 Расчёты role=generic shape=rectangle\nblock function_group_3 Карточки role=generic shape=rectangle\nblock function_group_4 Публикации role=generic shape=rectangle\nblock function_group_5 Сеанс role=generic shape=rectangle\nblock function_group_6 Доступ role=generic shape=rectangle\nblock function_group_7 Сопровождение role=generic shape=rectangle\nblock function_group_8 Справка role=generic shape=rectangle\ndiagram overview \"Корень дерева функций\" type=general\nview v_overview_client \"\" diagram=overview element=client\nview v_overview_main \"\" diagram=overview element=main\nview v_