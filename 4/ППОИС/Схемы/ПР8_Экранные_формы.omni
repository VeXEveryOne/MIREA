 element=text_172\nlabel text_173 \"Конфигурация / версия\" text=\"Конфигурация / версия\"\nview v_text_173 \"\" diagram=revision element=text_173\nblock box_174 \"\" role=generic shape=rectangle\nview v_box_174 \"\" diagram=revision element=box_174\nlabel text_175 \"AM5-OFFICE / версия 1\" text=\"AM5-OFFICE / версия 1\"\nview v_text_175 \"\" diagram=revision element=text_175\nlabel text_176 Заголовок text=Заголовок\nview v_text_176 \"\" diagram=revision element=text_176\nblock box_177 \"\" role=generic shape=rectangle\nview v_box_177 \"\" diagram=revision element=box_177\nlabel text_178 \"Офисный компьютер Юкомс AM5 — Ryzen 5 7600, 32 ГБ DDR5, SSD 1 ТБ\" text=\"Офисный компьютер Юкомс AM5 — Ryzen 5 7600, 32 ГБ DDR5, SSD 1 ТБ\"\nview v_text_178 \"\" diagram=revision element=text_178\nlabel text_179 Описание text=Описание\nview v_text_179 \"\" diagram=revision element=text_179\nblock box_180 \"\" role=generic shape=rectangle\nview v_box_180 \"\" diagram=revision element=box_180\nlabel text_181 \"Компьютер для офисных приложений, работы с документами, браузером и видеосвязи. Платформа AM5, двухканальная память DDR5, твердотельный накопитель M.2. Комплект: системный блок и кабель питания. Монитор и периферия приобретаются отдельно.\" text=\"Компьютер для офисных приложений, работы с документами, браузером и видеосвязи. Платформа AM5, двухканальная память DDR5, твердотельный накопитель M.2. Комплект: системный блок и кабель питания. Монитор и периферия приобретаются отдельно.\"\nview v_text_181 \"\" diagram=revision element=text_181\nlabel text_182 \"Наценка / комиссия\" text=\"Наценка / комиссия\"\nview v_text_182 \"\" diagram=revision element=text_182\nblock box_183 \"\" role=generic shape=rectangle\nview v_box_183 \"\" diagram=revision element=box_183\nlabel text_184 \"20 % / 15 %\" text=\"20 % / 15 %\"\nview v_text_184 \"\" diagram=revision element=text_184\nlabel text_185 \"Сборка / упаковка / логистика\" text=\"Сборка / упаковка / логистика\"\nview v_text_185 \"\"