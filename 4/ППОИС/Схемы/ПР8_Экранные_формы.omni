xt_398\nblock box_399 \"\" role=generic shape=rectangle\nview v_box_399 \"\" diagram=card element=box_399\nlabel text_400 \"32 ГБ DDR5 (2 × 16 ГБ)\" text=\"32 ГБ DDR5 (2 × 16 ГБ)\"\nview v_text_400 \"\" diagram=card element=text_400\nblock box_401 \"\" role=generic shape=rectangle\nview v_box_401 \"\" diagram=card element=box_401\nlabel text_402 Накопитель text=Накопитель\nview v_text_402 \"\" diagram=card element=text_402\nblock box_403 \"\" role=generic shape=rectangle\nview v_box_403 \"\" diagram=card element=box_403\nlabel text_404 \"1 ТБ M.2\" text=\"1 ТБ M.2\"\nview v_text_404 \"\" diagram=card element=text_404\nblock box_405 \"\" role=generic shape=rectangle\nview v_box_405 \"\" diagram=card element=box_405\nlabel text_406 \"Графика / питание\" text=\"Графика / питание\"\nview v_text_406 \"\" diagram=card element=text_406\nblock box_407 \"\" role=generic shape=rectangle\nview v_box_407 \"\" diagram=card element=box_407\nlabel text_408 \"Встроенная графика процессора / 650 Вт\" text=\"Встроенная графика процессора / 650 Вт\"\nview v_text_408 \"\" diagram=card element=text_408\nlabel text_409 \"Компьютер для офисных приложений, работы с документами, браузером и видеосвязи. Платформа AM5, двухканальная память DDR5, твердотельный накопитель M.2. Комплект: системный блок и кабель питания. Монитор и периферия приобретаются отдельно.\" text=\"Компьютер для офисных приложений, работы с документами, браузером и видеосвязи. Платформа AM5, двухканальная память DDR5, твердотельный накопитель M.2. Комплект: системный блок и кабель питания. Монитор и периферия приобретаются отдельно.\"\nview v_text_409 \"\" diagram=card element=text_409\nblock box_410 \"\" role=generic shape=rectangle\nview v_box_410 \"\" diagram=card element=box_410\nlabel text_411 \"Передать на публикацию\" text=\"Передать на публикацию\"\nview v_text_411 \"\" diagram=card element=text_411\n",
