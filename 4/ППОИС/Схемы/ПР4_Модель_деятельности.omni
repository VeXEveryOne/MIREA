  "source": "uml ppois_activity \"Подготовка ревизии для публикации\"\nactivity work \"Подготовить ревизию карточки\"\ndiagram prepare \"Подготовка и проверка конкретного состава\" activity=work type=activity\ndiagram main \"Подготовка содержания и передача на публикацию\" activity=work type=activity\ninitial start \"\" owner=work\nview v_prepare_start \"\" diagram=prepare element=start\nfork split \"\" owner=work\nview v_prepare_split \"\" diagram=prepare element=split\naction compose \"Задать позиции: группа или точная комплектующая\" kind=opaque owner=work\nview v_prepare_compose \"\" diagram=prepare element=compose\naction fetch \"Обновить цены, наличие и время получения предложений\" kind=opaque owner=work\nview v_prepare_fetch \"\" diagram=prepare element=fetch\njoin join \"\" joinSpec=and owner=work\nview v_prepare_join \"\" diagram=prepare element=join\naction resolve \"Выбрать комплектующие и предложения; сохранить черновик BOM\" kind=opaque owner=work\nview v_prepare_resolve \"\" diagram=prepare element=resolve\naction compat \"Проверить совместимость состава\" kind=opaque owner=work\nview v_prepare_compat \"\" diagram=prepare element=compat\ndecision compatible \"Конфликты?\" owner=work\nview v_prepare_compatible \"\" diagram=prepare element=compatible\naction continue \"Подготовить содержание карточки (продолжение на рисунке 6)\" kind=opaque owner=work\nview v_prepare_continue \"\" diagram=prepare element=continue\naction fix_bom \"Показать ошибки; вернуть черновик на доработку\" kind=opaque owner=work\nview v_prepare_fix_bom \"\" diagram=prepare element=fix_bom\nactivityFinal end_ok \"\" owner=work\nview v_prepare_end_ok \"\" diagram=prepare element=end_ok\nactivityFinal end_bad \"\" owner=work\nview v_prepare_end_bad \"\" diagram=prepare element=end_bad\ncontrolFlow prepare_flow1 \"\" from=start owner=work to=split\nview v_prepare_prepare_flow1 \"\" diagram=prepare element=prepare_flow1 from=v_prepare_start to=v_prepare_split\ncontrolFlow prepare_flow2