er=1 owner=r_Revision_Attempt upper=\"*\"\nview v_classes_r_Revision_Attempt \"\" diagram=classes element=r_Revision_Attempt from=v_classes_Revision to=v_classes_Attempt\nactivity work \"Подготовка и публикация карточки\"\ndiagram activity Деятельность activity=work type=activity\nactor manager Менеджер\npartition manager_lane МЕНЕДЖЕР owner=work\nview v_activity_manager_lane \"\" diagram=activity element=manager_lane\nactor developer Разработчик\npartition developer_lane РАЗРАБОТЧИК owner=work\nview v_activity_developer_lane \"\" diagram=activity element=developer_lane\nactor designer Дизайнер\npartition designer_lane ДИЗАЙНЕР owner=work\nview v_activity_designer_lane \"\" diagram=activity element=designer_lane\nactor director \"Генеральный директор\"\npartition director_lane \"ГЕНЕРАЛЬНЫЙ ДИРЕКТОР\" owner=work\nview v_activity_director_lane \"\" diagram=activity element=director_lane\ninitial start \"\" owner=work\nview v_activity_start \"\" diagram=activity element=start parent=v_activity_manager_lane\npartitionMember member_start \"\" element=start owner=manager_lane\naction register \"Создать\\nзадание\" kind=opaque owner=work\nview v_activity_register \"\" diagram=activity element=register parent=v_activity_manager_lane\npartitionMember member_register \"\" element=register owner=manager_lane\nmerge merge_compose \"\" owner=work\nview v_activity_merge_compose \"\" diagram=activity element=merge_compose parent=v_activity_developer_lane\npartitionMember member_merge_compose \"\" element=merge_compose owner=developer_lane\naction compose \"Подготовить\\nсостав\" kind=opaque owner=work\nview v_activity_compose \"\" diagram=activity element=compose parent=v_activity_developer_lane\npartitionMember member_compose \"\" element=compose owner=developer_lane\ndecision valid \"Состав\\nкорректен?\" owner=work\nview v_activity_valid \"\" diagram=activity element=valid parent=v_activity_developer_lane\npartitionMember member_valid \"\" element=valid owner=developer_lane\nmerge merge_prepare \"\" owner=work\nview v_activity_merge_prepare \"\" diagram=activity element=merge_prepare parent=v_activity_manager_lane\npartitionMember member_merge_prepare \"\" element=merge_prepare owner=manager_lane\nfork fork \"\" owner=work\nview v_activity_fork \"\" diagram=activity element=fork parent=v_activity_manager_lane\npartitionMember member_fork \"\" element=fork owner=manager_lane\naction calc \"Рассчитать\\nцену и массу\" kind=opaque owner=work\nview v_activity_calc \"\" diagram=activity element=calc parent=v_activity_manager_lane\npartitionMember member_calc \"\" element=calc owner=manager_lane\naction images \"Подготовить\\nизображения\" kind=opaque owner=work\nview v_activity_images \"\" diagram=activity element=images parent=v_activity_designer_lane\npartitionMember member_images \"\" element=images owner=designer_lane\njoin join \"\" joinSpec=and owner=work\nview v_activity_join \"\" diagram=activity element=join parent=v_activity_manager_lane\npartitionMember member_join \"\" element=join owner=manager_lane\naction create \"Создать\\nревизию\" kind=opaque owner=work\nview v_activity_create \"\" diagram=activity element=create parent=v_activity_manager_lane\npartitionMember member_create \"\" element=create owner=manager_lane\naction review \"Согласовать\\nревизию\" kind=opaque owner=work\nview v_activity_review \"\" diagram=activity element=review parent=v_activity_director_lane\npartitionMember member_review \"\" element=review owner=director_lane\ndecision approved \"Утверждена?\" owner=work\nview v_activity_approved \"\" diagram=activity element=approved parent=v_activity_director_lane\npartitionMember member_approved \"\" element=approved owner=director_lane\naction publish \"Опубликовать\\nревизию\" kind=opaque owner=work\nview v_activity_publish \"\" diagram=activity element=publish parent=v_activity_manager_lane\npartitionMember member_publish \"\" element=publish owner=manager_lane\nactivityFinal final \"\" owner=work\nview v_activity_final \"\" diagram=activity element=final parent=v_activity_manager_lane\npartitionMember member_final \"\" element=final owner=manager_lane\ncontrolFlow f1 \"\" from=start owner=work to=register\nview v_activity_f1 \"\" diagram=activity element=f1 from=v_activity_start to=v_activity_register\ncontrolFlow f2 \"\" from=register owner=work to=merge_compose\nview v_activity_f2 \"\" diagram=activity element=f2 from=v_activity_register to=v_activity_merge_compose\ncontrolFlow f3 \"\" from=merge_compose owner=work to=compose\nview v_activity_f3 \"\" diagram=activity element=f3 from=v_activity_merge_compose to=v_activity_compose\ncontrolFlow f4 \"\" from=compose owner=work to=valid\nview v_activity_f4 \"\" diagram=activity element=f4 from=v_activity_compose to=v_activity_valid\ncontrolFlow f5 \"\" from=valid guard=нет owner=work to=merge_compose\nview v_activity_f5 \"\" diagram=activity element=f5 from=v_activity_valid to=v_activity_merge_compose\ncontrolFlow f6 \"\" from=valid guard=да owner=work to=merge_prepare\nview v_activity_f6 \"\" diagram=activity element=f6 from=v_activity_valid to=v_activity_merge_prepare\ncontrolFlow f7 \"\" from=merge_prepare owner=work to=fork\nview v_activity_f7 \"\" diagram=activity element=f7 from=v_activity_merge_prepare to=v_activity_fork\ncontrolFlow f8 \"\" from=fork owner=work to=calc\nview v_activity_f8 \"\" diagram=activity element=f8 from=v_activity_fork to=v_activity_calc\ncontrolFlow f9 \"\" from=fork owner=work to=images\nview v_activity_f9 \"\" diagram=activity element=f9 from=v_activity_fork to=v_activity_images\ncontrolFlow f10 \"\" from=calc owner=work to=join\nview v_activity_f10 \"\" diagram=activity element=f10 from=v_activity_calc to=v_activity_join\ncontrolFlow f11 \"\" from=images owner=work to=join\nview v_activity_f11 \"\" diagram=activity element=f11 from=v_activity_images to=v_activity_join\ncontrolFlow f12 \"\" from=join owner=work to=create\nview v_activity_f12 \"\" diagram=activity element=f12 from=v_activi