  "source": "uml ppois_design \"Проектирование ИС подготовки карточек ООО «Юкомс»\"\ndatatype UUID UUID primitive=true\ndatatype String String primitive=true\ndatatype Integer Integer primitive=true\ndatatype Decimal Decimal primitive=true\ndatatype DateTime DateTime primitive=true\ndatatype Boolean Boolean primitive=true\ndatatype JSON JSON primitive=true\ndatatype Void Void primitive=true\ndatatype CheckResult CheckResult primitive=true\ndatatype CalculationResult CalculationResult primitive=true\ndatatype PreparedRequest PreparedRequest primitive=true\ndatatype ExternalResult ExternalResult primitive=true\nclass Configuration Конфигурация role=entity\nattribute Configuration_a0 \"id {PK}\" classifier=UUID order=0 owner=Configuration visibility=private\nattribute Configuration_a1 code classifier=String order=1 owner=Configuration visibility=private\noperation Configuration_findAffected findAffected order=0 owner=Configuration visibility=public\nparameter Configuration_findAffected_input data classifier=String direction=in order=0 owner=Configuration_findAffected\nparameter Configuration_findAffected_return \"\" classifier=JSON direction=return order=1 owner=Configuration_findAffected\nclass ModelRangeVersion \"Версия модельного ряда\" role=entity\nattribute ModelRangeVersion_a0 \"id {PK}\" classifier=UUID order=0 owner=ModelRangeVersion visibility=private\nattribute ModelRangeVersion_a1 number classifier=Integer order=1 owner=ModelRangeVersion visibility=private\nattribute ModelRangeVersion_a2 state classifier=String order=2 owner=ModelRangeVersion visibility=private\nattribute ModelRangeVersion_a3 createdAt classifier=DateTime order=3 owner=ModelRangeVersion visibility=private\noperation ModelRangeVersion_getSnapshot getSnapshot order=0 owner=ModelRangeVersion visibility=public\nparameter ModelRangeVersion_getSnapshot_return \"\" classifier=JSON direction=return order=1 owner=ModelRangeVersion_getSnapshot\noperation ModelRangeVersion_markChecked markChecked order