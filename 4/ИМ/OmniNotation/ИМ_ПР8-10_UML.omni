  "source": "// Учебные UML-модели для единого отчёта по информационному менеджменту.\numl im_report_uml \"Информационная система подготовки карточек ООО «Юкомс»\"\ndiagram use_data \"Прецеденты подготовки данных и карточки\" type=usecase\nsystem system_data \"ИС подготовки карточек ООО «Юкомс»\"\nview v_use_data_system_data \"\" diagram=use_data element=system_data\nactor manager Менеджер\nview v_use_data_manager \"\" diagram=use_data element=manager\nactor production Производство\nview v_use_data_production \"\" diagram=use_data element=production\nactor designer Дизайнер\nview v_use_data_designer \"\" diagram=use_data element=designer\nusecase uc01 \"Загрузить исходные данные\" postcondition=\"Результат сохранён в версии карточки\" precondition=\"Пользователь имеет право выполнить действие\"\nsubject uc01_subject \"\" owner=uc01 system=system_data\nview v_use_data_uc01 \"\" diagram=use_data element=uc01 parent=v_use_data_system_data\nusecase uc02 \"Подготовить модельный ряд\" postcondition=\"Результат сохранён в версии карточки\" precondition=\"Пользователь имеет право выполнить действие\"\nsubject uc02_subject \"\" owner=uc02 system=system_data\nview v_use_data_uc02 \"\" diagram=use_data element=uc02 parent=v_use_data_system_data\nusecase uc03 \"Проверить совместимость\" postcondition=\"Результат сохранён в версии карточки\" precondition=\"Пользователь имеет право выполнить действие\"\nsubject uc03_subject \"\" owner=uc03 system=system_data\nview v_use_data_uc03 \"\" diagram=use_data element=uc03 parent=v_use_data_system_data\nusecase uc04 \"Рассчитать цену и массу\" postcondition=\"Результат сохранён в версии карточки\" precondition=\"Пользователь имеет право выполнить действие\"\nsubject uc04_subject \"\" owner=uc04 system=system_data\nview v_use_data_uc04 \"\" diagram=use_data element=uc04 parent=v_use_data_system_data\nusecase uc05 \"Подготовить изображения\" postcondition=\"Результат сохранён в версии карточки\" precondition=\"Пользователь имеет право выполнить действие\"\nsubject uc05_subject \"\" owner=uc05 system=system_data\nview v_use_data_uc05 \"\" diagram=use_data element=uc05 parent=v_use_data_system_data\nusecase uc06 \"Сформировать карточку\" postcondition=\"Результат сохранён в версии карточки\" precondition=\"Пользователь имеет право выполнить действие\"\nsubject uc06_subject \"\" owner=uc06 system=system_data\nview v_use_data_uc06 \"\" diagram=use_data element=uc06 parent=v_use_data_system_data\nparticipation p_manager_uc01 \"\" from=manager to=uc01\nview v_use_data_p_manager_uc01 \"\" diagram=use_data element=p_manager_uc01 from=v_use_data_manager to=v_use_data_uc01\nparticipation p_manager_uc04 \"\" from=manager to=uc04\nview v_use_data_p_manager_uc04 \"\" diagram=use_data element=p_manager_uc04 from=v_use_data_manager to=v_use_data_uc04\nparticipation p_manager_uc06 \"\" from=manager to=uc06\nview v_use_data_p_manager_uc06 \"\" diagram=use_data element=p_manager_uc06 from=v_use_data_manager to=v_use_data_uc06\nparticipation p_production_uc02 \"\" from=production to=uc02\nview v_use_data_p_production_uc02 \"\" diagram=use_data element=p_production_uc02 from=v_use_data_production to=v_use_data_uc02\nparticipation p_production_uc03 \"\" from=production to=uc03\nview v_use_data_p_production_uc03 \"\" diagram=use_data element=p_production_uc03 from=v_use_data_production to=v_use_data_uc03\nparticipation p_designer_uc05 \"\" from=designer to=uc05\nview v_use_data_p_designer_uc05 \"\" diagram=use_data element=p_designer_uc05 from=v_use_data_designer to=v_use_data_uc05\ndiagram use_publish \"Прецеденты публикации, контроля и доступа\" type=usecase\nsystem system_publish \"ИС подготовки карточек ООО «Юкомс»\"\nview v_use_publish_system_publish \"\" diagram=use_publish element=system_publish\nactor publisher Менеджер\nview v_use_publish_publisher \"\" diagram=use_publish element=publisher\nactor director Директор\nview v_use_publish_director \"\" diagram=use_publish element=director\nactor ozon Ozon\nview v_use_