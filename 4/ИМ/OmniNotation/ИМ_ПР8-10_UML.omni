ents_importer \"\" diagram=components element=importer\ncomponent access \"Контроль доступа и аудит\" description=\"Пользователи, роли и события аудита\"\nview v_components_access \"\" diagram=components element=access\ncomponent repository \"Репозиторий данных\" description=\"PostgreSQL и хранилище файлов\"\nview v_components_repository \"\" diagram=components element=repository\ncomponent ozon_adapter \"Адаптер Ozon\" description=\"Передача пакета и получение статуса\"\nview v_components_ozon_adapter \"\" diagram=components element=ozon_adapter\ndependency c_web_services \"Команды и запросы\" from=web to=services\nview v_components_c_web_services \"\" diagram=components element=c_web_services from=v_components_web to=v_components_services\ndependency c_import_services \"Нормализованные данные\" from=importer to=services\nview v_components_c_import_services \"\" diagram=components element=c_import_services from=v_components_importer to=v_components_services\ndependency c_services_access \"Проверка прав\" from=services to=access\nview v_components_c_services_access \"\" diagram=components element=c_services_access from=v_components_services to=v_components_access\ndependency c_services_repo \"Чтение и запись\" from=services to=repository\nview v_components_c_services_repo \"\" diagram=components element=c_services_repo from=v_components_services to=v_components_repository\ndependency c_services_ozon \"Пакеты публикации\" from=services to=ozon_adapter\nview v_components_c_services_ozon \"\" diagram=components element=c_services_ozon from=v_components_services to=v_components_ozon_adapter\ndependency c_access_repo \"Пользователи и аудит\" from=access to=repository\nview v_components_c_access_repo \"\" diagram=components element=c_access_repo from=v_components_access to=v_components_repository\n",
