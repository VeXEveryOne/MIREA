      {
        "id": "wp1_1",
        "kind": "task",
        "label": "Обследование и модель «как есть»",
        "properties": {
          "kind": "task",
          "order": "0",
          "parent": "stage1",
          "sourceDocumentId": "im_wbs",
          "sourceNodeId": "wp1_1",
          "wbsCode": "1.1",
          "duration": "5",
          "effortHours": "32",
          "deliverable": "Согласованный реестр, примеры файлов и исходные метрики.",
          "description": "Недельный ориентир: Н1 / 1–5. Проверка границ, источников и потоков; замер базы. Старт проекта."
        }
      },
      {
        "id": "wp1_2",
        "kind": "task",
        "label": "Требования и критерии приёмки",
        "properties": {
          "kind": "task",
          "order": "1",
          "parent": "stage1",
          "sourceDocumentId": "im_wbs",
          "sourceNodeId": "wp1_2",
          "wbsCode": "1.2",
          "duration": "5",
          "effortHours": "40",
          "deliverable": "Версия требований и список исключений из первой поставки.",
          "description": "Недельный ориентир: Н2 / 6–10. FURPS+, сценарии, приоритеты и критерии приёмки. После 1.1."
        }
      },
      {
        "id": "wp2_1",
        "kind": "task",
        "label": "Модель данных и версий",
        "properties": {
          "kind": "task",
          "order": "0",
          "parent": "stage2",
          "sourceDocumentId": "im_wbs",
          "sourceNodeId": "wp2_1",
          "wbsCode": "2.1",
          "duration": "5",
          "effortHours": "32",
          "deliverable": "Модель данных и проверочные примеры миграции.",
          "description": "Недельный ориентир: Н3 / 11–15. Сущности, версии, связи и ограничения целостности. После 1.2."
        }
      },
      {
        "id": "wp2_2",
        "kind": "task",
        "label": "Проект интерфейсов и правил",
        "properties": {
          "kind": "task",
          "order": "1",
          "parent": "stage2",
          "sourceDocumentId": "im_wbs",
          "sourceNodeId": "wp2_2",
          "wbsCode": "2.2",
          "duration": "10",
          "effortHours": "40",
          "deliverable": "Согласованные макеты и контрактные примеры.",
          "description": "Недельный ориентир: Н3–Н4 / 11–20. Экран карточки, правила, форматы импорта и контракты адаптера. После 1.2; параллельно 2.1."
        }
      },
      {
        "id": "wp3_1",
        "kind": "task",
        "label": "Справочники и модельный ряд",
        "properties": {
          "kind": "task",
          "order": "0",
          "parent": "stage3",
          "sourceDocumentId": "im_wbs",
          "sourceNodeId": "wp3_1",
          "wbsCode": "3.1",
          "duration": "15",
          "effortHours": "56",
          "deliverable": "Версионирование и обнаружение критических ошибок.",
          "description": "Недельный ориентир: Н4–Н6 / 16–30. Справочники, составы, согласование и совместимость. После 2.1; уточнения 2.2 до конца Н4."
        }
      },
      {
        "id": "wp3_2",
        "kind": "task",
        "label": "Расчёты и карточки",
        "properties": {
          "kind": "task",
          "order": "1",
          "parent": "stage3",
          "sourceDocumentId": "im_wbs",
          "sourceNodeId": "wp3_2",
          "wbsCode": "3.2",
          "duration": "10",
          "effortHours": "48",
          "deliverable": "Карточка воспроизводится по сохранённым исходным данным.",
        "description": "Недельный ориентир: Н6–Н7 / 26–35. Цена, масса, изображения, характеристики и пакет карточки. Рабочая версия модельного ряда передаётся в начале Н6."
        }
      },
      {
        "id": "wp3_3",
        "kind": "task",
        "label": "Обмен и аудит",
        "properties": {
          "kind": "task",
          "order": "2",
          "parent": "stage3",
          "sourceDocumentId": "im_wbs",
          "sourceNodeId": "wp3_3",
          "wbsCode": "3.3",
          "duration": "10",
          "effortHours": "48",
          "deliverable": "Прослеживается путь от источника до результата отправки.",
          "description": "Недельный ориентир: Н7–Н8 / 31–40. Импорт, передача, статусы, повторы, аудит и права. Контракт карточки готов к началу Н7."
        }
      },
      {
        "id": "wp4_1",
        "kind": "task",
        "label": "Интеграционные испытания",
        "properties": {
          "kind": "task",
          "order": "0",
          "parent": "stage4",
          "sourceDocumentId": "im_wbs",
          "sourceNodeId": "wp4_1",
          "wbsCode": "4.1",
          "duration": "5",
          "effortHours": "56",
          "deliverable": "Протокол без блокирующих дефектов, выполненные критерии.",
          "description": "Недельный ориентир: Н9 / 41–45. Проверка функций, нагрузка, сбои и восстановление. После 3.1–3.3."
        }
      },
      {
        "id": "wp4_2",
        "kind": "task",
