    "label": "План реализации ИС · Н1–Н12",
    "elements": [
      {
        "id": "weekdays",
        "kind": "calendar",
        "label": "Пятидневная неделя",
        "properties": {
          "hoursPerDay": "8",
          "monday": "true",
          "tuesday": "true",
          "wednesday": "true",
          "thursday": "true",
          "friday": "true",
          "saturday": "false",
          "sunday": "false"
        }
      },
      {
        "id": "plan",
        "kind": "plan",
        "label": "План проекта",
        "properties": {
          "start": "2026-09-28",
          "calendar": "weekdays",
          "mode": "auto",
          "description": "Отчёт ИМ: таблицы 11.1–11.3 и 3.7. Н1–Н12 — первичный ориентир. 28.09.2026 — только демонстрационный старт пятидневного календаря без автоматически добавленных праздников. Не фактическая дата проекта. Часы распределены равномерно; доступность разработчика ограничена 40 ч/нед. Максимальная расчётная загрузка составляет 36 ч/нед.",
          "sourceDocumentId": "im_wbs"
        }
      },
      {
        "id": "main",
        "kind": "diagram",
        "label": "План проекта",
        "properties": {
          "type": "gantt",
          "plan": "plan"
        }
      },
      {
