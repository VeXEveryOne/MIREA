      {
        "id": "components",
        "kind": "diagram",
        "label": "ИМ · Компоненты и общие интерфейсы",
        "properties": {
          "type": "component"
        }
      },
      {
        "id": "web",
        "kind": "component",
        "label": "Веб-интерфейс",
        "properties": {
          "description": "Экран карточки, формы импорта, модельный ряд, изображений и отчётов; HTTPS API. Вызывает прикладные сервисы; U-01–U-03. Не содержит единственного экземпляра предметных правил. Источник: таблица 10.2."
        }
      },
      {
        "id": "services",
        "kind": "component",
        "label": "Прикладные сервисы",
        "properties": {
          "description": "Component, ModelRangeVersion, Card, PublicationAttempt; команды и запросы. Используют IAccess и IRepository; F-01–F-11. Выполняют расчёты и проверку состояния. Источник: таблица 10.2."
        }
      },
      {
        "id": "access",
        "kind": "component",
        "label": "Контроль доступа и аудит",
        "properties": {
          "description": "User, Role, AuditEvent; IAccess. Проверяет роли для каждой операции и фиксирует события; F-10, F-12. Хранение через общий репозиторий. Источник: таблица 10.2."
        }
      },
      {
        "id": "repository",
        "kind": "component",
        "label": "Репозиторий данных",
        "properties": {
          "description": "IRepository: загрузка сущностей, транзакции, выборки и фиксация версий. Реляционная БД и файловые объекты; R-01, R-02. Не зависит от формата Ozon. Источник: таблица 10.2."
        }
      },
      {
        "id": "importer",
        "kind": "component",
        "label": "Импорт источников",
        "properties": {
          "description": "SupplierOffer, StockSnapshot; проверка файла и нормализованные записи. Передаёт корректные значения прикладным сервисам; F-01, S-02. Источник: таблица 10.2."
        }
      },
      {
        "id": "ozonAdapter",
        "kind": "component",
        "label": "Адаптер Ozon",
        "properties": {
          "description": "IPublisher: отправка пакета, получение результата, перевод ошибок. Вызывается прикладными сервисами; внешний защищённый интерфейс; F-08, F-09, R-03. Источник: таблица 10.2."
        }
      },
      {
        "id": "iAccess",
        "kind": "interface",
        "label": "IAccess",
        "properties": {}
      },
