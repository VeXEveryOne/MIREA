          "from": "ready",
          "to": "saveAttempt",
          "guard": "да"
        }
      },
      {
        "id": "flow5",
        "kind": "controlFlow",
        "label": "",
        "properties": {
          "owner": "publish",
          "from": "ready",
          "to": "fix",
          "guard": "else"
        }
      },
