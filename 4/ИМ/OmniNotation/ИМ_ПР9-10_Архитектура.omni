{
  "formatVersion": 2,
  "notation": "UML",
  "profile": "NS-UML-2.5.1-2",
  "model": {
    "id": "im_architecture",
    "label": "ИС подготовки карточек · деятельность и архитектура",
    "elements": [
      {
        "id": "publish",
        "kind": "activity",
        "label": "Подготовить и передать карточку",
        "properties": {
          "precondition": "Менеджер выбрал карточку и имеет право отправки; используется согласованная версия.",
          "postcondition": "Попытка сохранена до внешнего вызова; зафиксирован результат либо ожидание. Исправление завершает текущий сценарий.",
          "description": "Источник: отчёт ИМ, таблицы 9.1–9.3. Учебная модель; guard не исполняется."
        }
      },
      {
        "id": "activity",
        "kind": "diagram",
        "label": "ИМ · Проверка и отправка карточки",
        "properties": {
          "type": "activity",
          "activity": "publish"
        }
      },
      {
        "id": "managerLane",
        "kind": "partition",
        "label": "Менеджер",
        "properties": {
          "owner": "publish"
        }
      },
      {
        "id": "v_activity_managerLane",
        "kind": "view",
        "label": "",
        "properties": {
          "diagram": "activity",
          "element": "managerLane"
        }
      },
      {
        "id": "systemLane",
