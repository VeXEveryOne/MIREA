    ]
  },
  "source": "uml im_architecture \"ИС подготовки карточек · деятельность и архитектура\"\nactivity publish \"Подготовить и передать карточку\" description=\"Источник: отчёт ИМ, таблицы 9.1–9.3. Учебная модель; guard не исполняется.\" postcondition=\"Попытка сохранена до внешнего вызова; зафиксирован результат либо ожидание. Исправление завершает текущий сценарий.\" precondition=\"Менеджер выбрал карточку и имеет право отправки; используется согласованная версия.\"\ndiagram activity \"ИМ · Проверка и отправка карточки\" activity=publish type=activity\npartition managerLane Менеджер owner=publish\nview v_activity_managerLane \"\" diagram=activity element=managerLane\npartition systemLane \"Информационная система\" owner=publish\nview v_activity_systemLane \"\" diagram=activity element=systemLane\npartition ozonLane Ozon owner=publish\nview v_activity_ozonLane \"\" diagram=activity element=ozonLane\ninitial start \"\" owner=publish\npartitionMember responsibility_start \"\" element=start owner=managerLane\nview v_activity_start \"\" diagram=activity element=start parent=v_activity_managerLane\naction selectCard \"Выбрать и подтвердить карточку\" kind=opaque owner=publish\npartitionMember responsibility_selectCard \"\" element=selectCard owner=managerLane\nview v_activity_selectCard \"\" diagram=activity element=selectCard parent=v_activity_managerLane\naction check \"Проверить поля и версии\" kind=opaque owner=publish\npartitionMember responsibility_check \"\" element=check owner=systemLane\nview v_activity_check \"\" diagram=activity element=check parent=v_activity_systemLane\ndecision ready \"Готова?\" owner=publish\npartitionMember responsibility_ready \"\" element=ready owner=systemLane\nview v_activity_ready \"\" diagram=activity element=ready parent=v_activity_systemLane\naction fix \"Исправить замечания\" kind=opaque owner=publish\npartitionMember responsibility_fix \"\" element=fix owner=managerLane\nview v_activity_fix \"\" diagram=activity element=fix parent=v_activity_managerLane\naction saveAttempt \"Сохранить попытку до вызова\" kind=opaque owner=publish\npartitionMember responsibility_saveAttempt \"\" element=saveAttempt owner=systemLane\nview v_activity_saveAttempt \"\" diagram=activity element=saveAttempt parent=v_activity_systemLane\naction send \"Передать пакет\" kind=opaque owner=publish\npartitionMember responsibility_send \"\" element=send owner=systemLane\nview v_activity_send \"\" diagram=activity element=send parent=v_activity_systemLane\naction process \"Принять пакет в обработку\" kind=opaque owner=publish\npartitionMember responsibility_process \"\" element=process owner=ozonLane\nview v_activity_process \"\" diagram=activity element=process parent=v_activity_ozonLane\naction receive \"Получить статус / тайм-аут\" kind=opaque owner=publish\npartitionMember responsibility_receive \"\" element=receive owner=systemLane\nview v_activity_receive \"\" diagram=activity element=receive parent=v_activity_systemLane\ndecision answer \"Итог?\" owner=publish\npartitionMember responsibility_answer \"\" element=answer owner=systemLane\nview v_activity_answer \"\" diagram=activity element=answer parent=v_activity_systemLane\naction waiting \"Сохранить ожидание той же операции\" kind=opaque owner=publish\npartitionMember responsibility_waiting \"\" element=waiting owner=systemLane\nview v_activity_waiting \"\" diagram=activity element=waiting parent=v_activity_systemLane\naction result \"Сохранить итог и замечания\" kind=opaque owner=publish\npartitionMember responsibility_result \"\" element=result owner=systemLane\nview v_activity_result \"\" diagram=activity element=result parent=v_activity_systemLane\nactivityFinal done \"\" owner=publish\npartitionMember responsibility_done \"\" element=done owner=systemLane\nview v_activity_done \"\" diagram=activity element=done parent=v_activity_systemLane\nactivityFinal fixDone \"\" owner=publish\npartitionMember responsibility_fixDone \"\" element=fixDone owner=managerLane\nview v_activity_fixDone \"\" diagram=activity element=fixDone parent=v_activity_managerLane\ncontrolFlow flow1 \"\" from=start owner=publish to=selectCard\ncontrolFlow flow2 \"\" from=selectCard owner=publish to=check\ncontrolFlow flow3 \"\" from=check owner=publish to=ready\ncontrolFlow flow4 \"\" from=ready guard=да owner=publish to=saveAttempt\ncontrolFlow flow5 \"\" from=ready guard=else owner=publish to=fix\ncontrolFlow flow6 \"\" from=fix owner=publish to=fixDone\ncontrolFlow flow7 \"\" from=saveAttempt owner=publish to=send\ncontrolFlow flow8 \"\" from=send owner=publish to=process\ncontrolFlow flow9 \"\" from=process owner=publish to=pollMerge\ncontrolFlow flow10 \"\" from=receive owner=publish to=answer\ncontrolFlow flow11 \"\" from=answer guard=\"итог получен\" owner=publish to=result\ncontrolFlow flow12 \"\" from=answer guard=else owner=publish to=waiting\ncontrolFlow flow13 \"\" from=waiting owner=publish to=waitInterval\ncontrolFlow flow14 \"\" from=result owner=publish to=done\nview v_activity_flow1 \"\" diagram=activity element=flow1 from=v_activity_start to=v_activity_selectCard\nview v_activity_flow2 \"\" diagram=activity element=flow2 from=v_activity_selectCard to=v_activity_check\nview v_activity_flow3 \"\" diagram=activity element=flow3 from=v_activity_check to=v_activity_ready\nview v_activity_flow4 \"\" diagram=activity element=flow4 from=v_activity_ready to=v_activity_saveAttempt\nview v_activity_flow5 \"\" diagram=activity element=flow5 from=v_activity_ready to=v_activity_fix\nview v_activity_flow6 \"\" diagram=activity element=flow6 from=v_activity_fix to=v_activity_fixDone\nview v_activity_flow7 \"\" diagram=activity element=flow7 from=v_activity_saveAttempt to=v_activity_send\nview v_activity_flow8 \"\" diagram=activity element=flow8 from=v_activity_send to=v_activity_process\nview v_activity_flow9 \"\" diagram=activity element=flow9 from=v_activity_process to=v_activity_pollMerge\nview v_activity_flow10 \"\" diagram=activity element=flow10 from=v_activity_receive to=v_activity_answer\nview v_activity_flow11 \"\" diagram=activity element=flow11 from=v_activity_answer to=v_activity_result\nview v_activity_flow12 \"\" diagram=activity element=flow12 from=v_activity_answer to=v_activity_waiting\nview v_activity_flow13 \"\" diagram=activity element=flow13 from=v_activity_waiting to=v_activity_waitInterval\nview v_activity_flow14 \"\" diagram=activity element=flow14 from=v_activity_result to=v_activity_done\ndiagram components \"ИМ · Компоненты и общие интерфейсы\" type=component\ncomponent web Веб-интерфейс description=\"Экран карточки, формы импорта, модельный ряд, изображений и отчётов; HTTPS API. Вызывает прикладные сервисы; U-01–U-03. Не содержит единственного экземпляра предметных правил. Источник: таблица 10.2.\"\ncomponent services \"Прикладные сервисы\" description=\"Component, ModelRangeVersion, Card, PublicationAttempt; команды и запросы. Используют IAccess и IRepository; F-01–F-11. Выполняют расчёты и проверку состояния. Источник: таблица 10.2.\"\ncomponent access \"Контроль доступа и аудит\" description=\"User, Role, AuditEvent; IAccess. Проверяет роли для каждой операции и фиксирует события; F-10, F-12. Хранение через общий репозиторий. Источник: таблица 10.2.\"\ncomponent repository \"Репозиторий данных\" description=\"IRepository: загрузка сущностей, транзакции, выборки и фиксация версий. Реляционная БД и файловые объекты; R-01, R-02. Не зависит от формата Ozon. Источник: таблица 10.2.\"\ncomponent importer \"Импорт источников\" description=\"SupplierOffer, StockSnapshot; проверка файла и нормализованные записи. Передаёт корректные значения прикладным сервисам; F-01, S-02. Источник: таблица 10.2.\"\ncomponent ozonAdapter \"Адаптер Ozon\" description=\"IPublisher: отправка пакета, получение результата, перевод ошибок. Вызывается прикладными сервисами; внешний защищённый интерфейс; F-08, F-09, R-03. Источник: таблица 10.2.\"\ninterface iAccess IAccess\ninterface iRepository IRepository\ninterface iPublisher IPublisher\nview v_components_web \"\" diagram=components element=web\nview v_components_services \"\" diagram=components element=services\nview v_components_importer \"\" diagram=components element=importer\nview v_components_access \"\" diagram=components element=access\nview v_components_repository \"\" diagram=components element=repository\nview v_components_ozonAdapter \"\" diagram=components element=ozonAdapter\nview v_components_iAccess \"\" diagram=components element=iAccess\nview v_components_iRepository \"\" diagram=components element=iRepository\nview v_components_iPublisher \"\" diagram=components element=iPublisher\ndependency webCalls \"Команды и запросы\" from=web to=services\ndependency importCalls \"Нормализованные записи\" from=importer to=services\nrealization provides_access \"\" from=access to=iAccess\nrealization provides_repository \"\" from=repository to=iRepository\nrealization provides_ozonAdapter \"\" from=ozonAdapter to=iPublisher\nusage uses_iAccess \"\" from=services to=iAccess\nusage uses_iRepository \"\" from=services to=iRepository\nusage uses_iPublisher \"\" from=services to=iPublisher\nusage accessUsesRepository \"\" from=access to=iRepository\nview v_components_webCalls \"\" diagram=components element=webCalls from=v_components_web to=v_components_services\nview v_components_importCalls \"\" diagram=components element=importCalls from=v_components_importer to=v_components_services\nview v_components_provides_access \"\" diagram=components element=provides_access from=v_components_access to=v_components_iAccess\nview v_components_provides_repository \"\" diagram=components element=provides_repository from=v_components_repository to=v_components_iRepository\nview v_components_provides_ozonAdapter \"\" diagram=components element=provides_ozonAdapter from=v_components_ozonAdapter to=v_components_iPublisher\nview v_components_uses_iAccess \"\" diagram=components element=uses_iAccess from=v_components_services to=v_components_iAccess\nview v_components_uses_iRepository \"\" diagram=components element=uses_iRepository from=v_components_services to=v_components_iRepository\nview v_components_uses_iPublisher \"\" diagram=components element=uses_iPublisher from=v_components_services to=v_components_iPublisher\nview v_components_accessUsesRepository \"\" diagram=components element=accessUsesRepository from=v_components_access to=v_components_iRepository\ndiagram classes \"ИМ · Классы реализации компонентов\" type=class\nclass classComponent Component description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsComponent \"\" classifier=classComponent owner=services\nview v_classes_classComponent \"\" diagram=classes element=classComponent\nclass classModelRangeVersion ModelRangeVersion description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsModelRangeVersion \"\" classifier=classModelRangeVersion owner=services\nview v_classes_classModelRangeVersion \"\" diagram=classes element=classModelRangeVersion\nclass classCard Card description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsCard \"\" classifier=classCard owner=services\nview v_classes_classCard \"\" diagram=classes element=classCard\nclass classPublicationAttempt PublicationAttempt description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsPublicationAttempt \"\" classifier=classPublicationAttempt owner=services\nview v_classes_classPublicationAttempt \"\" diagram=classes element=classPublicationAttempt\nclass classUser User description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsUser \"\" classifier=classUser owner=access\nview v_classes_classUser \"\" diagram=classes element=classUser\nclass classRole Role description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsRole \"\" classifier=classRole owner=access\nview v_classes_classRole \"\" diagram=classes element=classRole\nclass classAuditEvent AuditEvent description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsAuditEvent \"\" classifier=classAuditEvent owner=access\nview v_classes_classAuditEvent \"\" diagram=classes element=classAuditEvent\nclass classSupplierOffer SupplierOffer description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsSupplierOffer \"\" classifier=classSupplierOffer owner=importer\nview v_classes_classSupplierOffer \"\" diagram=classes element=classSupplierOffer\nclass classStockSnapshot StockSnapshot description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsStockSnapshot \"\" classifier=classStockSnapshot owner=importer\nview v_classes_classStockSnapshot \"\" diagram=classes element=classStockSnapshot\ndiagram deployment \"ИМ · Узлы и размещение артефактов\" type=deployment\ndevice workstation \"Рабочий компьютер\" description=\"Рабочий компьютер. Браузер; интерфейс приложения. Установка отдельного клиента не требуется.. HTTPS к приложению. Пользователь работает под личной учётной записью.\"\nnode server \"Серверная виртуальная машина\" description=\"Серверная виртуальная машина. Приложение и фоновые задачи, PostgreSQL, файлы изображений; ориентир 4 vCPU, 8 ГБ RAM, SSD 100 ГБ.. Принимает клиентские запросы, выполняет расчёты и обмен. Параметры являются стартовой оценкой, не результатом теста.\"\nexecutionEnvironment application \"Среда приложения и фоновых задач\" owner=server technology=\"Серверное приложение\"\nexecutionEnvironment postgres PostgreSQL owner=server technology=PostgreSQL\nnode backupStore \"Отдельное хранилище копий\" description=\"Отдельное хранилище копий. Ежедневные копии БД и файлов, журнал выполнения; доступ только роли резервирования.. Изолировано от рабочего каталога. Восстановление проверяет администратор.\"\nnode externalOzon \"Внешний узел Ozon\" description=\"Внешний узел Ozon. Сервис обработки данных продавца вне управления проектной команды.. Защищённый канал; ограничения интерфейса подтверждаются перед интеграцией.\"\nview v_deployment_workstation \"\" diagram=deployment element=workstation\nview v_deployment_server \"\" diagram=deployment element=server\nview v_deployment_application \"\" diagram=deployment element=application parent=v_deployment_server\nview v_deployment_postgres \"\" diagram=deployment element=postgres parent=v_deployment_server\nview v_deployment_backupStore \"\" diagram=deployment element=backupStore\nview v_deployment_externalOzon \"\" diagram=deployment element=externalOzon\nartifact frontend \"Интерфейс приложения в браузере\" description=\"Учебный тип артефакта по таблицам 10.1–10.3; не фактическая поставленная сборка.\"\ndeployment deploy_frontend \"\" artifact=frontend location=workstation\nmanifestation manifest_frontend \"\" from=frontend to=web\nview v_deployment_frontend \"\" diagram=deployment element=frontend parent=v_deployment_workstation\nartifact appBuild \"Сборка приложения и фоновых задач\" description=\"Учебный тип артефакта по таблицам 10.1–10.3; не фактическая поставленная сборка.\"\ndeployment deploy_appBuild \"\" artifact=appBuild location=application\nmanifestation manifest_appBuild \"\" from=appBuild to=services\nview v_deployment_appBuild \"\" diagram=deployment element=appBuild parent=v_deployment_application\nartifact dbSchema \"Схема БД и миграции\" description=\"Учебный тип артефакта по таблицам 10.1–10.3; не фактическая поставленная сборка.\"\ndeployment deploy_dbSchema \"\" artifact=dbSchema location=postgres\nmanifestation manifest_dbSchema \"\" from=dbSchema to=repository\nview v_deployment_dbSchema \"\" diagram=deployment element=dbSchema parent=v_deployment_postgres\nartifact backups \"Копии БД и файлов\" description=\"Учебный тип артефакта по таблицам 10.1–10.3; не фактическая поставленная сборка.\"\ndeployment deploy_backups \"\" artifact=backups location=backupStore\nmanifestation manifest_backups \"\" from=backups to=repository\nview v_deployment_backups \"\" diagram=deployment element=backups parent=v_deployment_backupStore\ncommunicationPath https \"\" from=workstation port=443 protocol=HTTPS to=application\ncommunicationPath marketplace \"\" from=application protocol=\"Защищённый интерфейс Ozon\" to=externalOzon\ncommunicationPath sql \"\" from=application protocol=\"Доступ к PostgreSQL\" to=postgres\ncommunicationPath backupChannel \"\" from=server protocol=\"Резервирование БД и файлов\" to=backupStore\nview v_deployment_https \"\" diagram=deployment element=https from=v_deployment_workstation to=v_deployment_application\nview v_deployment_marketplace \"\" diagram=deployment element=marketplace from=v_deployment_application to=v_deployment_externalOzon\nview v_deployment_sql \"\" diagram=deployment element=sql from=v_deployment_application to=v_deployment_postgres\nview v_deployment_backupChannel \"\" diagram=deployment element=backupChannel from=v_deployment_server to=v_deployment_backupStore\ndeploymentSetting appSizing \"Стартовая оценка\" key=\"Ресурсы VM\" owner=deploy_appBuild value=\"4 vCPU; 8 ГБ RAM; SSD 100 ГБ — ориентир, не результат испытаний\"\nmerge pollMerge \"\" owner=publish\naction waitInterval \"Дождаться срока следующего опроса\" kind=opaque owner=publish\npartitionMember responsibility_pollMerge \"\" element=pollMerge owner=systemLane\nview v_activity_pollMerge \"\" diagram=activity element=pollMerge parent=v_activity_systemLane\npartitionMember responsibility_waitInterval \"\" element=waitInterval owner=systemLane\nview v_activity_waitInterval \"\" diagram=activity element=waitInterval parent=v_activity_systemLane\ncontrolFlow flow15 \"\" from=pollMerge owner=publish to=receive\nview v_activity_flow15 \"\" diagram=activity element=flow15 from=v_activity_pollMerge to=v_activity_receive\ncontrolFlow flow16 \"\" from=waitInterval owner=publish to=pollMerge\nview v_activity_flow16 \"\" diagram=activity element=flow16 from=v_activity_waitInterval to=v_activity_pollMerge\n",
  "draft": "uml im_architecture \"ИС подготовки карточек · деятельность и архитектура\"\nactivity publish \"Подготовить и передать карточку\" description=\"Источник: отчёт ИМ, таблицы 9.1–9.3. Учебная модель; guard не исполняется.\" postcondition=\"Попытка сохранена до внешнего вызова; зафиксирован результат либо ожидание. Исправление завершает текущий сценарий.\" precondition=\"Менеджер выбрал карточку и имеет право отправки; используется согласованная версия.\"\ndiagram activity \"ИМ · Проверка и отправка карточки\" activity=publish type=activity\npartition managerLane Менеджер owner=publish\nview v_activity_managerLane \"\" diagram=activity element=managerLane\npartition systemLane \"Информационная система\" owner=publish\nview v_activity_systemLane \"\" diagram=activity element=systemLane\npartition ozonLane Ozon owner=publish\nview v_activity_ozonLane \"\" diagram=activity element=ozonLane\ninitial start \"\" owner=publish\npartitionMember responsibility_start \"\" element=start owner=managerLane\nview v_activity_start \"\" diagram=activity element=start parent=v_activity_managerLane\naction selectCard \"Выбрать и подтвердить карточку\" kind=opaque owner=publish\npartitionMember responsibility_selectCard \"\" element=selectCard owner=managerLane\nview v_activity_selectCard \"\" diagram=activity element=selectCard parent=v_activity_managerLane\naction check \"Проверить поля и версии\" kind=opaque owner=publish\npartitionMember responsibility_check \"\" element=check owner=systemLane\nview v_activity_check \"\" diagram=activity element=check parent=v_activity_systemLane\ndecision ready \"Готова?\" owner=publish\npartitionMember responsibility_ready \"\" element=ready owner=systemLane\nview v_activity_ready \"\" diagram=activity element=ready parent=v_activity_systemLane\naction fix \"Исправить замечания\" kind=opaque owner=publish\npartitionMember responsibility_fix \"\" element=fix owner=managerLane\nview v_activity_fix \"\" diagram=activity element=fix parent=v_activity_managerLane\naction saveAttempt \"Сохранить попытку до вызова\" kind=opaque owner=publish\npartitionMember responsibility_saveAttempt \"\" element=saveAttempt owner=systemLane\nview v_activity_saveAttempt \"\" diagram=activity element=saveAttempt parent=v_activity_systemLane\naction send \"Передать пакет\" kind=opaque owner=publish\npartitionMember responsibility_send \"\" element=send owner=systemLane\nview v_activity_send \"\" diagram=activity element=send parent=v_activity_systemLane\naction process \"Принять пакет в обработку\" kind=opaque owner=publish\npartitionMember responsibility_process \"\" element=process owner=ozonLane\nview v_activity_process \"\" diagram=activity element=process parent=v_activity_ozonLane\naction receive \"Получить статус / тайм-аут\" kind=opaque owner=publish\npartitionMember responsibility_receive \"\" element=receive owner=systemLane\nview v_activity_receive \"\" diagram=activity element=receive parent=v_activity_systemLane\ndecision answer \"Итог?\" owner=publish\npartitionMember responsibility_answer \"\" element=answer owner=systemLane\nview v_activity_answer \"\" diagram=activity element=answer parent=v_activity_systemLane\naction waiting \"Сохранить ожидание той же операции\" kind=opaque owner=publish\npartitionMember responsibility_waiting \"\" element=waiting owner=systemLane\nview v_activity_waiting \"\" diagram=activity element=waiting parent=v_activity_systemLane\naction result \"Сохранить итог и замечания\" kind=opaque owner=publish\npartitionMember responsibility_result \"\" element=result owner=systemLane\nview v_activity_result \"\" diagram=activity element=result parent=v_activity_systemLane\nactivityFinal done \"\" owner=publish\npartitionMember responsibility_done \"\" element=done owner=systemLane\nview v_activity_done \"\" diagram=activity element=done parent=v_activity_systemLane\nactivityFinal fixDone \"\" owner=publish\npartitionMember responsibility_fixDone \"\" element=fixDone owner=managerLane\nview v_activity_fixDone \"\" diagram=activity element=fixDone parent=v_activity_managerLane\ncontrolFlow flow1 \"\" from=start owner=publish to=selectCard\ncontrolFlow flow2 \"\" from=selectCard owner=publish to=check\ncontrolFlow flow3 \"\" from=check owner=publish to=ready\ncontrolFlow flow4 \"\" from=ready guard=да owner=publish to=saveAttempt\ncontrolFlow flow5 \"\" from=ready guard=else owner=publish to=fix\ncontrolFlow flow6 \"\" from=fix owner=publish to=fixDone\ncontrolFlow flow7 \"\" from=saveAttempt owner=publish to=send\ncontrolFlow flow8 \"\" from=send owner=publish to=process\ncontrolFlow flow9 \"\" from=process owner=publish to=pollMerge\ncontrolFlow flow10 \"\" from=receive owner=publish to=answer\ncontrolFlow flow11 \"\" from=answer guard=\"итог получен\" owner=publish to=result\ncontrolFlow flow12 \"\" from=answer guard=else owner=publish to=waiting\ncontrolFlow flow13 \"\" from=waiting owner=publish to=waitInterval\ncontrolFlow flow14 \"\" from=result owner=publish to=done\nview v_activity_flow1 \"\" diagram=activity element=flow1 from=v_activity_start to=v_activity_selectCard\nview v_activity_flow2 \"\" diagram=activity element=flow2 from=v_activity_selectCard to=v_activity_check\nview v_activity_flow3 \"\" diagram=activity element=flow3 from=v_activity_check to=v_activity_ready\nview v_activity_flow4 \"\" diagram=activity element=flow4 from=v_activity_ready to=v_activity_saveAttempt\nview v_activity_flow5 \"\" diagram=activity element=flow5 from=v_activity_ready to=v_activity_fix\nview v_activity_flow6 \"\" diagram=activity element=flow6 from=v_activity_fix to=v_activity_fixDone\nview v_activity_flow7 \"\" diagram=activity element=flow7 from=v_activity_saveAttempt to=v_activity_send\nview v_activity_flow8 \"\" diagram=activity element=flow8 from=v_activity_send to=v_activity_process\nview v_activity_flow9 \"\" diagram=activity element=flow9 from=v_activity_process to=v_activity_pollMerge\nview v_activity_flow10 \"\" diagram=activity element=flow10 from=v_activity_receive to=v_activity_answer\nview v_activity_flow11 \"\" diagram=activity element=flow11 from=v_activity_answer to=v_activity_result\nview v_activity_flow12 \"\" diagram=activity element=flow12 from=v_activity_answer to=v_activity_waiting\nview v_activity_flow13 \"\" diagram=activity element=flow13 from=v_activity_waiting to=v_activity_waitInterval\nview v_activity_flow14 \"\" diagram=activity element=flow14 from=v_activity_result to=v_activity_done\ndiagram components \"ИМ · Компоненты и общие интерфейсы\" type=component\ncomponent web Веб-интерфейс description=\"Экран карточки, формы импорта, модельный ряд, изображений и отчётов; HTTPS API. Вызывает прикладные сервисы; U-01–U-03. Не содержит единственного экземпляра предметных правил. Источник: таблица 10.2.\"\ncomponent services \"Прикладные сервисы\" description=\"Component, ModelRangeVersion, Card, PublicationAttempt; команды и запросы. Используют IAccess и IRepository; F-01–F-11. Выполняют расчёты и проверку состояния. Источник: таблица 10.2.\"\ncomponent access \"Контроль доступа и аудит\" description=\"User, Role, AuditEvent; IAccess. Проверяет роли для каждой операции и фиксирует события; F-10, F-12. Хранение через общий репозиторий. Источник: таблица 10.2.\"\ncomponent repository \"Репозиторий данных\" description=\"IRepository: загрузка сущностей, транзакции, выборки и фиксация версий. Реляционная БД и файловые объекты; R-01, R-02. Не зависит от формата Ozon. Источник: таблица 10.2.\"\ncomponent importer \"Импорт источников\" description=\"SupplierOffer, StockSnapshot; проверка файла и нормализованные записи. Передаёт корректные значения прикладным сервисам; F-01, S-02. Источник: таблица 10.2.\"\ncomponent ozonAdapter \"Адаптер Ozon\" description=\"IPublisher: отправка пакета, получение результата, перевод ошибок. Вызывается прикладными сервисами; внешний защищённый интерфейс; F-08, F-09, R-03. Источник: таблица 10.2.\"\ninterface iAccess IAccess\ninterface iRepository IRepository\ninterface iPublisher IPublisher\nview v_components_web \"\" diagram=components element=web\nview v_components_services \"\" diagram=components element=services\nview v_components_importer \"\" diagram=components element=importer\nview v_components_access \"\" diagram=components element=access\nview v_components_repository \"\" diagram=components element=repository\nview v_components_ozonAdapter \"\" diagram=components element=ozonAdapter\nview v_components_iAccess \"\" diagram=components element=iAccess\nview v_components_iRepository \"\" diagram=components element=iRepository\nview v_components_iPublisher \"\" diagram=components element=iPublisher\ndependency webCalls \"Команды и запросы\" from=web to=services\ndependency importCalls \"Нормализованные записи\" from=importer to=services\nrealization provides_access \"\" from=access to=iAccess\nrealization provides_repository \"\" from=repository to=iRepository\nrealization provides_ozonAdapter \"\" from=ozonAdapter to=iPublisher\nusage uses_iAccess \"\" from=services to=iAccess\nusage uses_iRepository \"\" from=services to=iRepository\nusage uses_iPublisher \"\" from=services to=iPublisher\nusage accessUsesRepository \"\" from=access to=iRepository\nview v_components_webCalls \"\" diagram=components element=webCalls from=v_components_web to=v_components_services\nview v_components_importCalls \"\" diagram=components element=importCalls from=v_components_importer to=v_components_services\nview v_components_provides_access \"\" diagram=components element=provides_access from=v_components_access to=v_components_iAccess\nview v_components_provides_repository \"\" diagram=components element=provides_repository from=v_components_repository to=v_components_iRepository\nview v_components_provides_ozonAdapter \"\" diagram=components element=provides_ozonAdapter from=v_components_ozonAdapter to=v_components_iPublisher\nview v_components_uses_iAccess \"\" diagram=components element=uses_iAccess from=v_components_services to=v_components_iAccess\nview v_components_uses_iRepository \"\" diagram=components element=uses_iRepository from=v_components_services to=v_components_iRepository\nview v_components_uses_iPublisher \"\" diagram=components element=uses_iPublisher from=v_components_services to=v_components_iPublisher\nview v_components_accessUsesRepository \"\" diagram=components element=accessUsesRepository from=v_components_access to=v_components_iRepository\ndiagram classes \"ИМ · Классы реализации компонентов\" type=class\nclass classComponent Component description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsComponent \"\" classifier=classComponent owner=services\nview v_classes_classComponent \"\" diagram=classes element=classComponent\nclass classModelRangeVersion ModelRangeVersion description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsModelRangeVersion \"\" classifier=classModelRangeVersion owner=services\nview v_classes_classModelRangeVersion \"\" diagram=classes element=classModelRangeVersion\nclass classCard Card description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsCard \"\" classifier=classCard owner=services\nview v_classes_classCard \"\" diagram=classes element=classCard\nclass classPublicationAttempt PublicationAttempt description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsPublicationAttempt \"\" classifier=classPublicationAttempt owner=services\nview v_classes_classPublicationAttempt \"\" diagram=classes element=classPublicationAttempt\nclass classUser User description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsUser \"\" classifier=classUser owner=access\nview v_classes_classUser \"\" diagram=classes element=classUser\nclass classRole Role description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsRole \"\" classifier=classRole owner=access\nview v_classes_classRole \"\" diagram=classes element=classRole\nclass classAuditEvent AuditEvent description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsAuditEvent \"\" classifier=classAuditEvent owner=access\nview v_classes_classAuditEvent \"\" diagram=classes element=classAuditEvent\nclass classSupplierOffer SupplierOffer description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsSupplierOffer \"\" classifier=classSupplierOffer owner=importer\nview v_classes_classSupplierOffer \"\" diagram=classes element=classSupplierOffer\nclass classStockSnapshot StockSnapshot description=\"Предметная сущность из таблицы 10.2. Поля и методы не выдумываются в этом архитектурном срезе.\"\ncomponentRealization implementsStockSnapshot \"\" classifier=classStockSnapshot owner=importer\nview v_classes_classStockSnapshot \"\" diagram=classes element=classStockSnapshot\ndiagram deployment \"ИМ · Узлы и размещение артефактов\" type=deployment\ndevice workstation \"Рабочий компьютер\" description=\"Рабочий компьютер. Браузер; интерфейс приложения. Установка отдельного клиента не требуется.. HTTPS к приложению. Пользователь работает под личной учётной записью.\"\nnode server \"Серверная виртуальная машина\" description=\"Серверная виртуальная машина. Приложение и фоновые задачи, PostgreSQL, файлы изображений; ориентир 4 vCPU, 8 ГБ RAM, SSD 100 ГБ.. Принимает клиентские запросы, выполняет расчёты и обмен. Параметры являются стартовой оценкой, не результатом теста.\"\nexecutionEnvironment application \"Среда приложения и фоновых задач\" owner=server technology=\"Серверное приложение\"\nexecutionEnvironment postgres PostgreSQL owner=server technology=PostgreSQL\nnode backupStore \"Отдельное хранилище копий\" description=\"Отдельное хранилище копий. Ежедневные копии БД и файлов, журнал выполнения; доступ только роли резервирования.. Изолировано от рабочего каталога. Восстановление проверяет администратор.\"\nnode externalOzon \"Внешний узел Ozon\" description=\"Внешний узел Ozon. Сервис обработки данных продавца вне управления проектной команды.. Защищённый канал; ограничения интерфейса подтверждаются перед интеграцией.\"\nview v_deployment_workstation \"\" diagram=deployment element=workstation\nview v_deployment_server \"\" diagram=deployment element=server\nview v_deployment_application \"\" diagram=deployment element=application parent=v_deployment_server\nview v_deployment_postgres \"\" diagram=deployment element=postgres parent=v_deployment_server\nview v_deployment_backupStore \"\" diagram=deployment element=backupStore\nview v_deployment_externalOzon \"\" diagram=deployment element=externalOzon\nartifact frontend \"Интерфейс приложения в браузере\" description=\"Учебный тип артефакта по таблицам 10.1–10.3; не фактическая поставленная сборка.\"\ndeployment deploy_frontend \"\" artifact=frontend location=workstation\nmanifestation manifest_frontend \"\" from=frontend to=web\nview v_deployment_frontend \"\" diagram=deployment element=frontend parent=v_deployment_workstation\nartifact appBuild \"Сборка приложения и фоновых задач\" description=\"Учебный тип артефакта по таблицам 10.1–10.3; не фактическая поставленная сборка.\"\ndeployment deploy_appBuild \"\" artifact=appBuild location=application\nmanifestation manifest_appBuild \"\" from=appBuild to=services\nview v_deployment_appBuild \"\" diagram=deployment element=appBuild parent=v_deployment_application\nartifact dbSchema \"Схема БД и миграции\" description=\"Учебный тип артефакта по таблицам 10.1–10.3; не фактическая поставленная сборка.\"\ndeployment deploy_dbSchema \"\" artifact=dbSchema location=postgres\nmanifestation manifest_dbSchema \"\" from=dbSchema to=repository\nview v_deployment_dbSchema \"\" diagram=deployment element=dbSchema parent=v_deployment_postgres\nartifact backups \"Копии БД и файлов\" description=\"Учебный тип артефакта по таблицам 10.1–10.3; не фактическая поставленная сборка.\"\ndeployment deploy_backups \"\" artifact=backups location=backupStore\nmanifestation manifest_backups \"\" from=backups to=repository\nview v_deployment_backups \"\" diagram=deployment element=backups parent=v_deployment_backupStore\ncommunicationPath https \"\" from=workstation port=443 protocol=HTTPS to=application\ncommunicationPath marketplace \"\" from=application protocol=\"Защищённый интерфейс Ozon\" to=externalOzon\ncommunicationPath sql \"\" from=application protocol=\"Доступ к PostgreSQL\" to=postgres\ncommunicationPath backupChannel \"\" from=server protocol=\"Резервирование БД и файлов\" to=backupStore\nview v_deployment_https \"\" diagram=deployment element=https from=v_deployment_workstation to=v_deployment_application\nview v_deployment_marketplace \"\" diagram=deployment element=marketplace from=v_deployment_application to=v_deployment_externalOzon\nview v_deployment_sql \"\" diagram=deployment element=sql from=v_deployment_application to=v_deployment_postgres\nview v_deployment_backupChannel \"\" diagram=deployment element=backupChannel from=v_deployment_server to=v_deployment_backupStore\ndeploymentSetting appSizing \"Стартовая оценка\" key=\"Ресурсы VM\" owner=deploy_appBuild value=\"4 vCPU; 8 ГБ RAM; SSD 100 ГБ — ориентир, не результат испытаний\"\nmerge pollMerge \"\" owner=publish\naction waitInterval \"Дождаться срока следующего опроса\" kind=opaque owner=publish\npartitionMember responsibility_pollMerge \"\" element=pollMerge owner=systemLane\nview v_activity_pollMerge \"\" diagram=activity element=pollMerge parent=v_activity_systemLane\npartitionMember responsibility_waitInterval \"\" element=waitInterval owner=systemLane\nview v_activity_waitInterval \"\" diagram=activity element=waitInterval parent=v_activity_systemLane\ncontrolFlow flow15 \"\" from=pollMerge owner=publish to=receive\nview v_activity_flow15 \"\" diagram=activity element=flow15 from=v_activity_pollMerge to=v_activity_receive\ncontrolFlow flow16 \"\" from=waitInterval owner=publish to=pollMerge\nview v_activity_flow16 \"\" diagram=activity element=flow16 from=v_activity_waitInterval to=v_activity_pollMerge\n",
