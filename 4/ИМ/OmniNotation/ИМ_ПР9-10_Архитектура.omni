      {
        "id": "deployment",
        "kind": "diagram",
        "label": "ИМ · Узлы и размещение артефактов",
        "properties": {
          "type": "deployment"
        }
      },
      {
        "id": "workstation",
        "kind": "device",
        "label": "Рабочий компьютер",
        "properties": {
          "description": "Рабочий компьютер. Браузер; интерфейс приложения. Установка отдельного клиента не требуется.. HTTPS к приложению. Пользователь работает под личной учётной записью."
        }
      },
      {
        "id": "server",
        "kind": "node",
        "label": "Серверная виртуальная машина",
        "properties": {
          "description": "Серверная виртуальная машина. Приложение и фоновые задачи, PostgreSQL, файлы изображений; ориентир 4 vCPU, 8 ГБ RAM, SSD 100 ГБ.. Принимает клиентские запросы, выполняет расчёты и обмен. Параметры являются стартовой оценкой, не результатом теста."
        }
      },
      {
        "id": "application",
        "kind": "executionEnvironment",
        "label": "Среда приложения и фоновых задач",
        "properties": {
          "owner": "server",
          "technology": "Серверное приложение"
        }
      },
      {
        "id": "postgres",
        "kind": "executionEnvironment",
        "label": "PostgreSQL",
        "properties": {
          "owner": "server",
          "technology": "PostgreSQL"
        }
      },
      {
        "id": "backupStore",
        "kind": "node",
        "label": "Отдельное хранилище копий",
        "properties": {
          "description": "Отдельное хранилище копий. Ежедневные копии БД и файлов, журнал выполнения; доступ только роли резервирования.. Изолировано от рабочего каталога. Восстановление проверяет администратор."
        }
      },
      {
        "id": "externalOzon",
        "kind": "node",
        "label": "Внешний узел Ozon",
        "properties": {
          "description": "Внешний узел Ozon. Сервис обработки данных продавца вне управления проектной команды.. Защищённый канал; ограничения интерфейса подтверждаются перед интеграцией."
        }
      },
