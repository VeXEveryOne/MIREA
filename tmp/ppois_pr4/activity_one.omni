  "source": "uml parallel \"Параллельная подготовка\"\nactivity work \"Подготовить карточку\"\ndiagram main \"Потоки управления и данных\" activity=work type=activity\nclass payload \"Версия карточки\"\ninitial start \"\" owner=work\nfork split \"\" owner=work\naction compose \"Сформировать BOM\" kind=opaque owner=work\naction fetch \"Получить предложения\" kind=opaque owner=work\njoin sync \"\" joinSpec=and owner=work\ndecision check \"Готово?\" owner=work\naction accept Принять kind=opaque owner=work\naction reject \"Вернуть на доработку\" kind=opaque owner=work\nmerge merge \"\" owner=work\nactivityFinal done \"\" owner=work\nflowFinal drop \"\" owner=work\noutputPin dataOut Версия classifier=payload lower=1 owner=compose upper=1\ninputPin dataIn Версия classifier=payload lower=1 owner=fetch upper=1\noutputPin unused Остаток classifier=payload lower=0 owner=fetch upper=1\ncontrolFlow c1 \"\" from=start owner=work to=split\ncontrolFlow c2 \"\" from=split owner=work to=compose\ncontrolFlow c3 \"\" from=split owner=work to=fetch\ncontrolFlow c4 \"\" from=compose owner=work to=sync\ncontrolFlow c5 \"\" from=fetch owner=work to=sync\ncontrolFlow c6 \"\" from=sync owner=work to=check\ncontrolFlow c7 Да from=check guard=ready owner=work to=accept\ncontrolFlow c8 Нет from=check guard=else owner=work to=reject\ncontrolFlow c9 \"\" from=accept owner=work to=merge\ncontrolFlow c10 \"\" from=reject owner=work to=merge\ncontrolFlow c11 \"\" from=merge owner=work to=done\nobjectFlow data Версия from=dataOut owner=work to=dataIn\nobjectFlow discard Отбросить from=unused owner=work to=drop\nview v_start \"\" diagram=main element=start\nview v_split \"\" diagram=main element=split\nview v_compose \"\" diagram=main element=compose\nview v_fetch \"\" diagram=main element=fetch\nview v_dataOut \"\" diagram=main element=dataOut parent=v_compose\nview v_dataIn \"\" diagram=main element=dataIn parent=v_fetch\nview v_unused \"\" diagram=main element=unused parent=v_fetch\nview v_drop \"\" diagram=main element=drop\nview v_sync \"\" diagram=main element=sync\nview v_check \"\" diagram=main element=check\nview v_accept \"\" diagram=main element=accept\nview v_reject \"\" diagram=main element=reject\nview v_merge \"\" diagram=main element=merge\nview v_done \"\" diagram=main element=done\nview v_c1 \"\" diagram=main element=c1 from=v_start to=v_split\nview v_c2 \"\" diagram=main element=c2 from=v_split to=v_compose\nview v_c3 \"\" diagram=main element=c3 from=v_split to=v_fetch\nview v_c4 \"\" diagram=main element=c4 from=v_compose to=v_sync\nview v_c5 \"\" diagram=main element=c5 from=v_fetch to=v_sync\nview v_c6 \"\" diagram=main element=c6 from=v_sync to=v_check\nview v_c7 \"\" diagram=main element=c7 from=v_check to=v_accept\nview v_c8 \"\" diagram=main element=c8 from=v_check to=v_reject\nview v_c9 \"\" diagram=main element=c9 from=v_accept to=v_merge\nview v_c10 \"\" diagram=main element=c10 from=v_reject to=v_merge\nview v_c11 \"\" diagram=main element=c11 from=v_merge to=v_done\nview v_data \"\" diagram=main element=data from=v_dataOut to=v_dataIn\nview v_discard \"\" diagram=main element=discard from=v_unused to=v_drop\n",
